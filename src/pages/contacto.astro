---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";

import { CONTACT, SITE_METADATA } from "@/constants/ui";

const whatsappLink = `https://wa.me/${CONTACT.whatsappE164}`;
---

<Layout title="Contacto">
  <Nav />

  <div class="surface-light">
    <section class="contact-hero">
      <div class="contact-hero-text">
        <nav class="contact-crumbs" aria-label="Migas de navegación">
          <a href="/">Inicio</a> · <span aria-current="page">Contacto</span>
        </nav>
        <h1 class="contact-title">Hablemos</h1>
        <p class="contact-lead">
          Escribinos por WhatsApp con tu pedido o consulta. Te respondemos con
          disponibilidad, forma de pago y costo de envío en el mismo día.
        </p>
        <div class="contact-actions">
          <a class="contact-btn contact-btn-solid" href={whatsappLink} target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 0 1-13.3 7.9L3 21l1.2-4.5A9 9 0 1 1 21 12z" /><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 .8a4 4 0 0 1-1.8-1.8l.8-1-1-2L9 9.5z" /></svg>
            Escribinos por WhatsApp
          </a>
          <a class="contact-btn contact-btn-outline" href={CONTACT.instagramUrl} target="_blank" rel="noopener noreferrer">
            Ver Instagram
          </a>
        </div>
      </div>
      <img
        class="contact-hero-img"
        src="/collections/unisex.jpg"
        alt=""
        width="1000"
        height="800"
        fetchpriority="high"
      />
    </section>

    <section class="contact-channels" aria-label="Canales de contacto">
      <a class="contact-card" href={whatsappLink} target="_blank" rel="noopener noreferrer">
        <span class="contact-card-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 1-13.3 7.9L3 21l1.2-4.5A9 9 0 1 1 21 12z" /><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 .8a4 4 0 0 1-1.8-1.8l.8-1-1-2L9 9.5z" /></svg>
        </span>
        <span class="contact-card-label">WhatsApp</span>
        <span class="contact-card-value">{CONTACT.whatsappDisplay}</span>
        <span class="contact-card-action">
          Iniciar conversación
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </span>
      </a>
      <a class="contact-card" href={CONTACT.instagramUrl} target="_blank" rel="noopener noreferrer">
        <span class="contact-card-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" /></svg>
        </span>
        <span class="contact-card-label">Instagram</span>
        <span class="contact-card-value">{CONTACT.instagram}</span>
        <span class="contact-card-action">
          Ver perfil
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </span>
      </a>
      <a class="contact-card" href={CONTACT.tiktokUrl} target="_blank" rel="noopener noreferrer">
        <span class="contact-card-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5" /><path d="M14 3c.5 2.8 2.4 4.5 5 4.8" /></svg>
        </span>
        <span class="contact-card-label">TikTok</span>
        <span class="contact-card-value">{CONTACT.tiktok}</span>
        <span class="contact-card-action">
          Ver perfil
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </span>
      </a>
    </section>

    <section class="contact-info" aria-label="Información de compra">
      <div class="contact-info-item">
        <span class="contact-info-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" /><polygon points="16 8 20 8 23 11 23 16 16 16 16 8" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" /></svg>
        </span>
        <div>
          <h2>Envíos</h2>
          <p>Todo el país por Correo Argentino.</p>
        </div>
      </div>
      <div class="contact-info-item">
        <span class="contact-info-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20M6 15h4" /></svg>
        </span>
        <div>
          <h2>Pagos</h2>
          <p>Efectivo o transferencia. Coordinamos por WhatsApp.</p>
        </div>
      </div>
      <div class="contact-info-item">
        <span class="contact-info-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z" /><path d="M9 12l2 2 4-4" /></svg>
        </span>
        <div>
          <h2>Originales</h2>
          <p>Todas nuestras fragancias son importadas y originales de Emiratos.</p>
        </div>
      </div>
    </section>

    <p class="contact-location">{SITE_METADATA.location}</p>
  </div>

  <Footer />
</Layout>

<style>
  .contact-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
    gap: var(--space-8);
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: var(--space-7) clamp(16px, 4vw, 32px) var(--space-8);
  }
  .contact-crumbs {
    margin-bottom: var(--space-4);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .contact-crumbs a:hover {
    color: var(--color-gold-ink);
  }
  .contact-crumbs [aria-current] {
    color: var(--color-ink);
  }
  .contact-title {
    margin-bottom: var(--space-4);
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 400;
    line-height: 1.05;
    color: var(--color-ink);
  }
  .contact-lead {
    max-width: 44ch;
    font-size: var(--text-md);
    line-height: 1.7;
    color: var(--color-ink-muted);
    text-wrap: pretty;
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .contact-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 48px;
    padding: 0 var(--space-5);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }
  .contact-btn-solid {
    background: var(--color-ink);
    color: var(--color-surface-light);
  }
  .contact-btn-solid:hover {
    background: var(--color-gold-ink);
  }
  .contact-btn-outline {
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
  }
  .contact-btn-outline:hover {
    background: var(--color-ink);
    color: var(--color-surface-light);
  }
  .contact-hero-img {
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 4;
    object-fit: cover;
  }

  .contact-channels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 32px) var(--space-8);
  }
  .contact-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-6);
    background: #ffffff;
    border: 1px solid transparent;
    transition: border-color 0.3s ease, transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .contact-card:hover {
    border-color: var(--color-ink);
  }
  .contact-card:focus-visible {
    outline: 2px solid var(--color-gold-ink);
    outline-offset: 4px;
  }
  .contact-card-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: var(--space-3);
    border: 1px solid rgba(26, 23, 18, 0.25);
    border-radius: var(--radius-circle);
    color: var(--color-ink);
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }
  .contact-card:hover .contact-card-icon {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-surface-light);
  }
  .contact-card-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .contact-card-value {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    line-height: 1.2;
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }
  .contact-card-action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .contact-card-action svg {
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .contact-info {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: var(--space-7) clamp(16px, 4vw, 32px);
    border-top: 1px solid rgba(26, 23, 18, 0.15);
  }
  .contact-info-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .contact-info-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-circle);
    background: #ffffff;
    color: var(--color-ink);
  }
  .contact-info-item h2 {
    margin-bottom: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .contact-info-item p {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .contact-location {
    padding-bottom: var(--space-8);
    font-size: var(--text-sm);
    text-align: center;
    color: var(--color-ink-muted);
  }

  /* Movimiento solo si la persona no pidió reducirlo. */
  @media (prefers-reduced-motion: no-preference) {
    .contact-card:hover {
      transform: translateY(-4px);
    }
    .contact-card:hover .contact-card-action svg {
      transform: translateX(6px);
    }
  }

  @media (max-width: 860px) {
    .contact-hero {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-top: var(--space-6);
    }
    .contact-hero-img {
      order: -1;
      aspect-ratio: 4 / 3;
    }
    .contact-channels,
    .contact-info {
      grid-template-columns: 1fr;
    }
  }
</style>
