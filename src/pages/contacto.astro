---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import PageHeader from "@/components/PageHeader.astro";

import { CONTACT, SITE_METADATA } from "@/constants/ui";

const whatsappLink = `https://wa.me/${CONTACT.whatsappE164}`;
---

<Layout title="Contacto">
  <Nav />

  <div class="surface-light">
    <PageHeader
      title="Contacto"
      subtitle="Atención personalizada · Envíos a todo el país"
      breadcrumbsTrail={[{ label: "Inicio", href: "/" }, { label: "Contacto" }]}
    />

    <section class="contact">
      <p class="contact-lead">
        Escribinos por WhatsApp con tu pedido o consulta. Te respondemos con
        disponibilidad, forma de pago y costo de envío en el mismo día.
      </p>

      <a class="contact-cta" href={whatsappLink} target="_blank" rel="noopener noreferrer">
        Hablar por WhatsApp
      </a>

      <ul class="contact-channels">
        <li>
          <a class="contact-channel" href={whatsappLink} target="_blank" rel="noopener noreferrer">
            <span class="contact-channel-label">WhatsApp</span>
            <span class="contact-channel-value">{CONTACT.whatsappDisplay}</span>
            <span class="contact-channel-action" aria-hidden="true">Escribir</span>
          </a>
        </li>
        <li>
          <a class="contact-channel" href={CONTACT.instagramUrl} target="_blank" rel="noopener noreferrer">
            <span class="contact-channel-label">Instagram</span>
            <span class="contact-channel-value">{CONTACT.instagram}</span>
            <span class="contact-channel-action" aria-hidden="true">Ver</span>
          </a>
        </li>
        <li>
          <a class="contact-channel" href={CONTACT.tiktokUrl} target="_blank" rel="noopener noreferrer">
            <span class="contact-channel-label">TikTok</span>
            <span class="contact-channel-value">{CONTACT.tiktok}</span>
            <span class="contact-channel-action" aria-hidden="true">Ver</span>
          </a>
        </li>
      </ul>

      <div class="contact-info">
        <div class="contact-info-item">
          <h2>Envíos</h2>
          <p>Todo el país por Correo Argentino.</p>
        </div>
        <div class="contact-info-item">
          <h2>Pagos</h2>
          <p>Efectivo o transferencia. Coordinamos por WhatsApp.</p>
        </div>
        <div class="contact-info-item">
          <h2>Originales</h2>
          <p>Todas nuestras fragancias son importadas y originales de Emiratos.</p>
        </div>
      </div>

      <p class="contact-location">{SITE_METADATA.location}</p>
    </section>
  </div>

  <Footer />
</Layout>

<style>
  /* Contacto sobre crema: CTA principal a WhatsApp y los canales como una
     lista editorial con líneas finas (sin cajas ni colores de marca). */
  .contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    max-width: 880px;
    margin: 0 auto;
    padding: var(--space-5) clamp(16px, 4vw, 32px) var(--space-8);
  }

  .contact-lead {
    max-width: 52ch;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: 1.4;
    color: var(--color-ink);
    text-align: center;
    text-wrap: balance;
  }

  .contact-cta {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--space-6);
    background: var(--color-ink);
    color: var(--color-surface-light);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    transition: background-color var(--transition-fast);
  }
  .contact-cta:hover {
    background: var(--color-gold-ink);
  }

  .contact-channels {
    list-style: none;
    width: 100%;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(26, 23, 18, 0.2);
  }
  .contact-channel {
    display: grid;
    grid-template-columns: 140px 1fr auto;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-bottom: 1px solid rgba(26, 23, 18, 0.2);
  }
  .contact-channel-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .contact-channel-value {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: 1.2;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    transition: color var(--transition-fast);
  }
  .contact-channel:hover .contact-channel-value {
    color: var(--color-gold-ink);
  }
  .contact-channel-action {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink);
    border-bottom: 1px solid currentColor;
  }

  .contact-info {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    width: 100%;
  }
  .contact-info-item h2 {
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .contact-info-item p {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .contact-location {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  @media (max-width: 640px) {
    .contact-channel {
      grid-template-columns: 1fr auto;
    }
    .contact-channel-label {
      grid-column: 1 / -1;
    }
    .contact-info {
      grid-template-columns: 1fr;
    }
  }
</style>
