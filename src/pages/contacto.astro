---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageHeader from "@/components/PageHeader.astro";

import { CONTACT, SITE_METADATA } from "@/constants/ui";

const breadcrumbsTrail = [
  { label: "Inicio", href: "/" },
  { label: "Contacto" },
];

const whatsappLink = `https://wa.me/${CONTACT.whatsappE164}`;
---

<Layout title="Contacto">
  <Nav />
  <Breadcrumbs trail={breadcrumbsTrail} />
  <PageHeader
    title="Hablemos por"
    highlight="WhatsApp"
    subtitle="Atención personalizada · Envíos a todo el país"
  />

  <section class="contact">
    <p class="contact-lead">
      Escribinos por WhatsApp con tu pedido o consulta. Te respondemos con
      disponibilidad, forma de pago y costo de envío en el mismo día.
    </p>

    <div class="contact-channels">
      <a class="contact-channel contact-wa" href={whatsappLink} target="_blank" rel="noopener noreferrer">
        <div class="contact-channel-icon" style="background:#25d366;color:#fff;" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
        </div>
        <div class="contact-channel-body">
          <div class="contact-channel-label">WhatsApp</div>
          <div class="contact-channel-value">{CONTACT.whatsappDisplay}</div>
          <div class="contact-channel-action">Iniciar conversación →</div>
        </div>
      </a>

      <a class="contact-channel contact-ig" href={CONTACT.instagramUrl} target="_blank" rel="noopener noreferrer">
        <div class="contact-channel-icon" style="background:linear-gradient(45deg,#f09433 0%,#e6683c 25%,#dc2743 50%,#cc2366 75%,#bc1888 100%);color:#fff;" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
          </svg>
        </div>
        <div class="contact-channel-body">
          <div class="contact-channel-label">Instagram</div>
          <div class="contact-channel-value">{CONTACT.instagram}</div>
          <div class="contact-channel-action">Ver Instagram →</div>
        </div>
      </a>

      <a class="contact-channel contact-tk" href={CONTACT.tiktokUrl} target="_blank" rel="noopener noreferrer">
        <div class="contact-channel-icon" style="background:#000;color:#fff;border:0.5px solid #25f4ee;" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.84-.1z"/>
          </svg>
        </div>
        <div class="contact-channel-body">
          <div class="contact-channel-label">TikTok</div>
          <div class="contact-channel-value">{CONTACT.tiktok}</div>
          <div class="contact-channel-action">Ver TikTok →</div>
        </div>
      </a>
    </div>

    <div class="contact-info">
      <div class="contact-info-item">
        <h3>Envíos</h3>
        <p>Todo el país por Correo Argentino.</p>
      </div>
      <div class="contact-info-item">
        <h3>Pagos</h3>
        <p>Transferencia, MercadoPago y efectivo. Coordinamos por WhatsApp.</p>
      </div>
      <div class="contact-info-item">
        <h3>Originales</h3>
        <p>Todas nuestras fragancias son importadas y originales de Emiratos.</p>
      </div>
    </div>

    <p class="contact-location">{SITE_METADATA.location}</p>
  </section>

  <Footer />
</Layout>


<style>
  .contact {
    padding: 32px clamp(16px, 4vw, 32px) 64px;
    max-width: 880px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .contact-lead {
    font-family: var(--font-serif);
    font-size: clamp(16px, 2.5vw, 20px);
    line-height: 1.6;
    color: var(--color-cream);
    text-align: center;
    font-style: italic;
  }

  .contact-channels {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .contact-channel {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 22px 24px;
    border: 0.5px solid rgba(201, 168, 76, 0.25);
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
    transition: all var(--transition-default);
  }
  .contact-channel:hover {
    border-color: var(--color-gold);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .contact-channel-icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-default);
  }
  .contact-channel:hover .contact-channel-icon {
    transform: scale(1.08);
  }

  .contact-channel-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    min-width: 0;
  }

  .contact-channel-label {
    font-size: 11px;
    letter-spacing: 2.5px;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .contact-channel-value {
    font-family: var(--font-serif);
    font-size: 20px;
    color: var(--color-cream);
    letter-spacing: 1px;
    line-height: 1.2;
  }

  .contact-channel-action {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-gold-light);
    margin-top: 4px;
  }

  .contact-wa .contact-channel-action {
    color: #25d366;
  }
  .contact-ig .contact-channel-action {
    color: #dc2743;
  }
  .contact-tk .contact-channel-action {
    color: #25f4ee;
  }

  .contact-info {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding-top: 28px;
    border-top: 0.5px solid var(--color-border);
  }

  .contact-info-item h3 {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 16px;
    color: var(--color-gold-light);
    margin-bottom: 6px;
    letter-spacing: 1px;
    font-weight: 400;
  }
  .contact-info-item p {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .contact-location {
    text-align: center;
    font-size: 11px;
    letter-spacing: 3px;
    color: var(--color-text-muted);
    text-transform: uppercase;
    padding-top: 12px;
  }

  @media (max-width: 640px) {
    .contact-channels {
      grid-template-columns: 1fr;
    }
    .contact-info {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
