---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import PageHeader from "@/components/PageHeader.astro";
import Sidebar from "@/components/Sidebar.astro";
import BrandSection from "@/components/BrandSection.astro";
import Footer from "@/components/Footer.astro";

import { getBrandsByCatalog } from "@/data/brands";
import { PRODUCTS } from "@/data/products";
import {
  ALL_CATALOGS,
  CATALOG_LABELS,
  DEFAULT_CATALOG,
} from "@/constants/ui";
import {
  countProductsByBrand,
  groupProductsByBrand,
} from "@/lib/grouping";
import {
  getPriceRangeFor,
  getProductsByCatalog,
} from "@/lib/filters";

/**
 * Catálogo: sidebar de filtros + grilla por marca.
 * En tiempo de build agrupamos productos por marca dentro de cada
 * catálogo y construimos los conteos. El controller del cliente
 * solo aplica visibilidad sobre lo ya renderizado.
 */

const sidebarGroups = ALL_CATALOGS.map((catalog) => {
  const productsInCatalog = getProductsByCatalog(PRODUCTS, catalog);
  const brandsInCatalog = getBrandsByCatalog(catalog);
  const brandsWithCount = countProductsByBrand(
    productsInCatalog,
    brandsInCatalog,
  ).filter((brand) => brand.productCount > 0);
  return {
    catalog,
    brands: brandsWithCount,
    totalProducts: productsInCatalog.length,
    priceRange: getPriceRangeFor(productsInCatalog),
  };
});

const productGroupsByCatalog = ALL_CATALOGS.map((catalog) => {
  const productsInCatalog = getProductsByCatalog(PRODUCTS, catalog);
  const brandsInCatalog = getBrandsByCatalog(catalog);
  return {
    catalog,
    productsByBrand: groupProductsByBrand(productsInCatalog, brandsInCatalog),
  };
});

const totalArabes = getProductsByCatalog(PRODUCTS, "arabe").length;
---

<Layout title={CATALOG_LABELS[DEFAULT_CATALOG]}>
  <Nav />
  <div class="surface-light">
  <PageHeader
    title={CATALOG_LABELS[DEFAULT_CATALOG]}
    subtitle="Fragancias importadas, originales y listas para enviar"
    breadcrumbsTrail={[{ label: "Inicio", href: "/" }, { label: "Catálogo" }]}
  />

  <div class="catalog-tabs" role="group" aria-label="Tipo de perfume">
    {
      ALL_CATALOGS.map((catalog) => (
        <button
          type="button"
          class={`catalog-tab ${catalog === DEFAULT_CATALOG ? "active" : ""}`}
          aria-pressed={catalog === DEFAULT_CATALOG ? "true" : "false"}
          data-catalog-tab={catalog}
        >
          {CATALOG_LABELS[catalog]}
        </button>
      ))
    }
  </div>

  <div class="catalog-filters">
    <div class="catalog-filters-inner">
      <Sidebar groups={sidebarGroups} activeCatalog={DEFAULT_CATALOG} />

      <div class="catalog-toolbar">
        <p class="catalog-result" data-result-count>{totalArabes} fragancias</p>

        <div class="sort-menu" data-sort-menu>
          <button
            type="button"
            class="sort-toggle"
            data-sort-toggle
            aria-haspopup="listbox"
            aria-expanded="false"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="6" x2="13" y2="6" />
              <line x1="3" y1="12" x2="11" y2="12" />
              <line x1="3" y1="18" x2="9" y2="18" />
              <polyline points="17 8 21 12 17 16" />
              <line x1="14" y1="12" x2="21" y2="12" />
            </svg>
            <span>Ordenar</span>
            <svg class="sort-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>

          <div class="sort-panel" data-sort-panel role="listbox" hidden>
            <button type="button" class="sort-option" role="option" data-sort-value="default" aria-selected="true">
              Por defecto
            </button>
            <button type="button" class="sort-option" role="option" data-sort-value="price-asc">
              Precio: menor a mayor
            </button>
            <button type="button" class="sort-option" role="option" data-sort-value="price-desc">
              Precio: mayor a menor
            </button>
            <button type="button" class="sort-option" role="option" data-sort-value="featured">
              Tendencia primero
            </button>
            <button type="button" class="sort-option" role="option" data-sort-value="discount">
              Descuento primero
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="catalog-shell">
    <main class="catalog-main">
      <div class="catalog-content">
        {
          productGroupsByCatalog.map((group) =>
            group.productsByBrand.map((entry) => (
              <BrandSection brand={entry.brand} products={entry.products} />
            )),
          )
        }

        {/* Empty state: aparece cuando los filtros activos no devuelven
            ningún producto. El catalog-controller lo togglea seteando
            data-empty="true" en el contenedor padre. */}
        <div class="catalog-empty" data-catalog-empty hidden>
          <svg
            class="catalog-empty-icon"
            width="40"
            height="40"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.5" y2="16.5" />
          </svg>
          <p class="catalog-empty-title">No encontramos fragancias</p>
          <p class="catalog-empty-subtitle">
            Probá ajustando los filtros o limpiá la selección actual para
            ver todo el catálogo.
          </p>
          <button
            type="button"
            class="catalog-empty-action"
            data-catalog-empty-clear
          >
            Limpiar filtros
          </button>
        </div>
      </div>
    </main>
  </div>

  </div>

  <Footer />
</Layout>

<script>
  import { initCatalogController } from "@/scripts/catalog-controller";

  // El título de la página y la URL acompañan a la pestaña elegida
  // ("Perfumes árabes" / "Perfumes de diseñador"). La URL queda con
  // ?catalogo=… para poder compartirla, y el menú marca la entrada activa
  // escuchando el evento "catalog:change".
  function syncTitleWithTabs(): void {
    const title = document.querySelector<HTMLElement>(".page-header-title");
    const tabs = document.querySelectorAll<HTMLButtonElement>("[data-catalog-tab]");
    const apply = (tab: HTMLButtonElement): void => {
      if (title !== null) {
        title.textContent = tab.textContent?.trim() ?? title.textContent;
      }
    };
    const active = document.querySelector<HTMLButtonElement>(
      '[data-catalog-tab][aria-pressed="true"]',
    );
    if (active !== null) apply(active);
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        apply(tab);
        const catalog = tab.dataset.catalogTab ?? "";
        const url = new URL(window.location.href);
        url.searchParams.set("catalogo", catalog);
        history.replaceState(null, "", url);
        window.dispatchEvent(new CustomEvent("catalog:change", { detail: catalog }));
      });
    });
  }

  function boot(): void {
    initCatalogController();
    syncTitleWithTabs();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot, { once: true });
  } else {
    boot();
  }
</script>

<style>
  /* Pestañas Árabes / De diseñador debajo del título. */
  .catalog-tabs {
    display: flex;
    justify-content: center;
    gap: var(--space-6);
    padding: 0 var(--space-4) var(--space-5);
  }
  .catalog-tab {
    padding: var(--space-2) 0;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--surface-muted, var(--color-text-muted));
    border-bottom: 1px solid transparent;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }
  .catalog-tab:hover {
    color: var(--surface-text, var(--color-cream));
  }
  .catalog-tab.active {
    color: var(--surface-text, var(--color-cream));
    border-bottom-color: var(--surface-accent, var(--color-gold));
  }

  /* Barra de filtros horizontal, fija debajo del header en desktop. */
  .catalog-filters {
    border-block: 1px solid var(--surface-line, var(--color-border-subtle));
    background: var(--surface-bg, var(--color-bg));
  }
  .catalog-filters-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: var(--space-3) clamp(16px, 3vw, 32px);
  }
  @media (min-width: 921px) {
    .catalog-filters {
      position: sticky;
      /* Alto del header de dos filas (Nav), que también es sticky. */
      top: 112px;
      z-index: 50;
    }
  }

  .catalog-shell {
    padding: var(--space-6) clamp(16px, 3vw, 32px) var(--space-7);
    max-width: var(--max-content-width);
    margin: 0 auto;
  }

  .catalog-main {
    min-width: 0;
  }

  .catalog-toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-left: auto;
  }

  /* ── Sort menu (botón Ordenar + dropdown) ───────────────────── */
  .sort-menu {
    position: relative;
  }
  .sort-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 40px;
    padding: 0 var(--space-4);
    background: transparent;
    border: 1px solid var(--surface-line, rgba(245, 237, 216, 0.22));
    color: var(--surface-text, var(--color-cream));
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-weight: 600;
    cursor: pointer;
    transition: border-color var(--transition-fast);
  }
  .sort-toggle:hover,
  .sort-toggle[aria-expanded="true"] {
    border-color: var(--surface-text, var(--color-cream));
  }
  .sort-chevron {
    transition: transform var(--transition-fast);
    color: var(--surface-muted, var(--color-text-muted));
  }
  .sort-toggle[aria-expanded="true"] .sort-chevron {
    transform: rotate(180deg);
  }

  .sort-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 240px;
    background: var(--surface-bg, var(--color-bg-elevated));
    border: 1px solid var(--surface-line, rgba(245, 237, 216, 0.12));
    padding: var(--space-2);
    box-shadow: var(--elev-3);
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  /* CSS class selector tiene la misma especificidad que [hidden], y como
     nuestra hoja se carga después, ganaba. Esta regla compuesta tiene
     mayor especificidad y respeta el atributo hidden del HTML. */
  .sort-panel[hidden] {
    display: none;
  }
  .sort-option {
    background: transparent;
    border: none;
    color: var(--surface-text, var(--color-text));
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    text-align: left;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .sort-option:hover {
    background: var(--surface-tint, rgba(201, 168, 76, 0.1));
    color: var(--surface-text, var(--color-cream));
  }
  .sort-option[aria-selected="true"] {
    color: var(--surface-accent, var(--color-gold-light));
    background: var(--surface-tint, rgba(201, 168, 76, 0.08));
  }
  .sort-option[aria-selected="true"]::after {
    content: "✓";
    float: right;
    color: var(--surface-accent, var(--color-gold));
  }

  .catalog-result {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-uppercase);
    color: var(--surface-muted, var(--color-text-muted));
    text-transform: uppercase;
  }

  .catalog-content {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* Mobile: los filtros viven en el drawer (botón del Nav); en la barra
     quedan el conteo y Ordenar. */
  @media (max-width: 920px) {
    .catalog-toolbar {
      width: 100%;
      justify-content: space-between;
    }
  }

  @media (max-width: 520px) {
    .sort-panel {
      /* No queremos que se desborde el viewport en mobile. Si la posición
         right: 0 lo hiciera pasarse a la izquierda del catálogo, lo limitamos
         con un ancho que se ajuste al espacio disponible. */
      min-width: 220px;
      max-width: calc(100vw - 32px);
    }
  }

  /* ── Empty state del catálogo filtrado ───────────────────────
     Aparece cuando ningún producto coincide con los filtros activos.
     Diseño centrado, ícono sutil dorado, mensaje + CTA para limpiar. */
  .catalog-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-9) var(--space-5);
    gap: var(--space-3);
    min-height: 320px;
    /* La hairline arriba sutil mantiene la sensación de contenido, no de bug */
    box-shadow: var(--elev-1);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.012);
  }
  /* Sin esto, display: flex ganaba en especificidad a [hidden] del browser
     y el bloque se mostraba siempre. */
  .catalog-empty[hidden] {
    display: none;
  }
  .catalog-empty-icon {
    color: var(--surface-accent, var(--color-gold));
    opacity: 0.6;
    margin-bottom: var(--space-2);
    width: 40px;
    height: 40px;
    align-self: center;
    flex-shrink: 0;
  }
  .catalog-empty-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 400;
    color: var(--surface-text, var(--color-cream));
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }
  .catalog-empty-subtitle {
    font-size: var(--text-sm);
    color: var(--surface-muted, var(--color-text-muted));
    margin: 0;
    max-width: 360px;
    line-height: 1.55;
  }
  /* CTA con la misma signature fill animation del resto del sitio */
  .catalog-empty-action {
    position: relative;
    background: transparent;
    border: 0.5px solid var(--surface-accent, var(--color-gold));
    color: var(--surface-accent, var(--color-gold));
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    padding: 10px 22px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    margin-top: var(--space-3);
    transition: color 0.35s var(--ease-premium);
  }
  .catalog-empty-action::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--surface-accent, var(--color-gold));
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.35s var(--ease-premium);
    z-index: -1;
  }
  .catalog-empty-action:hover {
    color: var(--surface-bg, var(--color-bg));
  }
  .catalog-empty-action:hover::before {
    clip-path: inset(0 0 0 0);
  }
</style>
