---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import PageHeader from "@/components/PageHeader.astro";
import Sidebar from "@/components/Sidebar.astro";
import BrandSection from "@/components/BrandSection.astro";
import Footer from "@/components/Footer.astro";

import { getBrandsByCatalog } from "@/data/brands";
import { PRODUCTS } from "@/data/products";
import {
  ALL_CATALOGS,
  CATALOG_LABELS,
  DEFAULT_CATALOG,
} from "@/constants/ui";
import {
  countProductsByBrand,
  groupProductsByBrand,
} from "@/lib/grouping";
import {
  getPriceRangeFor,
  getProductsByCatalog,
} from "@/lib/filters";

/**
 * Catálogo: sidebar de filtros + grilla por marca.
 * En tiempo de build agrupamos productos por marca dentro de cada
 * catálogo y construimos los conteos. El controller del cliente
 * solo aplica visibilidad sobre lo ya renderizado.
 */

const sidebarGroups = ALL_CATALOGS.map((catalog) => {
  const productsInCatalog = getProductsByCatalog(PRODUCTS, catalog);
  const brandsInCatalog = getBrandsByCatalog(catalog);
  const brandsWithCount = countProductsByBrand(
    productsInCatalog,
    brandsInCatalog,
  ).filter((brand) => brand.productCount > 0);
  return {
    catalog,
    brands: brandsWithCount,
    totalProducts: productsInCatalog.length,
    priceRange: getPriceRangeFor(productsInCatalog),
  };
});

const productGroupsByCatalog = ALL_CATALOGS.map((catalog) => {
  const productsInCatalog = getProductsByCatalog(PRODUCTS, catalog);
  const brandsInCatalog = getBrandsByCatalog(catalog);
  return {
    catalog,
    productsByBrand: groupProductsByBrand(productsInCatalog, brandsInCatalog),
  };
});

const totalArabes = getProductsByCatalog(PRODUCTS, "arabe").length;
---

<Layout title={CATALOG_LABELS[DEFAULT_CATALOG]}>
  <Nav />
  <PageHeader
    title="Nuestro"
    highlight="catálogo"
    subtitle="Fragancias importadas, originales y listas para enviar"
  />

  <div class="catalog-shell">
    <Sidebar groups={sidebarGroups} activeCatalog={DEFAULT_CATALOG} />

    <main class="catalog-main">
      <div class="catalog-toolbar">
        <p class="catalog-result" data-result-count>{totalArabes} fragancias</p>

        <div class="sort-menu" data-sort-menu>
          <button
            type="button"
            class="sort-toggle"
            data-sort-toggle
            aria-haspopup="listbox"
            aria-expanded="false"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="6" x2="13" y2="6" />
              <line x1="3" y1="12" x2="11" y2="12" />
              <line x1="3" y1="18" x2="9" y2="18" />
              <polyline points="17 8 21 12 17 16" />
              <line x1="14" y1="12" x2="21" y2="12" />
            </svg>
            <span>Filtrar y ordenar</span>
            <svg class="sort-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>

          <div class="sort-panel" data-sort-panel role="listbox" hidden>
            <button type="button" class="sort-option" role="option" data-sort-value="default" aria-selected="true">
              Por defecto
            </button>
            <button type="button" class="sort-option" role="option" data-sort-value="price-asc">
              Precio: menor a mayor
            </button>
            <button type="button" class="sort-option" role="option" data-sort-value="price-desc">
              Precio: mayor a menor
            </button>
            <button type="button" class="sort-option" role="option" data-sort-value="featured">
              Tendencia primero
            </button>
            <button type="button" class="sort-option" role="option" data-sort-value="discount">
              Descuento primero
            </button>
          </div>
        </div>
      </div>

      <div class="catalog-content">
        {
          productGroupsByCatalog.map((group) =>
            group.productsByBrand.map((entry) => (
              <BrandSection brand={entry.brand} products={entry.products} />
            )),
          )
        }
      </div>
    </main>
  </div>

  <Footer />
</Layout>

<script>
  import { initCatalogController } from "@/scripts/catalog-controller";

  function boot(): void {
    initCatalogController();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot, { once: true });
  } else {
    boot();
  }
</script>

<style>
  .catalog-shell {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 22px;
    padding: 22px clamp(16px, 3vw, 32px) 32px;
    max-width: var(--max-content-width);
    margin: 0 auto;
  }

  .catalog-main {
    min-width: 0;
  }

  .catalog-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 18px;
    padding: 0 4px;
  }

  /* ── Sort menu (botón Ordenar + dropdown) ───────────────────── */
  .sort-menu {
    position: relative;
  }
  .sort-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px 8px 12px;
    background: transparent;
    border: 0.5px solid rgba(201, 168, 76, 0.4);
    border-radius: var(--radius-pill);
    color: var(--color-cream);
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .sort-toggle:hover {
    border-color: var(--color-gold);
    background: rgba(201, 168, 76, 0.08);
  }
  .sort-toggle[aria-expanded="true"] {
    border-color: var(--color-gold);
    background: rgba(201, 168, 76, 0.12);
  }
  .sort-toggle svg:first-of-type {
    color: var(--color-gold);
  }
  .sort-chevron {
    transition: transform var(--transition-fast);
    color: var(--color-text-muted);
  }
  .sort-toggle[aria-expanded="true"] .sort-chevron {
    transform: rotate(180deg);
  }

  .sort-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 240px;
    background: linear-gradient(180deg, #1a1610 0%, #0e0c07 100%);
    border: 0.5px solid rgba(201, 168, 76, 0.3);
    border-radius: var(--radius-md);
    padding: 6px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  /* CSS class selector tiene la misma especificidad que [hidden], y como
     nuestra hoja se carga después, ganaba. Esta regla compuesta tiene
     mayor especificidad y respeta el atributo hidden del HTML. */
  .sort-panel[hidden] {
    display: none;
  }
  .sort-option {
    background: transparent;
    border: none;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 13px;
    text-align: left;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .sort-option:hover {
    background: rgba(201, 168, 76, 0.1);
    color: var(--color-cream);
  }
  .sort-option[aria-selected="true"] {
    color: var(--color-gold-light);
    background: rgba(201, 168, 76, 0.08);
  }
  .sort-option[aria-selected="true"]::after {
    content: "✓";
    float: right;
    color: var(--color-gold);
  }

  .catalog-result {
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .catalog-content {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  @media (max-width: 920px) {
    .catalog-shell {
      grid-template-columns: 1fr;
    }
  }

  /* En mobile el botón "Filtrar y ordenar" es más largo: aflojamos
     el letter-spacing y dejamos que la toolbar wrappee si no entra. */
  @media (max-width: 520px) {
    .sort-toggle {
      padding: 8px 12px 8px 10px;
      letter-spacing: 1.5px;
      font-size: 10.5px;
    }
    .sort-panel {
      /* No queremos que se desborde el viewport en mobile. Si la posición
         right: 0 lo hiciera pasarse a la izquierda del catálogo, lo limitamos
         con un ancho que se ajuste al espacio disponible. */
      min-width: 220px;
      max-width: calc(100vw - 32px);
    }
  }
</style>
