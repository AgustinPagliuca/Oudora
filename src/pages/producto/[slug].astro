---
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PerfumeBottle from "@/components/PerfumeBottle.astro";
import ProductLabels from "@/components/ProductLabels.astro";
import ProductCard from "@/components/ProductCard.astro";

import { PRODUCTS } from "@/data/products";
import { getBrandById } from "@/data/brands";
import {
  CATALOG_LABELS,
  GENDER_LABELS,
} from "@/constants/ui";
import { formatArs, formatPresentation } from "@/lib/format";
import { getStockLabel } from "@/lib/grouping";
import { buildWhatsAppInquiryUrl } from "@/lib/whatsapp";

export const getStaticPaths = (() => {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}) satisfies GetStaticPaths;

const { product } = Astro.props;
const brand = getBrandById(product.brandId);

if (brand === undefined) {
  return Astro.redirect("/catalogo");
}

const presentation = formatPresentation(product.concentration, product.volumeMl);
const formattedPrice = formatArs(product.priceArs);
const stockLabel = getStockLabel(product.stock);
const inquiryWhatsAppUrl = buildWhatsAppInquiryUrl(brand.name, product.name);
const variant = product.gender === "femenino"
  ? "warm"
  : product.gender === "masculino"
    ? "default"
    : "deep";

const relatedProducts = PRODUCTS
  .filter((p) => p.brandId === product.brandId && p.id !== product.id)
  .slice(0, 4);

const breadcrumbsTrail = [
  { label: "Inicio", href: "/" },
  // Lleva directo a la pestaña de su catálogo, igual que el menú.
  { label: CATALOG_LABELS[product.catalog], href: `/catalogo?catalogo=${product.catalog}` },
  { label: brand.name, href: `/marcas/${brand.slug}` },
  { label: product.name },
];
---

<Layout
  title={`${brand.name} ${product.name}`}
  description={`${brand.name} ${product.name}, ${presentation}. Perfume árabe original en Buenos Aires.`}
>
  <Nav />
  <div class="surface-light product-surface">
  <Breadcrumbs trail={breadcrumbsTrail} />

  <article class="product-detail">
    <div class="product-detail-gallery">
      <div class="product-detail-visual">
        <ProductLabels labels={product.labels} />
        {
          product.images !== undefined && product.images.length > 0 ? (
            <img
              src={product.images[0].url}
              alt={`${brand.name} ${product.name}`}
              class="product-detail-image-real"
              data-main-image
              loading="eager"
            />
          ) : (
            <PerfumeBottle
              label={product.name.length <= 10 ? product.name : undefined}
              caption={`${product.volumeMl} ML · ${product.concentration}`}
              variant={variant}
              size="lg"
              ariaLabel={`${brand.name} ${product.name}`}
            />
          )
        }
        {stockLabel && <span class="product-detail-stock">{stockLabel}</span>}
      </div>

      {
        product.images !== undefined && product.images.length > 1 && (
          <div class="product-detail-thumbs">
            {product.images.map((img, i) => (
              <button
                type="button"
                class={`product-detail-thumb${i === 0 ? " is-active" : ""}`}
                data-thumb
                data-url={img.url}
                aria-label={`Ver imagen ${i + 1}`}>
                <img src={img.url} alt="" loading="lazy" />
              </button>
            ))}
          </div>
        )
      }
    </div>

    <div class="product-detail-info" data-quantity-target>
      <p class="product-detail-brand">
        <a href={`/marcas/${brand.slug}`}>{brand.name}</a>
      </p>
      <h1 class="product-detail-name">{product.name}</h1>
      <p class="product-detail-pres">{presentation}</p>

      <div class="product-detail-price-row">
        <span class="product-detail-price">{formattedPrice}</span>
      </div>

      {product.stock > 0 ? (
        <div class="product-detail-qty">
          <p class="product-detail-qty-label">Cantidad</p>
          <div class="product-detail-qty-row">
            <div class="qty-stepper" role="group" aria-label="Seleccionar cantidad">
              <button
                type="button"
                class="qty-btn"
                data-quantity-decrement
                aria-label="Restar uno"
              >−</button>
              <input
                type="text"
                inputmode="numeric"
                class="qty-input"
                value="1"
                min="1"
                max={product.stock}
                data-quantity-input
                aria-label="Cantidad"
                readonly
              />
              <button
                type="button"
                class="qty-btn"
                data-quantity-increment
                aria-label="Sumar uno"
              >+</button>
            </div>
          </div>
        </div>
      ) : null}

      {product.stock > 0 ? (
        <button
          type="button"
          class="product-detail-add"
          data-add-to-cart
          data-product-id={product.id}
        >
          Agregar al carrito
        </button>
      ) : (
        <a
          href={inquiryWhatsAppUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="product-detail-add product-detail-add-inquiry"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
          </svg>
          Consultá disponibilidad por WhatsApp
        </a>
      )}

      <div class="product-detail-services">
        <div class="product-detail-service">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="1" y="3" width="15" height="13" />
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8" />
            <circle cx="5.5" cy="18.5" r="2.5" />
            <circle cx="18.5" cy="18.5" r="2.5" />
          </svg>
          <p class="product-detail-service-title">Envío gratis</p>
          <p class="product-detail-service-sub">desde $130.000</p>
        </div>
        <div class="product-detail-service">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            <polyline points="9 12 11 14 15 10" />
          </svg>
          <p class="product-detail-service-title">100% original</p>
          <p class="product-detail-service-sub">garantizado</p>
        </div>
        <div class="product-detail-service">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="5" width="20" height="14" rx="2" />
            <line x1="2" y1="10" x2="22" y2="10" />
          </svg>
          <p class="product-detail-service-title">Pago al coordinar</p>
          <p class="product-detail-service-sub">efectivo o transferencia, por WhatsApp</p>
        </div>
      </div>
    </div>
  </article>

  <section class="product-detail-tabs" data-tabs-container>
    <div class="product-detail-tabs-nav" role="tablist">
      <button
        type="button"
        class="product-detail-tab is-active"
        role="tab"
        aria-selected="true"
        data-tab-trigger="description"
      >
        Descripción
      </button>
      {product.notes && product.notes.length > 0 && (
        <button
          type="button"
          class="product-detail-tab"
          role="tab"
          aria-selected="false"
          data-tab-trigger="notes"
        >
          Notas olfativas
        </button>
      )}
      <button
        type="button"
        class="product-detail-tab"
        role="tab"
        aria-selected="false"
        data-tab-trigger="details"
      >
        Detalles
      </button>
    </div>

    <div class="product-detail-tab-panel is-active" data-tab-panel="description" role="tabpanel">
      {product.description ? (
        <p>{product.description}</p>
      ) : (
        <p class="product-detail-tab-empty">El vendedor todavía no agregó una descripción para esta fragancia.</p>
      )}
    </div>

    {product.notes && product.notes.length > 0 && (
      <div class="product-detail-tab-panel" data-tab-panel="notes" role="tabpanel" hidden>
        <ul class="product-detail-notes-list">
          {product.notes.map((note) => <li>{note}</li>)}
        </ul>
      </div>
    )}

    <div class="product-detail-tab-panel" data-tab-panel="details" role="tabpanel" hidden>
      <dl class="product-detail-meta">
        <div>
          <dt>Género</dt>
          <dd>{GENDER_LABELS[product.gender]}</dd>
        </div>
        <div>
          <dt>Concentración</dt>
          <dd>{product.concentration}</dd>
        </div>
        <div>
          <dt>Volumen</dt>
          <dd>{product.volumeMl} ml</dd>
        </div>
        <div>
          <dt>Catálogo</dt>
          <dd>{CATALOG_LABELS[product.catalog]}</dd>
        </div>
      </dl>
    </div>
  </section>

  {relatedProducts.length > 0 && (
    <section class="product-related">
      <h2 class="product-related-title">
        Más de <em>{brand.name}</em>
      </h2>
      <div class="product-related-grid">
        {relatedProducts.map((relProduct) => (
          <ProductCard product={relProduct} brand={brand} />
        ))}
      </div>
    </section>
  )}
  </div>

  <Footer />
</Layout>


<style>
  /* Detalle de producto sobre crema: foto sobre blanco, título en serif,
     botón principal oscuro, pestañas con subrayado y "Más de la marca"
     con la grilla del catálogo. Hovers solo de color. */
  .product-surface {
    padding-bottom: var(--space-8);
  }

  .product-detail {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: var(--space-5) clamp(16px, 4vw, 32px) var(--space-7);
    align-items: start;
  }

  /* Galería */
  .product-detail-gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .product-detail-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 5;
    padding: var(--space-6);
    background: #ffffff;
    overflow: hidden;
  }
  .product-detail-image-real {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .product-detail-stock {
    position: absolute;
    left: 50%;
    bottom: var(--space-3);
    translate: -50% 0;
    padding: var(--space-1) var(--space-3);
    background: var(--color-ink);
    color: var(--color-surface-light);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .product-detail-thumbs {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
  }
  .product-detail-thumb {
    flex: 0 0 72px;
    aspect-ratio: 1 / 1;
    padding: var(--space-1);
    background: #ffffff;
    border: 1px solid transparent;
    cursor: pointer;
    transition: border-color var(--transition-fast);
  }
  .product-detail-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .product-detail-thumb:hover {
    border-color: var(--color-ink-muted);
  }
  .product-detail-thumb.is-active {
    border-color: var(--color-ink);
  }

  /* Información */
  .product-detail-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
  }
  .product-detail-brand a {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-md);
    color: var(--color-ink-muted);
    transition: color var(--transition-fast);
  }
  .product-detail-brand a:hover {
    color: var(--color-gold-ink);
  }
  .product-detail-name {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 400;
    line-height: 1.1;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .product-detail-pres {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
  .product-detail-price-row {
    margin: var(--space-3) 0 var(--space-4);
  }
  .product-detail-price {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .product-detail-qty {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .product-detail-qty-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .qty-stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(26, 23, 18, 0.5);
  }
  .qty-btn {
    width: 44px;
    height: 44px;
    font-size: var(--text-lg);
    color: var(--color-ink);
    transition: color var(--transition-fast);
  }
  .qty-btn:hover:not(:disabled) {
    color: var(--color-gold-ink);
  }
  .qty-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .qty-input {
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    text-align: center;
    font-family: inherit;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .qty-input:focus {
    outline: 2px solid var(--color-gold-ink);
    outline-offset: -2px;
  }
  .qty-input::-webkit-inner-spin-button {
    display: none;
  }

  .product-detail-add {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    min-height: 52px;
    margin-top: var(--space-2);
    padding: 0 var(--space-5);
    background: var(--color-ink);
    color: var(--color-surface-light);
    font-family: inherit;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }
  .product-detail-add:hover:not(:disabled) {
    background: var(--color-gold-ink);
  }
  .product-detail-add:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .product-detail-add:focus-visible {
    outline: 2px solid var(--color-gold-ink);
    outline-offset: 2px;
  }
  .product-detail-add-inquiry svg {
    flex-shrink: 0;
  }

  .product-detail-services {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid rgba(26, 23, 18, 0.15);
  }
  .product-detail-service {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    color: var(--color-ink);
  }
  .product-detail-service svg {
    margin-bottom: var(--space-1);
  }
  .product-detail-service-title {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .product-detail-service-sub {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  /* Pestañas: subrayado en la activa (no solo color). */
  .product-detail-tabs {
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 32px) var(--space-7);
  }
  .product-detail-tabs-nav {
    display: flex;
    gap: var(--space-6);
    overflow-x: auto;
    border-bottom: 1px solid rgba(26, 23, 18, 0.15);
    scrollbar-width: none;
  }
  .product-detail-tabs-nav::-webkit-scrollbar {
    display: none;
  }
  .product-detail-tab {
    position: relative;
    flex: none;
    padding: var(--space-3) 0;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    transition: color var(--transition-fast);
  }
  .product-detail-tab:hover {
    color: var(--color-ink);
  }
  .product-detail-tab.is-active {
    color: var(--color-ink);
  }
  .product-detail-tab.is-active::after {
    content: "";
    position: absolute;
    inset: auto 0 -1px;
    border-bottom: 1px solid var(--color-ink);
  }
  .product-detail-tab-panel {
    max-width: 72ch;
    padding-top: var(--space-5);
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-ink-muted);
  }
  .product-detail-tab-panel[hidden] {
    display: none;
  }
  .product-detail-tab-empty {
    font-style: italic;
  }
  .product-detail-notes-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .product-detail-notes-list li {
    padding: var(--space-2) var(--space-3);
    border: 1px solid rgba(26, 23, 18, 0.3);
    font-size: var(--text-sm);
    color: var(--color-ink);
  }
  .product-detail-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-4);
    margin: 0;
  }
  .product-detail-meta dt {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .product-detail-meta dd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-base);
    color: var(--color-ink);
  }

  /* Más de la marca */
  .product-related {
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: var(--space-6) clamp(16px, 4vw, 32px) 0;
    border-top: 1px solid rgba(26, 23, 18, 0.15);
  }
  .product-related-title {
    margin-bottom: var(--space-6);
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 400;
    color: var(--color-ink);
    text-align: center;
  }
  .product-related-title em {
    font-style: normal;
  }
  .product-related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    column-gap: var(--space-4);
    row-gap: var(--space-6);
  }

  @media (max-width: 768px) {
    .product-detail {
      grid-template-columns: 1fr;
    }
    .product-detail-services {
      grid-template-columns: 1fr;
    }
    .product-related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // 1) Click en thumbnail cambia la imagen principal
    const mainImage = document.querySelector<HTMLImageElement>("[data-main-image]");
    const thumbs = document.querySelectorAll<HTMLButtonElement>("[data-thumb]");
    if (mainImage !== null && thumbs.length > 0) {
      thumbs.forEach((thumb) => {
        thumb.addEventListener("click", () => {
          const url = thumb.dataset.url;
          if (url === undefined) return;
          mainImage.src = url;
          thumbs.forEach((t) => t.classList.remove("is-active"));
          thumb.classList.add("is-active");
        });
      });
    }

    // 2) Selector de cantidad +/-
    const qtyInput = document.querySelector<HTMLInputElement>("[data-quantity-input]");
    const qtyDec = document.querySelector<HTMLButtonElement>("[data-quantity-decrement]");
    const qtyInc = document.querySelector<HTMLButtonElement>("[data-quantity-increment]");

    if (qtyInput !== null && qtyDec !== null && qtyInc !== null) {
      const min = parseInt(qtyInput.getAttribute("min") ?? "1", 10);
      const max = parseInt(qtyInput.getAttribute("max") ?? "99", 10);

      function refreshButtons(): void {
        const current = parseInt(qtyInput!.value, 10) || min;
        qtyDec!.disabled = current <= min;
        qtyInc!.disabled = current >= max;
      }

      qtyDec.addEventListener("click", () => {
        const current = parseInt(qtyInput.value, 10) || min;
        if (current > min) {
          qtyInput.value = String(current - 1);
          refreshButtons();
        }
      });
      qtyInc.addEventListener("click", () => {
        const current = parseInt(qtyInput.value, 10) || min;
        if (current < max) {
          qtyInput.value = String(current + 1);
          refreshButtons();
        }
      });
      refreshButtons();
    }

    // 3) Tabs: descripción / notas / detalles
    const tabsContainer = document.querySelector<HTMLElement>("[data-tabs-container]");
    if (tabsContainer !== null) {
      const triggers = tabsContainer.querySelectorAll<HTMLButtonElement>("[data-tab-trigger]");
      const panels = tabsContainer.querySelectorAll<HTMLElement>("[data-tab-panel]");

      triggers.forEach((trigger) => {
        trigger.addEventListener("click", () => {
          const target = trigger.dataset.tabTrigger;
          if (target === undefined) return;

          triggers.forEach((t) => {
            const isActive = t.dataset.tabTrigger === target;
            t.classList.toggle("is-active", isActive);
            t.setAttribute("aria-selected", isActive ? "true" : "false");
          });
          panels.forEach((p) => {
            const isActive = p.dataset.tabPanel === target;
            p.classList.toggle("is-active", isActive);
            p.hidden = !isActive;
          });
        });
      });
    }
  });
</script>
