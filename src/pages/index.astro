---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Hero from "@/components/Hero.astro";
import HeroCarousel from "@/components/HeroCarousel.astro";
import CollectionCards from "@/components/CollectionCards.astro";
import FeaturedStrip from "@/components/FeaturedStrip.astro";
import ReviewsSection from "@/components/ReviewsSection.astro";
import Footer from "@/components/Footer.astro";

import { PRODUCTS } from "@/data/products";
import { REVIEWS, HERO_SLIDES } from "@/data/catalog.generated";
import { getProductsByCatalog } from "@/lib/filters";

/**
 * Home: vitrina de bienvenida y entrada al catálogo.
 * Si hay slides cargados en admin, muestra el HeroCarousel. Si no,
 * muestra el Hero estático como fallback.
 */

const arabesFeatured = getProductsByCatalog(PRODUCTS, "arabe")
  .filter((product) => product.featured === true)
  .slice(0, 8);

const disenadorFeatured = getProductsByCatalog(PRODUCTS, "disenador")
  .filter((product) => product.featured === true)
  .slice(0, 8);

const featuredReviews = REVIEWS.filter((r) => r.featured).slice(0, 6);
---

<Layout>
  <Nav />
  {HERO_SLIDES.length > 0 ? <HeroCarousel slides={HERO_SLIDES} /> : <Hero />}
  <CollectionCards />

  <FeaturedStrip
    title="Destacados"
    highlight="árabes"
    products={arabesFeatured}
  />

  <FeaturedStrip
    title="Destacados"
    highlight="diseñador"
    products={disenadorFeatured}
  />

  <ReviewsSection reviews={featuredReviews} />

  <Footer />
</Layout>

