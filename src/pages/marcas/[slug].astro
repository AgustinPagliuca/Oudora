---
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import PageHeader from "@/components/PageHeader.astro";
import ProductCard from "@/components/ProductCard.astro";

import { BRANDS } from "@/data/brands";
import { PRODUCTS } from "@/data/products";
import { CATALOG_LABELS } from "@/constants/ui";

export const getStaticPaths = (() => {
  return BRANDS.map((brand) => ({
    params: { slug: brand.slug },
    props: { brand },
  }));
}) satisfies GetStaticPaths;

const { brand } = Astro.props;
const productsOfBrand = PRODUCTS.filter((p) => p.brandId === brand.id);

const breadcrumbsTrail = [
  { label: "Inicio", href: "/" },
  { label: "Marcas", href: "/marcas" },
  { label: brand.name },
];
---

<Layout
  title={brand.name}
  description={`Catálogo completo de ${brand.name} en OUDORA: ${productsOfBrand.length} fragancias originales con envío a todo el país.`}
>
  <Nav />
  <div class="surface-light">
  <PageHeader
    title={brand.name}
    subtitle={`${productsOfBrand.length} fragancias · ${CATALOG_LABELS[brand.catalog]}`}
    breadcrumbsTrail={breadcrumbsTrail}
  />

  <section class="brand-page">
    {productsOfBrand.length === 0 ? (
      <p class="brand-empty">Próximamente: sumamos productos de esta marca al catálogo.</p>
    ) : (
      <div class="brand-grid">
        {productsOfBrand.map((product) => (
          <ProductCard product={product} brand={brand} />
        ))}
      </div>
    )}
  </section>
  </div>

  <Footer />
</Layout>


<style>
  /* Detalle de marca sobre crema, con la misma grilla que el catálogo. */
  .brand-page {
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: var(--space-5) clamp(16px, 4vw, 32px) var(--space-8);
  }

  .brand-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    column-gap: var(--space-4);
    row-gap: var(--space-6);
  }

  .brand-empty {
    padding: var(--space-8) var(--space-4);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  @media (max-width: 640px) {
    .brand-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
