---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import PageHeader from "@/components/PageHeader.astro";

import { BRANDS, getBrandsByCatalog } from "@/data/brands";
import { PRODUCTS } from "@/data/products";
import { ALL_CATALOGS, CATALOG_LABELS } from "@/constants/ui";
import { countProductsByBrand } from "@/lib/grouping";
import { getProductsByCatalog } from "@/lib/filters";

const catalogGroups = ALL_CATALOGS.map((catalog) => {
  const productsInCatalog = getProductsByCatalog(PRODUCTS, catalog);
  const brandsInCatalog = getBrandsByCatalog(catalog);
  const brandsWithCount = countProductsByBrand(
    productsInCatalog,
    brandsInCatalog,
  );
  return {
    catalog,
    label: CATALOG_LABELS[catalog],
    brands: brandsWithCount,
  };
});
---

<Layout title="Marcas">
  <Nav />
  <div class="surface-light">
  <PageHeader
    title="Marcas"
    subtitle={`${BRANDS.length} marcas · ${PRODUCTS.length} fragancias`}
    breadcrumbsTrail={[{ label: "Inicio", href: "/" }, { label: "Marcas" }]}
  />

  <section class="brands-index">
    {
      catalogGroups.map((group) => (
        <div class="brands-group">
          <h2 class="brands-group-title">{group.label}</h2>
          <div class="brands-grid">
            {group.brands.map((brand) => (
              <a class="brands-card" href={`/marcas/${brand.slug}`}>
                <h3 class="brands-card-name">{brand.name}</h3>
                <p class="brands-card-count">
                  {brand.productCount}{" "}
                  {brand.productCount === 1 ? "fragancia" : "fragancias"}
                </p>
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </section>
  </div>

  <Footer />
</Layout>


<style>
  /* Marcas sobre crema: lista editorial con nombres grandes en serif y
     líneas finas, sin cajas. El hover solo cambia el color. */
  .brands-index {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: var(--space-5) clamp(16px, 4vw, 32px) var(--space-8);
  }

  .brands-group-title {
    margin-bottom: var(--space-4);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .brands-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    column-gap: var(--space-4);
    border-top: 1px solid rgba(26, 23, 18, 0.2);
  }

  .brands-card {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-5) 0;
    border-bottom: 1px solid rgba(26, 23, 18, 0.2);
  }
  .brands-card:hover .brands-card-name {
    color: var(--color-gold-ink);
  }
  .brands-card:focus-visible {
    outline: 2px solid var(--color-gold-ink);
    outline-offset: 2px;
  }

  .brands-card-name {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 400;
    line-height: 1.15;
    color: var(--color-ink);
    transition: color var(--transition-fast);
  }

  .brands-card-count {
    flex-shrink: 0;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums lining-nums;
  }
</style>
