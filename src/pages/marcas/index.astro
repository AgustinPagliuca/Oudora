---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageHeader from "@/components/PageHeader.astro";

import { BRANDS, getBrandsByCatalog } from "@/data/brands";
import { PRODUCTS } from "@/data/products";
import { ALL_CATALOGS, CATALOG_LABELS } from "@/constants/ui";
import { countProductsByBrand } from "@/lib/grouping";
import { getProductsByCatalog } from "@/lib/filters";

const catalogGroups = ALL_CATALOGS.map((catalog) => {
  const productsInCatalog = getProductsByCatalog(PRODUCTS, catalog);
  const brandsInCatalog = getBrandsByCatalog(catalog);
  const brandsWithCount = countProductsByBrand(
    productsInCatalog,
    brandsInCatalog,
  );
  return {
    catalog,
    label: CATALOG_LABELS[catalog],
    brands: brandsWithCount,
  };
});

const breadcrumbsTrail = [
  { label: "Inicio", href: "/" },
  { label: "Marcas" },
];
---

<Layout title="Marcas">
  <Nav />
  <Breadcrumbs trail={breadcrumbsTrail} />
  <PageHeader
    title="Nuestras"
    highlight="marcas"
    subtitle={`${BRANDS.length} marcas · ${PRODUCTS.length} fragancias`}
  />

  <section class="brands-index">
    {
      catalogGroups.map((group) => (
        <div class="brands-group">
          <h2 class="brands-group-title">{group.label}</h2>
          <div class="brands-grid">
            {group.brands.map((brand) => (
              <a class="brands-card" href={`/marcas/${brand.slug}`}>
                <h3 class="brands-card-name">{brand.name}</h3>
                <p class="brands-card-count">
                  {brand.productCount}{" "}
                  {brand.productCount === 1 ? "fragancia" : "fragancias"}
                </p>
                <span class="brands-card-arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </section>

  <Footer />
</Layout>


<style>
  .brands-index {
    padding: 24px clamp(16px, 4vw, 32px) 56px;
    max-width: var(--max-content-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .brands-group-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(20px, 3vw, 26px);
    color: var(--color-gold-light);
    letter-spacing: 2px;
    font-weight: 400;
    margin-bottom: 18px;
    padding-bottom: 10px;
    border-bottom: 0.5px solid var(--color-border);
  }

  .brands-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 8px;
  }

  .brands-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 20px;
    background: var(--color-bg-card);
    border: 0.5px solid rgba(201, 168, 76, 0.15);
    border-radius: var(--radius-md);
    transition: all var(--transition-default);
  }
  .brands-card:hover {
    background: var(--color-bg-card-hover);
    border-color: var(--color-gold);
    transform: translateY(-2px);
  }

  .brands-card-name {
    font-family: var(--font-serif);
    font-size: 22px;
    color: var(--color-cream);
    letter-spacing: 2px;
    font-weight: 400;
  }

  .brands-card-count {
    font-size: 11px;
    letter-spacing: 1.5px;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .brands-card-arrow {
    position: absolute;
    top: 22px;
    right: 20px;
    font-size: 18px;
    color: var(--color-gold);
    opacity: 0;
    transform: translateX(-4px);
    transition: all var(--transition-default);
  }
  .brands-card:hover .brands-card-arrow {
    opacity: 1;
    transform: translateX(0);
  }
</style>
