---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import BrandForm from "@/components/admin/BrandForm.astro";

const errorParam = Astro.url.searchParams.get("error");
const errorMessage =
  errorParam === "slug_taken"
    ? "Ya existe una marca con esa URL. Cambiá el slug y volvé a intentar."
    : errorParam === "validation"
      ? "Hay campos sin completar o con datos inválidos. Revisalos y volvé a guardar."
      : errorParam === "server"
        ? "No se pudieron guardar los cambios. Reintentá en un momento."
        : null;
---

<AdminLayout title="Nueva marca">
  <BrandForm errorMessage={errorMessage} />

  <script>
    import { initBrandFormController } from "@/scripts/admin/brand-form-controller";
    initBrandFormController();
  </script>
</AdminLayout>
