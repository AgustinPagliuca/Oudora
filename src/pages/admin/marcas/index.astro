---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";

const supabase = Astro.locals.supabase;

const [{ data: brandsData }, { data: productsData }] = await Promise.all([
  supabase
    .from("brands")
    .select("id, slug, name, catalog, sort_order, is_active")
    .order("sort_order")
    .order("name"),
  supabase.from("products").select("brand_id"),
]);

const brandsAll = brandsData ?? [];
const products = productsData ?? [];

// Filtro de visibility por query string. Default "all".
const visibilityFilter = Astro.url.searchParams.get("show") ?? "all";
const brands = brandsAll.filter((b) => {
  if (visibilityFilter === "visible") return b.is_active !== false;
  if (visibilityFilter === "hidden") return b.is_active === false;
  return true;
});

// Contador de productos por marca (más eficiente que hacer N queries)
const productCountByBrand = new Map<string, number>();
for (const p of products) {
  productCountByBrand.set(
    p.brand_id,
    (productCountByBrand.get(p.brand_id) ?? 0) + 1,
  );
}

const totalBrandsAll = brandsAll.length;
const totalVisible = brandsAll.filter((b) => b.is_active !== false).length;
const totalHidden = brandsAll.filter((b) => b.is_active === false).length;
const totalBrands = brands.length;
const orphanBrands = brands.filter(
  (b) => (productCountByBrand.get(b.id) ?? 0) === 0,
).length;

const flashCreated = Astro.url.searchParams.get("created") === "1";
const flashUpdated = Astro.url.searchParams.get("updated") === "1";
const flashDeleted = Astro.url.searchParams.get("deleted") === "1";
const flashToggled = Astro.url.searchParams.get("toggled") === "1";
const flashMessage = flashCreated
  ? "Marca creada correctamente."
  : flashUpdated
    ? "Cambios guardados correctamente."
    : flashDeleted
      ? "Marca eliminada."
      : flashToggled
        ? "Visibilidad actualizada."
        : null;

const errorParam = Astro.url.searchParams.get("error");
const errorMessage =
  errorParam === "has_products"
    ? "No se puede borrar una marca con productos asociados. Cambialos de marca o borralos primero."
    : null;

const CATALOG_LABEL: Record<string, string> = {
  arabe: "Árabe",
  disenador: "Diseñador",
};
---

<AdminLayout title="Marcas">
  <div class="page-header">
    <div>
      <p class="breadcrumb">
        <a href="/admin">Panel</a>
        <span aria-hidden="true">›</span>
        <span>Marcas</span>
      </p>
      <h1>Marcas</h1>
      <p class="page-subtitle">
        {totalBrandsAll} en total · {totalVisible} visibles · {totalHidden} ocultas
        {orphanBrands > 0 ? ` · ${orphanBrands} sin productos` : ""}
      </p>
    </div>
    <a href="/admin/marcas/nueva" class="btn btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="12" y1="5" x2="12" y2="19" />
        <line x1="5" y1="12" x2="19" y2="12" />
      </svg>
      Nueva marca
    </a>
  </div>

  {flashMessage !== null && <div class="alert alert-success">{flashMessage}</div>}
  {errorMessage !== null && <div class="alert alert-error">{errorMessage}</div>}

  <div class="visibility-tabs" role="tablist">
    <a
      href="/admin/marcas"
      class={`visibility-tab ${visibilityFilter === "all" ? "is-active" : ""}`}
      role="tab"
      aria-selected={visibilityFilter === "all"}
    >
      Todas
      <span class="visibility-tab-count">{totalBrandsAll}</span>
    </a>
    <a
      href="/admin/marcas?show=visible"
      class={`visibility-tab ${visibilityFilter === "visible" ? "is-active" : ""}`}
      role="tab"
      aria-selected={visibilityFilter === "visible"}
    >
      Visibles
      <span class="visibility-tab-count">{totalVisible}</span>
    </a>
    <a
      href="/admin/marcas?show=hidden"
      class={`visibility-tab ${visibilityFilter === "hidden" ? "is-active" : ""}`}
      role="tab"
      aria-selected={visibilityFilter === "hidden"}
    >
      Ocultas
      <span class="visibility-tab-count">{totalHidden}</span>
    </a>
  </div>

  <div class="filters" data-brand-filters>
    <div class="filter-search">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <line x1="16.5" y1="16.5" x2="21" y2="21" stroke-linecap="round" />
      </svg>
      <input
        type="search"
        placeholder="Buscar por nombre…"
        data-filter-q
        autocomplete="off"
      />
    </div>
    <select data-filter-catalog>
      <option value="">Todos los catálogos</option>
      <option value="arabe">Árabes</option>
      <option value="disenador">Diseñador</option>
    </select>
  </div>

  {
    brands.length === 0 ? (
      <div class="panel empty-state">
        <p>Todavía no hay marcas cargadas.</p>
        <a href="/admin/marcas/nueva" class="btn btn-primary">
          Crear la primera
        </a>
      </div>
    ) : (
      <div class="panel table-panel">
        <table class="data-table">
          <thead>
            <tr>
              <th>Marca</th>
              <th>Catálogo</th>
              <th class="centered">Orden</th>
              <th class="centered">Productos</th>
              <th />
            </tr>
          </thead>
          <tbody>
            {brands.map((b) => {
              const count = productCountByBrand.get(b.id) ?? 0;
              const canDelete = count === 0;
              const searchText = b.name.toLowerCase();
              const isHidden = b.is_active === false;
              return (
                <tr
                  data-brand-row
                  data-row-href={`/admin/marcas/${b.id}`}
                  data-catalog={b.catalog}
                  data-search-text={searchText}
                  class={isHidden ? "row-hidden" : ""}>
                  <td>
                    <p class="cell-name">
                      {b.name}
                      {isHidden && <span class="hidden-badge">Oculto</span>}
                    </p>
                    <p class="cell-slug">{b.slug}</p>
                  </td>
                  <td class="muted">{CATALOG_LABEL[b.catalog] ?? b.catalog}</td>
                  <td class="centered muted">{b.sort_order}</td>
                  <td class="centered">
                    <span class={count === 0 ? "count-badge count-badge-empty" : "count-badge"}>
                      {count}
                    </span>
                  </td>
                  <td class="actions">
                    <form
                      method="POST"
                      action={`/api/admin/brands/${b.id}/toggle-active`}
                      class="inline-form"
                    >
                      <button
                        type="submit"
                        class="action-btn"
                        aria-label={isHidden ? `Mostrar ${b.name}` : `Ocultar ${b.name}`}
                        title={isHidden ? "Mostrar en la tienda" : "Ocultar de la tienda"}
                      >
                        {isHidden ? (
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
                            <line x1="1" y1="1" x2="23" y2="23" />
                          </svg>
                        ) : (
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                          </svg>
                        )}
                      </button>
                    </form>
                    <a
                      href={`/admin/marcas/${b.id}`}
                      class="action-btn"
                      aria-label={`Editar ${b.name}`}
                      title="Editar">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                      </svg>
                    </a>
                    <button
                      type="button"
                      class={canDelete ? "action-btn action-btn-danger" : "action-btn action-btn-disabled"}
                      data-delete-trigger
                      data-brand-id={b.id}
                      data-brand-name={b.name}
                      data-can-delete={canDelete ? "true" : "false"}
                      aria-label={canDelete ? `Borrar ${b.name}` : `${b.name} tiene productos, no se puede borrar`}
                      title={canDelete ? "Borrar" : `Tiene ${count} productos asociados`}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <polyline points="3 6 5 6 21 6" stroke-linecap="round" />
                        <path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                      </svg>
                    </button>
                  </td>
                </tr>
              );
            })}
            <tr data-empty-row hidden>
              <td colspan="5" class="empty-results">
                No se encontraron marcas con esos filtros.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    )
  }

  <div class="modal-backdrop" data-delete-modal aria-hidden="true">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
      <h2 id="delete-modal-title">Borrar marca</h2>
      <p>
        Estás por borrar <strong data-delete-brand-name>—</strong>. Esta acción no se puede deshacer.
      </p>
      <form method="POST" data-delete-form>
        <input type="hidden" name="_method" value="DELETE" />
        <div class="modal-actions">
          <button type="button" class="btn btn-ghost" data-delete-cancel>
            Cancelar
          </button>
          <button type="submit" class="btn btn-danger">Borrar marca</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { initBrandListController } from "@/scripts/admin/brand-list-controller";
    import { initRowClickNavigation } from "@/scripts/admin/row-click-navigation";
    initBrandListController();
    initRowClickNavigation();
  </script>
</AdminLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 24px;
  }
  .breadcrumb {
    font-size: 14px;
    color: var(--admin-text-muted);
    margin-bottom: 4px;
  }
  .breadcrumb a {
    color: var(--admin-accent);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb span[aria-hidden] {
    margin: 0 6px;
    color: var(--admin-text-faint);
  }
  .page-subtitle {
    color: var(--admin-text-muted);
    font-size: 14px;
    margin-top: 4px;
  }

  .alert {
    padding: 12px 16px;
    border-radius: var(--admin-radius-sm);
    font-size: 14px;
    margin-bottom: 16px;
  }
  .alert-success {
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }
  .alert-error {
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }

  .filters {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    margin-bottom: 16px;
  }
  @media (max-width: 720px) {
    .filters {
      grid-template-columns: 1fr;
    }
  }
  .filter-search {
    position: relative;
  }
  .filter-search svg {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--admin-text-faint);
  }
  .filter-search input {
    width: 100%;
    padding: 10px 12px 10px 36px;
    background: var(--admin-bg-input);
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius-sm);
    font-family: inherit;
    font-size: 15px;
  }
  .filter-search input:focus {
    outline: none;
    border-color: var(--admin-accent);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }
  .filters select {
    padding: 10px 12px;
    background: var(--admin-bg-input);
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius-sm);
    font-family: inherit;
    font-size: 15px;
    color: var(--admin-text);
    cursor: pointer;
  }

  .table-panel {
    overflow: hidden;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .data-table thead {
    background: var(--admin-bg);
    border-bottom: 1px solid var(--admin-border);
  }
  .data-table th {
    padding: 12px 14px;
    text-align: left;
    font-weight: 500;
    color: var(--admin-text-muted);
    font-size: 12px;
  }
  .data-table th.centered,
  .data-table td.centered {
    text-align: center;
  }
  .data-table tbody tr {
    border-bottom: 1px solid var(--admin-border);
    transition: background 0.1s;
  }
  .data-table tbody tr:last-child {
    border-bottom: none;
  }
  .data-table tbody tr:hover {
    background: var(--admin-bg);
  }
  .data-table tbody tr[data-hidden="true"] {
    display: none;
  }
  .data-table td {
    padding: 12px 14px;
    color: var(--admin-text);
  }
  .data-table td.muted {
    color: var(--admin-text-muted);
  }

  .cell-name {
    font-weight: 500;
  }
  .cell-slug {
    font-size: 12px;
    color: var(--admin-text-faint);
    font-family: ui-monospace, monospace;
    margin-top: 2px;
  }

  .count-badge {
    display: inline-block;
    min-width: 26px;
    padding: 2px 10px;
    background: var(--admin-bg);
    border: 1px solid var(--admin-border);
    border-radius: 12px;
    font-size: 12px;
  }
  .count-badge-empty {
    color: var(--admin-text-faint);
  }

  .actions {
    text-align: right;
    white-space: nowrap;
  }
  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin-left: 2px;
    border: 1px solid transparent;
    border-radius: var(--admin-radius-sm);
    background: transparent;
    color: var(--admin-text-muted);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s;
  }
  .action-btn:hover {
    background: var(--admin-bg);
    border-color: var(--admin-border);
    color: var(--admin-text);
  }
  .action-btn-danger:hover {
    color: var(--admin-danger);
    border-color: #fca5a5;
    background: #fef2f2;
  }
  .action-btn-disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .action-btn-disabled:hover {
    background: transparent;
    border-color: transparent;
    color: var(--admin-text-muted);
  }

  .empty-results {
    text-align: center;
    color: var(--admin-text-muted);
    padding: 32px 16px;
    font-style: italic;
  }
  .empty-state {
    padding: 48px 32px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 20px;
  }
  .modal-backdrop[aria-hidden="false"] {
    display: flex;
  }
  .modal {
    background: var(--admin-bg-panel);
    border-radius: var(--admin-radius-lg);
    padding: 24px;
    max-width: 440px;
    width: 100%;
    box-shadow: var(--admin-shadow-lg);
  }
  .modal h2 {
    margin-bottom: 8px;
  }
  .modal p {
    color: var(--admin-text-muted);
    margin-bottom: 20px;
  }
  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }

  /* ── Tabs de visibility (Todas / Visibles / Ocultas) ─────────── */
  .visibility-tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--admin-border);
  }
  .visibility-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    color: var(--admin-text-faint);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color 0.15s, border-color 0.15s;
  }
  .visibility-tab:hover {
    color: var(--admin-text);
  }
  .visibility-tab.is-active {
    color: var(--admin-text);
    border-bottom-color: var(--admin-accent);
  }
  .visibility-tab-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    padding: 2px 6px;
    background: var(--admin-bg-elevated);
    border-radius: 999px;
    font-size: 11px;
    color: var(--admin-text-faint);
  }
  .visibility-tab.is-active .visibility-tab-count {
    background: var(--admin-accent);
    color: var(--admin-bg);
    font-weight: 600;
  }

  /* ── Fila oculta: opacity reducida + badge inline ────────────── */
  tr.row-hidden td {
    opacity: 0.55;
  }
  tr.row-hidden td.actions {
    opacity: 1;
  }

  /* ── Fila clickable: cursor pointer + hover sutil ────────────── */
  tr[data-row-href] {
    cursor: pointer;
  }
  tr[data-row-href]:hover {
    background: var(--admin-bg-hover, rgba(255, 255, 255, 0.03));
  }
  tr[data-row-href] .actions {
    cursor: default;
  }
  .hidden-badge {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 7px;
    background: rgba(160, 160, 160, 0.15);
    border: 1px solid rgba(160, 160, 160, 0.3);
    border-radius: 4px;
    font-size: 10px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--admin-text-faint);
    font-weight: 600;
    vertical-align: middle;
  }

  /* ── Form inline para el toggle ──────────────────────────────── */
  .inline-form {
    display: inline-flex;
    margin: 0;
  }
</style>
