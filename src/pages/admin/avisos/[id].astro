---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import AnnouncementForm from "@/components/admin/AnnouncementForm.astro";
import type { AnnouncementIcon } from "@/types/catalog";

const supabase = Astro.locals.supabase;
const { id } = Astro.params;

if (id === undefined) return Astro.redirect("/admin/avisos");

const { data: raw } = await supabase
  .from("announcements")
  .select("id, text, icon, sort_order, published, created_at")
  .eq("id", id)
  .maybeSingle();

if (raw === null) return Astro.redirect("/admin/avisos");

const announcement = {
  id: raw.id,
  text: raw.text,
  icon: (raw.icon ?? null) as AnnouncementIcon | null,
  sortOrder: raw.sort_order,
  published: raw.published,
};

const errorParam = Astro.url.searchParams.get("error");
const errorMessage =
  errorParam === "validation"
    ? "Hay campos sin completar o con datos inválidos. Revisalos y volvé a guardar."
    : errorParam === "server"
      ? "No se pudieron guardar los cambios. Reintentá en un momento."
      : null;

const justCreated = Astro.url.searchParams.get("created") === "1";
const successMessage = justCreated ? "Aviso creado correctamente." : null;
---

<AdminLayout title="Editar aviso">
  <AnnouncementForm
    announcement={announcement}
    errorMessage={errorMessage}
    successMessage={successMessage}
  />
</AdminLayout>
