---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";

const supabase = Astro.locals.supabase;

const { data: announcementsData } = await supabase
  .from("announcements")
  .select("id, text, icon, published, sort_order, created_at")
  .order("sort_order")
  .order("created_at", { ascending: false });

const announcements = announcementsData ?? [];
const publishedCount = announcements.filter((a) => a.published).length;

const flashCreated = Astro.url.searchParams.get("created") === "1";
const flashUpdated = Astro.url.searchParams.get("updated") === "1";
const flashDeleted = Astro.url.searchParams.get("deleted") === "1";
const flashMessage = flashCreated
  ? "Aviso creado correctamente."
  : flashUpdated
    ? "Cambios guardados correctamente."
    : flashDeleted
      ? "Aviso eliminado."
      : null;

const iconLabels: Record<string, string> = {
  truck: "🚚",
  gift: "🎁",
  percent: "🏷️",
  "credit-card": "💳",
  star: "⭐",
  clock: "⏰",
  "map-pin": "📍",
};
---

<AdminLayout title="Avisos">
  <div class="page-header">
    <div>
      <p class="breadcrumb">
        <a href="/admin">Panel</a>
        <span aria-hidden="true">›</span>
        <span>Avisos</span>
      </p>
      <h1>Avisos</h1>
      <p class="page-subtitle">
        {announcements.length} avisos{publishedCount > 0 && ` · ${publishedCount} publicados`}
      </p>
    </div>
    <a href="/admin/avisos/nuevo" class="btn btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="12" y1="5" x2="12" y2="19" />
        <line x1="5" y1="12" x2="19" y2="12" />
      </svg>
      Nuevo aviso
    </a>
  </div>

  {flashMessage !== null && <div class="alert alert-success">{flashMessage}</div>}

  {announcements.length === 0 ? (
    <div class="panel empty-state">
      <p>Todavía no hay avisos cargados.</p>
      <p class="empty-hint">
        Los avisos aparecen rotando en la barra superior del sitio. Si cargás varios, rotan cada 5 segundos.
      </p>
      <a href="/admin/avisos/nuevo" class="btn btn-primary">Cargar el primero</a>
    </div>
  ) : (
    <div class="announcement-list">
      {announcements.map((a) => (
        <a href={`/admin/avisos/${a.id}`} class="announcement-row">
          <div class="announcement-icon-cell">
            {a.icon ? (iconLabels[a.icon] ?? "•") : "—"}
          </div>
          <div class="announcement-text-cell">
            <p class="announcement-text">{a.text}</p>
            <div class="announcement-meta">
              {a.published ? (
                <span class="badge badge-published">Publicado</span>
              ) : (
                <span class="badge badge-draft">Borrador</span>
              )}
              <span class="announcement-order">Orden {a.sort_order}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  )}
</AdminLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 24px;
  }
  .breadcrumb { font-size: 14px; color: var(--admin-text-muted); margin-bottom: 4px; }
  .breadcrumb a { color: var(--admin-accent); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb span[aria-hidden] { margin: 0 6px; color: var(--admin-text-faint); }
  .page-subtitle { color: var(--admin-text-muted); font-size: 14px; margin-top: 4px; }

  .alert {
    padding: 12px 16px;
    border-radius: var(--admin-radius-sm);
    font-size: 14px;
    margin-bottom: 16px;
  }
  .alert-success { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }

  .empty-state {
    padding: 48px 32px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .empty-hint {
    font-size: 13px;
    color: var(--admin-text-muted);
    max-width: 420px;
  }

  .announcement-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .announcement-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
    background: var(--admin-bg-panel);
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius-md);
    text-decoration: none;
    color: inherit;
    transition: all 0.15s;
  }
  .announcement-row:hover {
    border-color: var(--admin-accent);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
    text-decoration: none;
  }
  .announcement-icon-cell {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--admin-bg);
    border: 1px solid var(--admin-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
    color: var(--admin-text-faint);
  }
  .announcement-text-cell {
    flex: 1;
    min-width: 0;
  }
  .announcement-text {
    font-size: 14px;
    color: var(--admin-text);
    margin-bottom: 4px;
    font-weight: 500;
  }
  .announcement-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
  }
  .badge {
    font-size: 10px;
    font-weight: 500;
    padding: 2px 8px;
    border-radius: 10px;
    letter-spacing: 0.3px;
  }
  .badge-published {
    background: #ecfdf5;
    color: #047857;
    border: 1px solid #a7f3d0;
  }
  .badge-draft {
    background: var(--admin-bg);
    color: var(--admin-text-muted);
    border: 1px solid var(--admin-border);
  }
  .announcement-order {
    color: var(--admin-text-faint);
  }
</style>
