---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import ProductForm from "@/components/admin/ProductForm.astro";

const supabase = Astro.locals.supabase;
const { id } = Astro.params;

if (id === undefined) {
  return Astro.redirect("/admin/productos");
}

const [{ data: productRaw }, { data: brandsData }, { data: imagesData }] =
  await Promise.all([
    supabase
      .from("products")
      .select(
        "id, slug, brand_id, catalog, name, gender, concentration, volume_ml, price_ars, stock, notes, description, featured, is_active, labels, created_at",
      )
      .eq("id", id)
      .maybeSingle(),
    supabase.from("brands").select("id, name").order("name"),
    supabase
      .from("product_images")
      .select("id, url, position")
      .eq("product_id", id)
      .order("position"),
  ]);

if (productRaw === null) {
  return Astro.redirect("/admin/productos");
}

const product = {
  id: productRaw.id,
  slug: productRaw.slug,
  brandId: productRaw.brand_id,
  catalog: productRaw.catalog,
  name: productRaw.name,
  gender: productRaw.gender,
  concentration: productRaw.concentration,
  volumeMl: productRaw.volume_ml,
  priceArs: productRaw.price_ars,
  stock: productRaw.stock,
  notes: Array.isArray(productRaw.notes) ? productRaw.notes : [],
  description: typeof productRaw.description === "string" ? productRaw.description : "",
  featured: productRaw.featured === true,
  is_active: productRaw.is_active !== false,
  labels: Array.isArray(productRaw.labels)
    ? productRaw.labels
        .filter(
          (l: unknown): l is { text: string; color: string } =>
            typeof l === "object" &&
            l !== null &&
            typeof (l as { text?: unknown }).text === "string" &&
            typeof (l as { color?: unknown }).color === "string",
        )
        .slice(0, 3)
    : [],
  createdAt: productRaw.created_at,
  images: imagesData ?? [],
};

const brands = brandsData ?? [];

const errorParam = Astro.url.searchParams.get("error");
const errorMessage =
  errorParam === "slug_taken"
    ? "Ya existe un producto con esa URL. Cambiá el slug y volvé a intentar."
    : errorParam === "validation"
      ? "Hay campos sin completar o con datos inválidos. Revisalos y volvé a guardar."
      : errorParam === "server"
        ? "No se pudieron guardar los cambios. Reintentá en un momento."
        : null;

const justCreated = Astro.url.searchParams.get("created") === "1";
const successMessage = justCreated
  ? "Producto creado. Ahora podés agregar imágenes y ajustar lo que necesites."
  : null;
---

<AdminLayout title={product.name}>
  <ProductForm
    brands={brands}
    product={product}
    errorMessage={errorMessage}
    successMessage={successMessage}
  />

  <script>
    import { initProductFormController } from "@/scripts/admin/product-form-controller";
    import { initProductImagesController } from "@/scripts/admin/product-images-controller";
    initProductFormController();
    initProductImagesController();
  </script>
</AdminLayout>
