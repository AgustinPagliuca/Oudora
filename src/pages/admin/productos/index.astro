---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import { formatArs } from "@/lib/format";

const supabase = Astro.locals.supabase;

/**
 * Lee marcas y productos directo de Supabase (server-side).
 * Sin paginación todavía — con 40-100 productos rinde sin drama. Cuando
 * lleguemos a 600, agregamos cursor pagination.
 */
const [{ data: brandsData }, { data: productsData, error: productsError }] =
  await Promise.all([
    supabase.from("brands").select("id, slug, name, catalog").order("name"),
    supabase
      .from("products")
      .select(
        "id, slug, brand_id, catalog, name, gender, concentration, volume_ml, price_ars, stock, featured, is_active, notes",
      )
      .order("created_at", { ascending: false }),
  ]);

if (productsError !== null) {
  console.error("[admin/productos] Error leyendo productos:", productsError);
}

const brands = brandsData ?? [];
const productsAll = productsData ?? [];

// Filtro de visibility por query string. Default "all" para no esconder nada.
// "visible"   = solo is_active true (o null = retro-compat).
// "hidden"    = solo is_active false.
// "featured"  = solo featured true (independiente de visibilidad, así el
//               vendedor también ve los destacados que están ocultos —
//               se distinguen visualmente por el badge "Oculto").
const visibilityFilter = Astro.url.searchParams.get("show") ?? "all";
const products = productsAll.filter((p) => {
  if (visibilityFilter === "visible") return p.is_active !== false;
  if (visibilityFilter === "hidden") return p.is_active === false;
  if (visibilityFilter === "featured") return p.featured === true;
  return true;
});

const brandsById = new Map(brands.map((b) => [b.id, b]));
const totalProducts = products.length;
const totalAll = productsAll.length;
const totalVisible = productsAll.filter((p) => p.is_active !== false).length;
const totalHidden = productsAll.filter((p) => p.is_active === false).length;
const totalFeatured = productsAll.filter((p) => p.featured === true).length;
const featuredCount = products.filter((p) => p.featured).length;

const flashCreated = Astro.url.searchParams.get("created") === "1";
const flashUpdated = Astro.url.searchParams.get("updated") === "1";
const flashDeleted = Astro.url.searchParams.get("deleted") === "1";
const flashToggled = Astro.url.searchParams.get("toggled") === "1";
const flashFeatured = Astro.url.searchParams.get("featured") === "1";
const flashMessage = flashCreated
  ? "Producto creado correctamente."
  : flashUpdated
    ? "Cambios guardados correctamente."
    : flashDeleted
      ? "Producto eliminado."
      : flashToggled
        ? "Visibilidad actualizada."
        : flashFeatured
          ? "Marca de destacado actualizada."
          : null;

const GENDER_LABEL: Record<string, string> = {
  femenino: "Fem.",
  masculino: "Masc.",
  unisex: "Unisex",
};

const CATALOG_LABEL: Record<string, string> = {
  arabe: "Árabe",
  disenador: "Diseñador",
};

function stockBadgeClass(stock: number): string {
  if (stock === 0) return "stock-badge stock-badge-out";
  if (stock <= 2) return "stock-badge stock-badge-low";
  return "stock-badge";
}
---

<AdminLayout title="Productos">
  <div class="page-header">
    <div>
      <p class="breadcrumb">
        <a href="/admin">Panel</a>
        <span aria-hidden="true">›</span>
        <span>Productos</span>
      </p>
      <h1>Productos</h1>
      <p class="page-subtitle">
        {totalAll} en total · {totalVisible} visibles · {totalHidden} ocultos
      </p>
    </div>
    <a href="/admin/productos/nuevo" class="btn btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="12" y1="5" x2="12" y2="19" />
        <line x1="5" y1="12" x2="19" y2="12" />
      </svg>
      Nuevo producto
    </a>
  </div>

  {flashMessage !== null && <div class="alert alert-success">{flashMessage}</div>}

  <div class="visibility-tabs" role="tablist">
    <a
      href="/admin/productos"
      class={`visibility-tab ${visibilityFilter === "all" ? "is-active" : ""}`}
      role="tab"
      aria-selected={visibilityFilter === "all"}
    >
      Todos
      <span class="visibility-tab-count">{totalAll}</span>
    </a>
    <a
      href="/admin/productos?show=visible"
      class={`visibility-tab ${visibilityFilter === "visible" ? "is-active" : ""}`}
      role="tab"
      aria-selected={visibilityFilter === "visible"}
    >
      Visibles
      <span class="visibility-tab-count">{totalVisible}</span>
    </a>
    <a
      href="/admin/productos?show=hidden"
      class={`visibility-tab ${visibilityFilter === "hidden" ? "is-active" : ""}`}
      role="tab"
      aria-selected={visibilityFilter === "hidden"}
    >
      Ocultos
      <span class="visibility-tab-count">{totalHidden}</span>
    </a>
    <a
      href="/admin/productos?show=featured"
      class={`visibility-tab ${visibilityFilter === "featured" ? "is-active" : ""}`}
      role="tab"
      aria-selected={visibilityFilter === "featured"}
    >
      <span class="visibility-tab-star" aria-hidden="true">★</span>
      Destacados
      <span class="visibility-tab-count">{totalFeatured}</span>
    </a>
  </div>

  <div class="filters" data-product-filters>
    <div class="filter-search">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <line x1="16.5" y1="16.5" x2="21" y2="21" stroke-linecap="round" />
      </svg>
      <input
        type="search"
        placeholder="Buscar por marca, nombre o nota olfativa…"
        data-filter-q
        autocomplete="off"
      />
    </div>
    <select data-filter-catalog>
      <option value="">Todos los catálogos</option>
      <option value="arabe">Árabes</option>
      <option value="disenador">Diseñador</option>
    </select>
    <select data-filter-gender>
      <option value="">Todos los géneros</option>
      <option value="femenino">Femenino</option>
      <option value="masculino">Masculino</option>
      <option value="unisex">Unisex</option>
    </select>
  </div>

  {
    products.length === 0 ? (
      <div class="panel empty-state">
        <p>Todavía no hay productos cargados.</p>
        <a href="/admin/productos/nuevo" class="btn btn-primary">
          Crear el primero
        </a>
      </div>
    ) : (
      <div class="panel table-panel">
        <table class="data-table">
          <thead>
            <tr>
              <th>Producto</th>
              <th>Presentación</th>
              <th>Catálogo</th>
              <th>Género</th>
              <th class="numeric">Precio</th>
              <th class="centered">Stock</th>
              <th class="centered" aria-label="Destacado">★</th>
              <th />
            </tr>
          </thead>
          <tbody>
            {products.map((p) => {
              const brand = brandsById.get(p.brand_id);
              const notesText = Array.isArray(p.notes) ? p.notes.join(" ") : "";
              const searchText = `${brand?.name ?? ""} ${p.name} ${p.concentration ?? ""} ${notesText}`.toLowerCase();
              const isHidden = p.is_active === false;
              return (
                <tr
                  data-product-row
                  data-row-href={`/admin/productos/${p.id}`}
                  data-catalog={p.catalog}
                  data-gender={p.gender}
                  data-search-text={searchText}
                  class={isHidden ? "row-hidden" : ""}
                >
                  <td>
                    <p class="cell-brand">{brand?.name ?? "—"}</p>
                    <p class="cell-name">
                      {p.name}
                      {isHidden && <span class="hidden-badge">Oculto</span>}
                    </p>
                  </td>
                  <td class="muted">
                    {p.concentration} · {p.volume_ml} ml
                  </td>
                  <td class="muted">{CATALOG_LABEL[p.catalog] ?? p.catalog}</td>
                  <td class="muted">{GENDER_LABEL[p.gender] ?? p.gender}</td>
                  <td class="numeric">{formatArs(p.price_ars)}</td>
                  <td class="centered">
                    <span class={stockBadgeClass(p.stock)}>{p.stock}</span>
                  </td>
                  <td class="centered">
                    <form
                      method="POST"
                      action={`/api/admin/products/${p.id}/toggle-featured`}
                      class="inline-form"
                    >
                      <button
                        type="submit"
                        class={p.featured ? "featured-toggle is-featured" : "featured-toggle"}
                        aria-label={p.featured ? `Quitar destacado de ${p.name}` : `Destacar ${p.name}`}
                        title={p.featured ? "Destacado — click para quitar" : "Click para destacar en home"}
                      >
                        {p.featured ? (
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                          </svg>
                        ) : (
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                          </svg>
                        )}
                      </button>
                    </form>
                  </td>
                  <td class="actions">
                    <form
                      method="POST"
                      action={`/api/admin/products/${p.id}/toggle-active`}
                      class="inline-form"
                    >
                      <button
                        type="submit"
                        class="action-btn"
                        aria-label={isHidden ? `Mostrar ${p.name}` : `Ocultar ${p.name}`}
                        title={isHidden ? "Mostrar en la tienda" : "Ocultar de la tienda"}
                      >
                        {isHidden ? (
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
                            <line x1="1" y1="1" x2="23" y2="23" />
                          </svg>
                        ) : (
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                          </svg>
                        )}
                      </button>
                    </form>
                    <a
                      href={`/admin/productos/${p.id}`}
                      class="action-btn"
                      aria-label={`Editar ${p.name}`}
                      title="Editar"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                      </svg>
                    </a>
                    <button
                      type="button"
                      class="action-btn action-btn-danger"
                      data-delete-trigger
                      data-product-id={p.id}
                      data-product-name={`${brand?.name ?? ""} ${p.name}`.trim()}
                      aria-label={`Borrar ${p.name}`}
                      title="Borrar"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <polyline points="3 6 5 6 21 6" stroke-linecap="round" />
                        <path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                      </svg>
                    </button>
                  </td>
                </tr>
              );
            })}
            <tr data-empty-row hidden>
              <td colspan="8" class="empty-results">
                No se encontraron productos con esos filtros.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    )
  }

  <!-- Modal de confirmación de borrado -->
  <div class="modal-backdrop" data-delete-modal aria-hidden="true">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
      <h2 id="delete-modal-title">Borrar producto</h2>
      <p>
        Estás por borrar <strong data-delete-product-name>—</strong>. Esta
        acción no se puede deshacer.
      </p>
      <form method="POST" data-delete-form>
        <input type="hidden" name="_method" value="DELETE" />
        <div class="modal-actions">
          <button type="button" class="btn btn-ghost" data-delete-cancel>
            Cancelar
          </button>
          <button type="submit" class="btn btn-danger">Borrar producto</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { initProductListController } from "@/scripts/admin/product-list-controller";
    import { initRowClickNavigation } from "@/scripts/admin/row-click-navigation";
    initProductListController();
    initRowClickNavigation();
  </script>
</AdminLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 24px;
  }

  .breadcrumb {
    font-size: 14px;
    color: var(--admin-text-muted);
    margin-bottom: 4px;
  }
  .breadcrumb a {
    color: var(--admin-accent);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb span[aria-hidden] {
    margin: 0 6px;
    color: var(--admin-text-faint);
  }

  .page-subtitle {
    color: var(--admin-text-muted);
    font-size: 14px;
    margin-top: 4px;
  }

  .alert {
    padding: 12px 16px;
    border-radius: var(--admin-radius-sm);
    font-size: 14px;
    margin-bottom: 16px;
  }
  .alert-success {
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  .filters {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 10px;
    margin-bottom: 16px;
  }
  @media (max-width: 720px) {
    .filters {
      grid-template-columns: 1fr;
    }
  }

  .filter-search {
    position: relative;
  }
  .filter-search svg {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--admin-text-faint);
  }
  .filter-search input {
    width: 100%;
    padding: 10px 12px 10px 36px;
    background: var(--admin-bg-input);
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius-sm);
    font-family: inherit;
    font-size: 14px;
  }
  .filter-search input:focus {
    outline: none;
    border-color: var(--admin-accent);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }
  .filters select {
    padding: 10px 12px;
    background: var(--admin-bg-input);
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius-sm);
    font-family: inherit;
    font-size: 14px;
    color: var(--admin-text);
    cursor: pointer;
  }

  .table-panel {
    overflow: hidden;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .data-table thead {
    background: var(--admin-bg);
    border-bottom: 1px solid var(--admin-border);
  }
  .data-table th {
    padding: 12px 14px;
    text-align: left;
    font-weight: 500;
    color: var(--admin-text-muted);
    font-size: 12px;
    letter-spacing: 0.3px;
  }
  .data-table th.numeric,
  .data-table td.numeric {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .data-table th.centered,
  .data-table td.centered {
    text-align: center;
  }
  .data-table tbody tr {
    border-bottom: 1px solid var(--admin-border);
    transition: background 0.1s;
  }
  .data-table tbody tr:last-child {
    border-bottom: none;
  }
  .data-table tbody tr:hover {
    background: var(--admin-bg);
  }
  .data-table tbody tr[data-hidden="true"] {
    display: none;
  }
  .data-table td {
    padding: 12px 14px;
    color: var(--admin-text);
  }
  .data-table td.muted {
    color: var(--admin-text-muted);
  }

  .cell-brand {
    font-size: 11px;
    color: var(--admin-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 2px;
  }
  .cell-name {
    font-weight: 500;
  }

  .stock-badge {
    display: inline-block;
    min-width: 26px;
    padding: 2px 10px;
    background: var(--admin-bg);
    border: 1px solid var(--admin-border);
    border-radius: 12px;
    font-size: 12px;
    color: var(--admin-text);
  }
  .stock-badge-low {
    background: #fef3c7;
    border-color: #fcd34d;
    color: #92400e;
  }
  .stock-badge-out {
    background: #fee2e2;
    border-color: #fca5a5;
    color: #991b1b;
  }

  .featured-mark {
    color: #d97706;
  }

  /* ── Toggle de destacado: estrella grande clickable ───────────── */
  .featured-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    color: var(--admin-text-faint);
    transition: color 0.15s, background 0.15s, transform 0.1s;
  }
  .featured-toggle:hover {
    background: rgba(217, 119, 6, 0.08);
    color: #d97706;
  }
  .featured-toggle:active {
    transform: scale(0.92);
  }
  .featured-toggle.is-featured {
    color: #d97706;
  }
  .featured-toggle.is-featured:hover {
    background: rgba(217, 119, 6, 0.12);
    color: #b45309;
  }

  .actions {
    text-align: right;
    white-space: nowrap;
  }
  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin-left: 2px;
    border: 1px solid transparent;
    border-radius: var(--admin-radius-sm);
    background: transparent;
    color: var(--admin-text-muted);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s;
  }
  .action-btn:hover {
    background: var(--admin-bg);
    border-color: var(--admin-border);
    color: var(--admin-text);
  }
  .action-btn-danger:hover {
    color: var(--admin-danger);
    border-color: #fca5a5;
    background: #fef2f2;
  }

  .empty-results {
    text-align: center;
    color: var(--admin-text-muted);
    padding: 32px 16px;
    font-style: italic;
  }

  .empty-state {
    padding: 48px 32px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  /* Modal */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 20px;
  }
  .modal-backdrop[aria-hidden="false"] {
    display: flex;
  }
  .modal {
    background: var(--admin-bg-panel);
    border-radius: var(--admin-radius-lg);
    padding: 24px;
    max-width: 440px;
    width: 100%;
    box-shadow: var(--admin-shadow-lg);
  }
  .modal h2 {
    margin-bottom: 8px;
  }
  .modal p {
    color: var(--admin-text-muted);
    margin-bottom: 20px;
  }
  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }

  /* ── Tabs de visibility (Todos / Visibles / Ocultos) ─────────── */
  .visibility-tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--admin-border);
  }
  .visibility-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    color: var(--admin-text-faint);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color 0.15s, border-color 0.15s;
  }
  .visibility-tab:hover {
    color: var(--admin-text);
  }
  .visibility-tab.is-active {
    color: var(--admin-text);
    border-bottom-color: var(--admin-accent);
  }
  .visibility-tab-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    padding: 2px 6px;
    background: var(--admin-bg-elevated);
    border-radius: 999px;
    font-size: 11px;
    color: var(--admin-text-faint);
  }
  .visibility-tab.is-active .visibility-tab-count {
    background: var(--admin-accent);
    color: var(--admin-bg);
    font-weight: 600;
  }
  .visibility-tab-star {
    color: var(--admin-warning, #d4a015);
    font-size: 13px;
    line-height: 1;
  }

  /* ── Fila oculta: opacity reducida + badge inline ────────────── */
  tr.row-hidden td {
    opacity: 0.55;
  }
  /* Excepción: las acciones siguen full opacity para poder operar */
  tr.row-hidden td.actions {
    opacity: 1;
  }

  /* ── Fila clickable: cursor pointer + hover sutil ────────────── */
  tr[data-row-href] {
    cursor: pointer;
  }
  tr[data-row-href]:hover {
    background: var(--admin-bg-hover, rgba(255, 255, 255, 0.03));
  }
  /* Los botones/forms dentro de actions mantienen su cursor propio */
  tr[data-row-href] .actions {
    cursor: default;
  }
  .hidden-badge {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 7px;
    background: rgba(160, 160, 160, 0.15);
    border: 1px solid rgba(160, 160, 160, 0.3);
    border-radius: 4px;
    font-size: 10px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--admin-text-faint);
    font-weight: 600;
    vertical-align: middle;
  }

