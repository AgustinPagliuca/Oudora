---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import { formatArs } from "@/lib/format";

const supabase = Astro.locals.supabase;

/**
 * Lee marcas y productos directo de Supabase (server-side).
 * Sin paginación todavía — con 40-100 productos rinde sin drama. Cuando
 * lleguemos a 600, agregamos cursor pagination.
 */
const [{ data: brandsData }, { data: productsData, error: productsError }] =
  await Promise.all([
    supabase.from("brands").select("id, slug, name, catalog").order("name"),
    supabase
      .from("products")
      .select(
        "id, slug, brand_id, catalog, name, gender, concentration, volume_ml, price_ars, stock, featured, notes",
      )
      .order("created_at", { ascending: false }),
  ]);

if (productsError !== null) {
  console.error("[admin/productos] Error leyendo productos:", productsError);
}

const brands = brandsData ?? [];
const products = productsData ?? [];

const brandsById = new Map(brands.map((b) => [b.id, b]));
const totalProducts = products.length;
const featuredCount = products.filter((p) => p.featured).length;

const flashCreated = Astro.url.searchParams.get("created") === "1";
const flashUpdated = Astro.url.searchParams.get("updated") === "1";
const flashDeleted = Astro.url.searchParams.get("deleted") === "1";
const flashMessage = flashCreated
  ? "Producto creado correctamente."
  : flashUpdated
    ? "Cambios guardados correctamente."
    : flashDeleted
      ? "Producto eliminado."
      : null;

const GENDER_LABEL: Record<string, string> = {
  femenino: "Fem.",
  masculino: "Masc.",
  unisex: "Unisex",
};

const CATALOG_LABEL: Record<string, string> = {
  arabe: "Árabe",
  disenador: "Diseñador",
};

function stockBadgeClass(stock: number): string {
  if (stock === 0) return "stock-badge stock-badge-out";
  if (stock <= 2) return "stock-badge stock-badge-low";
  return "stock-badge";
}
---

<AdminLayout title="Productos">
  <div class="page-header">
    <div>
      <p class="breadcrumb">
        <a href="/admin">Panel</a>
        <span aria-hidden="true">›</span>
        <span>Productos</span>
      </p>
      <h1>Productos</h1>
      <p class="page-subtitle">
        {totalProducts} fragancias · {featuredCount} destacadas
      </p>
    </div>
    <a href="/admin/productos/nuevo" class="btn btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="12" y1="5" x2="12" y2="19" />
        <line x1="5" y1="12" x2="19" y2="12" />
      </svg>
      Nuevo producto
    </a>
  </div>

  {flashMessage !== null && <div class="alert alert-success">{flashMessage}</div>}

  <div class="filters" data-product-filters>
    <div class="filter-search">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <line x1="16.5" y1="16.5" x2="21" y2="21" stroke-linecap="round" />
      </svg>
      <input
        type="search"
        placeholder="Buscar por marca, nombre o nota olfativa…"
        data-filter-q
        autocomplete="off"
      />
    </div>
    <select data-filter-catalog>
      <option value="">Todos los catálogos</option>
      <option value="arabe">Árabes</option>
      <option value="disenador">Diseñador</option>
    </select>
    <select data-filter-gender>
      <option value="">Todos los géneros</option>
      <option value="femenino">Femenino</option>
      <option value="masculino">Masculino</option>
      <option value="unisex">Unisex</option>
    </select>
  </div>

  {
    products.length === 0 ? (
      <div class="panel empty-state">
        <p>Todavía no hay productos cargados.</p>
        <a href="/admin/productos/nuevo" class="btn btn-primary">
          Crear el primero
        </a>
      </div>
    ) : (
      <div class="panel table-panel">
        <table class="data-table">
          <thead>
            <tr>
              <th>Producto</th>
              <th>Presentación</th>
              <th>Catálogo</th>
              <th>Género</th>
              <th class="numeric">Precio</th>
              <th class="centered">Stock</th>
              <th class="centered" aria-label="Destacado">★</th>
              <th />
            </tr>
          </thead>
          <tbody>
            {products.map((p) => {
              const brand = brandsById.get(p.brand_id);
              const notesText = Array.isArray(p.notes) ? p.notes.join(" ") : "";
              const searchText = `${brand?.name ?? ""} ${p.name} ${p.concentration ?? ""} ${notesText}`.toLowerCase();
              return (
                <tr
                  data-product-row
                  data-catalog={p.catalog}
                  data-gender={p.gender}
                  data-search-text={searchText}
                >
                  <td>
                    <p class="cell-brand">{brand?.name ?? "—"}</p>
                    <p class="cell-name">{p.name}</p>
                  </td>
                  <td class="muted">
                    {p.concentration} · {p.volume_ml} ml
                  </td>
                  <td class="muted">{CATALOG_LABEL[p.catalog] ?? p.catalog}</td>
                  <td class="muted">{GENDER_LABEL[p.gender] ?? p.gender}</td>
                  <td class="numeric">{formatArs(p.price_ars)}</td>
                  <td class="centered">
                    <span class={stockBadgeClass(p.stock)}>{p.stock}</span>
                  </td>
                  <td class="centered">
                    {p.featured ? <span class="featured-mark">★</span> : <span class="muted">—</span>}
                  </td>
                  <td class="actions">
                    <a
                      href={`/admin/productos/${p.id}`}
                      class="action-btn"
                      aria-label={`Editar ${p.name}`}
                      title="Editar"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                      </svg>
                    </a>
                    <button
                      type="button"
                      class="action-btn action-btn-danger"
                      data-delete-trigger
                      data-product-id={p.id}
                      data-product-name={`${brand?.name ?? ""} ${p.name}`.trim()}
                      aria-label={`Borrar ${p.name}`}
                      title="Borrar"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <polyline points="3 6 5 6 21 6" stroke-linecap="round" />
                        <path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                      </svg>
                    </button>
                  </td>
                </tr>
              );
            })}
            <tr data-empty-row hidden>
              <td colspan="8" class="empty-results">
                No se encontraron productos con esos filtros.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    )
  }

  <!-- Modal de confirmación de borrado -->
  <div class="modal-backdrop" data-delete-modal aria-hidden="true">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
      <h2 id="delete-modal-title">Borrar producto</h2>
      <p>
        Estás por borrar <strong data-delete-product-name>—</strong>. Esta
        acción no se puede deshacer.
      </p>
      <form method="POST" data-delete-form>
        <input type="hidden" name="_method" value="DELETE" />
        <div class="modal-actions">
          <button type="button" class="btn btn-ghost" data-delete-cancel>
            Cancelar
          </button>
          <button type="submit" class="btn btn-danger">Borrar producto</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { initProductListController } from "@/scripts/admin/product-list-controller";
    initProductListController();
  </script>
</AdminLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 24px;
  }

  .breadcrumb {
    font-size: 14px;
    color: var(--admin-text-muted);
    margin-bottom: 4px;
  }
  .breadcrumb a {
    color: var(--admin-accent);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb span[aria-hidden] {
    margin: 0 6px;
    color: var(--admin-text-faint);
  }

  .page-subtitle {
    color: var(--admin-text-muted);
    font-size: 14px;
    margin-top: 4px;
  }

  .alert {
    padding: 12px 16px;
    border-radius: var(--admin-radius-sm);
    font-size: 14px;
    margin-bottom: 16px;
  }
  .alert-success {
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  .filters {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 10px;
    margin-bottom: 16px;
  }
  @media (max-width: 720px) {
    .filters {
      grid-template-columns: 1fr;
    }
  }

  .filter-search {
    position: relative;
  }
  .filter-search svg {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--admin-text-faint);
  }
  .filter-search input {
    width: 100%;
    padding: 10px 12px 10px 36px;
    background: var(--admin-bg-input);
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius-sm);
    font-family: inherit;
    font-size: 14px;
  }
  .filter-search input:focus {
    outline: none;
    border-color: var(--admin-accent);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }
  .filters select {
    padding: 10px 12px;
    background: var(--admin-bg-input);
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius-sm);
    font-family: inherit;
    font-size: 14px;
    color: var(--admin-text);
    cursor: pointer;
  }

  .table-panel {
    overflow: hidden;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .data-table thead {
    background: var(--admin-bg);
    border-bottom: 1px solid var(--admin-border);
  }
  .data-table th {
    padding: 12px 14px;
    text-align: left;
    font-weight: 500;
    color: var(--admin-text-muted);
    font-size: 12px;
    letter-spacing: 0.3px;
  }
  .data-table th.numeric,
  .data-table td.numeric {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .data-table th.centered,
  .data-table td.centered {
    text-align: center;
  }
  .data-table tbody tr {
    border-bottom: 1px solid var(--admin-border);
    transition: background 0.1s;
  }
  .data-table tbody tr:last-child {
    border-bottom: none;
  }
  .data-table tbody tr:hover {
    background: var(--admin-bg);
  }
  .data-table tbody tr[data-hidden="true"] {
    display: none;
  }
  .data-table td {
    padding: 12px 14px;
    color: var(--admin-text);
  }
  .data-table td.muted {
    color: var(--admin-text-muted);
  }

  .cell-brand {
    font-size: 11px;
    color: var(--admin-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 2px;
  }
  .cell-name {
    font-weight: 500;
  }

  .stock-badge {
    display: inline-block;
    min-width: 26px;
    padding: 2px 10px;
    background: var(--admin-bg);
    border: 1px solid var(--admin-border);
    border-radius: 12px;
    font-size: 12px;
    color: var(--admin-text);
  }
  .stock-badge-low {
    background: #fef3c7;
    border-color: #fcd34d;
    color: #92400e;
  }
  .stock-badge-out {
    background: #fee2e2;
    border-color: #fca5a5;
    color: #991b1b;
  }

  .featured-mark {
    color: #d97706;
  }

  .actions {
    text-align: right;
    white-space: nowrap;
  }
  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin-left: 2px;
    border: 1px solid transparent;
    border-radius: var(--admin-radius-sm);
    background: transparent;
    color: var(--admin-text-muted);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s;
  }
  .action-btn:hover {
    background: var(--admin-bg);
    border-color: var(--admin-border);
    color: var(--admin-text);
  }
  .action-btn-danger:hover {
    color: var(--admin-danger);
    border-color: #fca5a5;
    background: #fef2f2;
  }

  .empty-results {
    text-align: center;
    color: var(--admin-text-muted);
    padding: 32px 16px;
    font-style: italic;
  }

  .empty-state {
    padding: 48px 32px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  /* Modal */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 20px;
  }
  .modal-backdrop[aria-hidden="false"] {
    display: flex;
  }
  .modal {
    background: var(--admin-bg-panel);
    border-radius: var(--admin-radius-lg);
    padding: 24px;
    max-width: 440px;
    width: 100%;
    box-shadow: var(--admin-shadow-lg);
  }
  .modal h2 {
    margin-bottom: 8px;
  }
  .modal p {
    color: var(--admin-text-muted);
    margin-bottom: 20px;
  }
  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }
</style>
