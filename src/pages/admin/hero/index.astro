---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";

const supabase = Astro.locals.supabase;

const { data: slidesData } = await supabase
  .from("hero_slides")
  .select("id, title, subtitle, overline, image_url, cta_label, published, sort_order, created_at")
  .order("sort_order")
  .order("created_at", { ascending: false });

const slides = slidesData ?? [];
const publishedCount = slides.filter((s) => s.published).length;

const flashCreated = Astro.url.searchParams.get("created") === "1";
const flashUpdated = Astro.url.searchParams.get("updated") === "1";
const flashDeleted = Astro.url.searchParams.get("deleted") === "1";
const flashMessage = flashCreated
  ? "Slide creado correctamente."
  : flashUpdated
    ? "Cambios guardados correctamente."
    : flashDeleted
      ? "Slide eliminado."
      : null;
---

<AdminLayout title="Hero">
  <div class="page-header">
    <div>
      <p class="breadcrumb">
        <a href="/admin">Panel</a>
        <span aria-hidden="true">›</span>
        <span>Hero</span>
      </p>
      <h1>Hero del home</h1>
      <p class="page-subtitle">
        {slides.length} slides{publishedCount > 0 && ` · ${publishedCount} publicados`}
      </p>
    </div>
    <a href="/admin/hero/nuevo" class="btn btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="12" y1="5" x2="12" y2="19" />
        <line x1="5" y1="12" x2="19" y2="12" />
      </svg>
      Nuevo slide
    </a>
  </div>

  {flashMessage !== null && <div class="alert alert-success">{flashMessage}</div>}

  {slides.length === 0 ? (
    <div class="panel empty-state">
      <p>Todavía no hay slides cargados.</p>
      <p class="empty-hint">
        Mientras no haya slides, la home muestra el hero estático actual con el frasco SVG. Apenas cargues uno, el carrusel toma el control.
      </p>
      <a href="/admin/hero/nuevo" class="btn btn-primary">Cargar el primero</a>
    </div>
  ) : (
    <div class="slides-list">
      {slides.map((s) => (
        <a href={`/admin/hero/${s.id}`} class="slide-card">
          <div class="slide-thumb-wrap">
            <img src={s.image_url} alt={s.title} class="slide-thumb" loading="lazy" />
            {!s.published && <span class="slide-draft-badge">Borrador</span>}
          </div>
          <div class="slide-info">
            {s.overline && <p class="slide-overline">{s.overline}</p>}
            <p class="slide-title">{s.title}</p>
            {s.subtitle && <p class="slide-subtitle">{s.subtitle}</p>}
            <div class="slide-meta">
              {s.cta_label && <span class="slide-cta-badge">→ {s.cta_label}</span>}
              <span class="slide-sort">Orden {s.sort_order}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  )}
</AdminLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 24px;
  }
  .breadcrumb { font-size: 14px; color: var(--admin-text-muted); margin-bottom: 4px; }
  .breadcrumb a { color: var(--admin-accent); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb span[aria-hidden] { margin: 0 6px; color: var(--admin-text-faint); }
  .page-subtitle { color: var(--admin-text-muted); font-size: 14px; margin-top: 4px; }

  .alert {
    padding: 12px 16px;
    border-radius: var(--admin-radius-sm);
    font-size: 14px;
    margin-bottom: 16px;
  }
  .alert-success { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }

  .empty-state {
    padding: 48px 32px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .empty-hint {
    font-size: 13px;
    color: var(--admin-text-muted);
    max-width: 480px;
  }

  .slides-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .slide-card {
    display: flex;
    gap: 16px;
    background: var(--admin-bg-panel);
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius-md);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: all 0.15s;
  }
  .slide-card:hover {
    border-color: var(--admin-accent);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
    text-decoration: none;
  }
  .slide-thumb-wrap {
    position: relative;
    width: 200px;
    flex-shrink: 0;
    background: var(--admin-bg);
  }
  .slide-thumb {
    width: 100%;
    height: 100%;
    min-height: 110px;
    object-fit: cover;
    display: block;
  }
  .slide-draft-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: rgba(0, 0, 0, 0.75);
    color: #fbbf24;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 4px;
  }
  .slide-info {
    flex: 1;
    padding: 16px 16px 16px 0;
    min-width: 0;
  }
  .slide-overline {
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--admin-text-muted);
    margin-bottom: 4px;
  }
  .slide-title {
    font-size: 16px;
    font-weight: 500;
    color: var(--admin-text);
    margin-bottom: 4px;
  }
  .slide-subtitle {
    font-size: 13px;
    color: var(--admin-text-muted);
    line-height: 1.5;
    margin-bottom: 10px;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .slide-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    margin-top: 8px;
  }
  .slide-cta-badge {
    background: rgba(37, 99, 235, 0.08);
    color: var(--admin-accent);
    padding: 3px 8px;
    border-radius: 4px;
    font-weight: 500;
  }
  .slide-sort { color: var(--admin-text-faint); }

  @media (max-width: 600px) {
    .slide-card { flex-direction: column; }
    .slide-thumb-wrap { width: 100%; height: 140px; }
    .slide-info { padding: 14px; }
  }
</style>
