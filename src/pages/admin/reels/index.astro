---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";

const supabase = Astro.locals.supabase;

const { data: reelsData } = await supabase
  .from("reels")
  .select("id, title, thumbnail_url, instagram_url, duration, published, sort_order, created_at")
  .order("sort_order")
  .order("created_at", { ascending: false });

const reels = reelsData ?? [];

const total = reels.length;
const publishedCount = reels.filter((r) => r.published).length;

const flashCreated = Astro.url.searchParams.get("created") === "1";
const flashUpdated = Astro.url.searchParams.get("updated") === "1";
const flashDeleted = Astro.url.searchParams.get("deleted") === "1";
const flashMessage = flashCreated
  ? "Reel creado correctamente."
  : flashUpdated
    ? "Cambios guardados correctamente."
    : flashDeleted
      ? "Reel eliminado."
      : null;
---

<AdminLayout title="Reels">
  <div class="page-header">
    <div>
      <p class="breadcrumb">
        <a href="/admin">Panel</a>
        <span aria-hidden="true">›</span>
        <span>Reels</span>
      </p>
      <h1>Reels</h1>
      <p class="page-subtitle">
        {total} reels{publishedCount > 0 && ` · ${publishedCount} publicados`}
      </p>
    </div>
    <a href="/admin/reels/nuevo" class="btn btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="12" y1="5" x2="12" y2="19" />
        <line x1="5" y1="12" x2="19" y2="12" />
      </svg>
      Nuevo reel
    </a>
  </div>

  {flashMessage !== null && <div class="alert alert-success">{flashMessage}</div>}

  {reels.length === 0 ? (
    <div class="panel empty-state">
      <p>Todavía no hay reels cargados.</p>
      <p class="empty-hint">
        Los reels aparecen en la página "Nosotros". Subí una imagen de portada y el link al reel de Instagram.
      </p>
      <a href="/admin/reels/nuevo" class="btn btn-primary">Cargar el primero</a>
    </div>
  ) : (
    <div class="reels-grid">
      {reels.map((r) => (
        <a href={`/admin/reels/${r.id}`} class="reel-card">
          <div class="reel-thumb-wrap">
            <img src={r.thumbnail_url} alt={r.title} class="reel-thumb" loading="lazy" />
            <div class="reel-play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                <polygon points="5,3 19,12 5,21" />
              </svg>
            </div>
            {!r.published && <span class="reel-draft-badge">Borrador</span>}
          </div>
          <div class="reel-meta">
            <p class="reel-title">{r.title}</p>
            {r.duration && <p class="reel-duration">{r.duration}</p>}
            <p class="reel-sort">Orden {r.sort_order}</p>
          </div>
        </a>
      ))}
    </div>
  )}
</AdminLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 24px;
  }
  .breadcrumb {
    font-size: 14px;
    color: var(--admin-text-muted);
    margin-bottom: 4px;
  }
  .breadcrumb a {
    color: var(--admin-accent);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb span[aria-hidden] {
    margin: 0 6px;
    color: var(--admin-text-faint);
  }
  .page-subtitle {
    color: var(--admin-text-muted);
    font-size: 14px;
    margin-top: 4px;
  }

  .alert {
    padding: 12px 16px;
    border-radius: var(--admin-radius-sm);
    font-size: 14px;
    margin-bottom: 16px;
  }
  .alert-success {
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  .empty-state {
    padding: 48px 32px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .empty-hint {
    font-size: 13px;
    color: var(--admin-text-muted);
    max-width: 380px;
  }

  .reels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 14px;
  }
  .reel-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .reel-thumb-wrap {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: var(--admin-radius-md);
    overflow: hidden;
    background: var(--admin-bg);
    border: 1px solid var(--admin-border);
    transition: border-color 0.15s, transform 0.15s;
  }
  .reel-card:hover .reel-thumb-wrap {
    border-color: var(--admin-accent);
    transform: translateY(-2px);
  }
  .reel-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .reel-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 3px;
    transition: background 0.15s;
  }
  .reel-card:hover .reel-play {
    background: rgba(0, 0, 0, 0.7);
  }
  .reel-draft-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: rgba(0, 0, 0, 0.75);
    color: #fbbf24;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 4px;
  }
  .reel-meta {
    padding: 0 2px;
  }
  .reel-title {
    font-weight: 500;
    font-size: 14px;
    margin-bottom: 2px;
  }
  .reel-duration {
    font-size: 11px;
    color: var(--admin-text-muted);
    letter-spacing: 0.5px;
  }
  .reel-sort {
    font-size: 11px;
    color: var(--admin-text-faint);
    margin-top: 2px;
  }
</style>
