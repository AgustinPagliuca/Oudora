---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";

const supabase = Astro.locals.supabase;

const { data: reviewsData } = await supabase
  .from("reviews")
  .select("id, author_name, body, rating, featured, published, sort_order, created_at")
  .order("sort_order")
  .order("created_at", { ascending: false });

const reviews = reviewsData ?? [];

const total = reviews.length;
const publishedCount = reviews.filter((r) => r.published).length;

const flashCreated = Astro.url.searchParams.get("created") === "1";
const flashUpdated = Astro.url.searchParams.get("updated") === "1";
const flashDeleted = Astro.url.searchParams.get("deleted") === "1";
const flashMessage = flashCreated
  ? "Reseña creada correctamente."
  : flashUpdated
    ? "Cambios guardados correctamente."
    : flashDeleted
      ? "Reseña eliminada."
      : null;

function truncate(s: string, max = 110): string {
  if (s.length <= max) return s;
  return s.slice(0, max - 1).trim() + "…";
}
---

<AdminLayout title="Reseñas">
  <div class="page-header">
    <div>
      <p class="breadcrumb">
        <a href="/admin">Panel</a>
        <span aria-hidden="true">›</span>
        <span>Reseñas</span>
      </p>
      <h1>Reseñas</h1>
      <p class="page-subtitle">
        {total} reseñas{publishedCount > 0 && ` · ${publishedCount} publicadas`}
      </p>
    </div>
    <a href="/admin/resenas/nueva" class="btn btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="12" y1="5" x2="12" y2="19" />
        <line x1="5" y1="12" x2="19" y2="12" />
      </svg>
      Nueva reseña
    </a>
  </div>

  {flashMessage !== null && <div class="alert alert-success">{flashMessage}</div>}

  {reviews.length === 0 ? (
    <div class="panel empty-state">
      <p>Todavía no hay reseñas cargadas.</p>
      <a href="/admin/resenas/nueva" class="btn btn-primary">Cargar la primera</a>
    </div>
  ) : (
    <div class="reviews-grid">
      {reviews.map((r) => (
        <a href={`/admin/resenas/${r.id}`} class="review-card">
          <div class="review-card-head">
            <span class="review-card-author">{r.author_name}</span>
            <div class="review-card-badges">
              {r.published ? (
                <span class="badge badge-published">Publicada</span>
              ) : (
                <span class="badge badge-draft">Borrador</span>
              )}
              {r.featured && <span class="badge badge-featured">Destacada</span>}
            </div>
          </div>
          {r.rating !== null && (
            <div class="review-card-stars">
              {"★".repeat(r.rating)}{"☆".repeat(5 - r.rating)}
            </div>
          )}
          <p class="review-card-body">{truncate(r.body)}</p>
          <p class="review-card-meta">Orden {r.sort_order}</p>
        </a>
      ))}
    </div>
  )}
</AdminLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 24px;
  }
  .breadcrumb {
    font-size: 14px;
    color: var(--admin-text-muted);
    margin-bottom: 4px;
  }
  .breadcrumb a {
    color: var(--admin-accent);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb span[aria-hidden] {
    margin: 0 6px;
    color: var(--admin-text-faint);
  }
  .page-subtitle {
    color: var(--admin-text-muted);
    font-size: 14px;
    margin-top: 4px;
  }

  .alert {
    padding: 12px 16px;
    border-radius: var(--admin-radius-sm);
    font-size: 14px;
    margin-bottom: 16px;
  }
  .alert-success {
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  .empty-state {
    padding: 48px 32px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 12px;
  }
  .review-card {
    display: block;
    background: var(--admin-bg-panel);
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius-md);
    padding: 16px;
    text-decoration: none;
    color: inherit;
    transition: all 0.15s;
  }
  .review-card:hover {
    border-color: var(--admin-accent);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
    text-decoration: none;
  }
  .review-card-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 6px;
  }
  .review-card-author {
    font-weight: 600;
    font-size: 14px;
    color: var(--admin-text);
  }
  .review-card-badges {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
  }
  .badge {
    font-size: 10px;
    font-weight: 500;
    padding: 2px 8px;
    border-radius: 10px;
    letter-spacing: 0.3px;
  }
  .badge-published {
    background: #ecfdf5;
    color: #047857;
    border: 1px solid #a7f3d0;
  }
  .badge-draft {
    background: var(--admin-bg);
    color: var(--admin-text-muted);
    border: 1px solid var(--admin-border);
  }
  .badge-featured {
    background: #fef3c7;
    color: #92400e;
    border: 1px solid #fde68a;
  }
  .review-card-stars {
    color: #f59e0b;
    font-size: 14px;
    letter-spacing: 1px;
    margin-bottom: 8px;
  }
  .review-card-body {
    font-size: 13px;
    color: var(--admin-text);
    line-height: 1.55;
    margin-bottom: 10px;
  }
  .review-card-meta {
    font-size: 11px;
    color: var(--admin-text-faint);
    letter-spacing: 0.3px;
  }
</style>
