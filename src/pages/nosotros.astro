---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import { REELS } from "@/data/catalog.generated";
import { CONTACT } from "@/constants/ui";
---

<Layout title="Nosotros">
  <Nav />

  <div class="surface-light">
    <section class="about-story">
      <div class="about-story-text">
        <nav class="about-crumbs" aria-label="Migas de navegación">
          <a href="/">Inicio</a> · <span aria-current="page">Nosotros</span>
        </nav>
        <h1 class="about-story-title">L'essence d'arabie</h1>
        <p>
          OUDORA nace de la pasión por las fragancias árabes de tradición milenaria.
          Seleccionamos cada perfume directamente de las casas más prestigiosas del
          mundo árabe, garantizando autenticidad en cada gota.
        </p>
        <p>
          Más que vender perfumes, ofrecemos una experiencia: la oportunidad de
          descubrir aromas que cuentan historias, evocan paisajes y se convierten
          en memoria.
        </p>
      </div>
      <img
        class="about-story-img"
        src="/collections/femenino.jpg"
        alt=""
        width="800"
        height="1000"
        fetchpriority="high"
      />
    </section>

    <section class="about-values" aria-label="Lo que nos define">
      <div class="about-values-inner">
        <div class="about-value">
          <span class="about-value-icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z" /><path d="M9 12l2 2 4-4" />
            </svg>
          </span>
          <h2>Autenticidad</h2>
          <p>Cada fragancia es importada directo de su casa de origen.</p>
        </div>
        <div class="about-value">
          <span class="about-value-icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" />
            </svg>
          </span>
          <h2>Asesoría personalizada</h2>
          <p>Te ayudamos a elegir el perfume ideal para vos.</p>
        </div>
        <div class="about-value">
          <span class="about-value-icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13" /><polygon points="16 8 20 8 23 11 23 16 16 16 16 8" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" />
            </svg>
          </span>
          <h2>Envíos a todo el país</h2>
          <p>Llegamos a cualquier punto de Argentina.</p>
        </div>
      </div>
    </section>

    {REELS.length > 0 && (
      <section class="about-reels-section" aria-labelledby="about-reels-title">
        <div class="about-reels-head">
          <div>
            <h2 class="about-reels-title" id="about-reels-title">Nuestra historia en video</h2>
            <p class="about-reels-lead">Recomendaciones, novedades y lo que pasa detrás de OUDORA.</p>
          </div>
          <div class="about-social-row">
            <a href={CONTACT.instagramUrl} class="about-social-btn" target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" /></svg>
              Instagram
            </a>
            <a href={CONTACT.tiktokUrl} class="about-social-btn" target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5" /><path d="M14 3c.5 2.8 2.4 4.5 5 4.8" /></svg>
              TikTok
            </a>
          </div>
        </div>
        <div class="about-reels-grid">
          {REELS.map((reel) => (
            <a
              href={reel.instagramUrl}
              class="about-reel"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ver reel "${reel.title}" en Instagram`}
            >
              <span class="about-reel-media">
                <img src={reel.thumbnailUrl} alt="" class="about-reel-thumb" loading="lazy" />
                <span class="about-reel-play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><polygon points="7,4 20,12 7,20" /></svg>
                </span>
                <span class="about-reel-hint" aria-hidden="true">Ver en Instagram</span>
              </span>
              <span class="about-reel-title">{reel.title}</span>
              {reel.duration && <span class="about-reel-duration">{reel.duration}</span>}
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <Footer />
</Layout>

<style>
  .about-story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-8);
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: var(--space-7) clamp(16px, 4vw, 32px) var(--space-8);
  }
  .about-crumbs {
    margin-bottom: var(--space-4);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .about-crumbs a:hover {
    color: var(--color-gold-ink);
  }
  .about-crumbs [aria-current] {
    color: var(--color-ink);
  }
  .about-story-title {
    margin-bottom: var(--space-5);
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 400;
    line-height: 1.05;
    color: var(--color-ink);
  }
  .about-story-text p {
    margin-bottom: var(--space-4);
    max-width: 52ch;
    font-size: var(--text-md);
    line-height: 1.7;
    color: var(--color-ink-muted);
    text-wrap: pretty;
  }
  .about-story-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .about-values {
    background: #ffffff;
  }
  .about-values-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-7);
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: var(--space-8) clamp(16px, 4vw, 32px);
  }
  .about-value {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }
  .about-value-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-bottom: var(--space-2);
    border: 1px solid rgba(26, 23, 18, 0.25);
    border-radius: var(--radius-circle);
    color: var(--color-ink);
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }
  .about-value:hover .about-value-icon {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-surface-light);
  }
  .about-value h2 {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 400;
    color: var(--color-ink);
  }
  .about-value p {
    max-width: 30ch;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .about-reels-section {
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: var(--space-8) clamp(16px, 4vw, 32px);
  }
  .about-reels-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }
  .about-reels-title {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 400;
    color: var(--color-ink);
  }
  .about-reels-lead {
    margin-top: var(--space-2);
    color: var(--color-ink-muted);
  }
  .about-social-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .about-social-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 48px;
    padding: 0 var(--space-5);
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }
  .about-social-btn:hover {
    background: var(--color-ink);
    color: var(--color-surface-light);
  }

  .about-reels-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .about-reel {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .about-reel:focus-visible {
    outline: 2px solid var(--color-gold-ink);
    outline-offset: 4px;
  }
  .about-reel-media {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--color-ink);
  }
  .about-reel-thumb {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.4s ease;
  }
  .about-reel-play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-circle);
    background: var(--color-surface-light);
    color: var(--color-ink);
    transform: translate(-50%, -50%);
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), background-color 0.3s ease;
  }
  .about-reel-hint {
    position: absolute;
    inset: auto 0 0;
    padding: var(--space-4);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    text-align: center;
    color: var(--color-surface-light);
    opacity: 0;
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.3s ease;
  }
  .about-reel-title {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.3;
    color: var(--color-ink);
    transition: color var(--transition-fast);
  }
  .about-reel-duration {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .about-reel:hover .about-reel-title,
  .about-reel:focus-visible .about-reel-title {
    color: var(--color-gold-ink);
  }
  .about-reel:hover .about-reel-thumb,
  .about-reel:focus-visible .about-reel-thumb {
    filter: brightness(0.8);
  }
  .about-reel:hover .about-reel-play,
  .about-reel:focus-visible .about-reel-play {
    background: var(--color-gold);
  }
  .about-reel:hover .about-reel-hint,
  .about-reel:focus-visible .about-reel-hint {
    opacity: 1;
    transform: none;
  }

  /* Movimiento solo si la persona no pidió reducirlo. */
  @media (prefers-reduced-motion: no-preference) {
    .about-reel:hover {
      transform: translateY(-8px);
    }
    .about-reel:hover .about-reel-thumb {
      transform: scale(1.07);
    }
    .about-reel:hover .about-reel-play {
      transform: translate(-50%, -50%) scale(1.25);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .about-reel-hint {
      transition: none;
    }
  }

  @media (max-width: 860px) {
    .about-story {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-top: var(--space-6);
    }
    .about-story-img {
      order: -1;
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 640px) {
    .about-reels-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4) var(--space-3);
    }
    .about-reel-title {
      font-size: var(--text-md);
    }
  }
</style>
