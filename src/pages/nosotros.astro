---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import PageHeader from "@/components/PageHeader.astro";
import { REELS } from "@/data/catalog.generated";
import { CONTACT, SITE_METADATA } from "@/constants/ui";
---

<Layout title={`Nosotros · ${SITE_METADATA.name}`}>
  <Nav />

  <div class="surface-light">
    <PageHeader
      title="Nosotros"
      subtitle="Perfumería árabe y de diseñador desde Buenos Aires"
      breadcrumbsTrail={[{ label: "Inicio", href: "/" }, { label: "Nosotros" }]}
    />

    <section class="about-story">
      <h2 class="about-story-title">L'essence d'arabie</h2>
      <p>
        OUDORA nace de la pasión por las fragancias árabes de tradición milenaria.
        Seleccionamos cada perfume directamente de las casas más prestigiosas del
        mundo árabe, garantizando autenticidad en cada gota.
      </p>
      <p>
        Más que vender perfumes, ofrecemos una experiencia: la oportunidad de
        descubrir aromas que cuentan historias, evocan paisajes y se convierten
        en memoria.
      </p>
    </section>

    <section class="about-values" aria-label="Lo que nos define">
      <div class="about-value">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 2h6v6h-2l2 4h-3v6l-1 4-1-4v-6H7l2-4H7V2z" />
        </svg>
        <h3>Autenticidad</h3>
        <p>Cada fragancia es importada directo de su casa de origen.</p>
      </div>
      <div class="about-value">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <h3>Asesoría personalizada</h3>
        <p>Te ayudamos a elegir el perfume ideal para vos.</p>
      </div>
      <div class="about-value">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="1" y="3" width="15" height="13" />
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8" />
          <circle cx="5.5" cy="18.5" r="2.5" />
          <circle cx="18.5" cy="18.5" r="2.5" />
        </svg>
        <h3>Envíos a todo el país</h3>
        <p>Llegamos a cualquier punto de Argentina.</p>
      </div>
    </section>
  </div>

  {REELS.length > 0 && (
    <section class="about-reels-section" aria-labelledby="about-reels-title">
      <h2 class="about-reels-title" id="about-reels-title">Nuestra historia en video</h2>
      <div class="about-reels-grid">
        {REELS.map((reel) => (
          <a
            href={reel.instagramUrl}
            class="about-reel"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver reel "${reel.title}" en Instagram`}
          >
            <span class="about-reel-media">
              <img src={reel.thumbnailUrl} alt="" class="about-reel-thumb" loading="lazy" />
              <span class="about-reel-play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                  <polygon points="6,4 20,12 6,20" />
                </svg>
              </span>
            </span>
            <span class="about-reel-title">{reel.title}</span>
            {reel.duration && <span class="about-reel-duration">{reel.duration}</span>}
          </a>
        ))}
      </div>

      <div class="about-social-row">
        <a href={CONTACT.instagramUrl} class="about-social-btn" target="_blank" rel="noopener noreferrer">
          Ver más en Instagram
        </a>
        <a href={CONTACT.tiktokUrl} class="about-social-btn" target="_blank" rel="noopener noreferrer">
          Ver más en TikTok
        </a>
      </div>
    </section>
  )}

  <Footer />
</Layout>

<style>
  /* Historia y valores sobre crema; los reels en una franja oscura.
     Sin cajas ni velos sobre las miniaturas: el texto va debajo. */
  .about-story {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-6) clamp(16px, 4vw, 32px) var(--space-7);
    text-align: center;
  }
  .about-story-title {
    margin-bottom: var(--space-5);
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 400;
    line-height: 1.1;
    color: var(--color-ink);
  }
  .about-story p {
    margin: 0 auto var(--space-4);
    max-width: 60ch;
    font-size: var(--text-md);
    line-height: 1.7;
    color: var(--color-ink-muted);
    text-wrap: pretty;
  }

  .about-values {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-6);
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: var(--space-6) clamp(16px, 4vw, 32px) var(--space-8);
    border-top: 1px solid rgba(26, 23, 18, 0.15);
  }
  .about-value {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
    color: var(--color-ink);
  }
  .about-value h3 {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .about-value p {
    max-width: 30ch;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .about-reels-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-8) clamp(16px, 4vw, 32px);
  }
  .about-reels-title {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 400;
    color: var(--color-cream);
    text-align: center;
  }
  .about-reels-grid {
    display: grid;
    /* Pocas miniaturas: columnas de ancho fijo y centradas. */
    grid-template-columns: repeat(auto-fit, minmax(200px, 260px));
    justify-content: center;
    gap: var(--space-4);
    width: 100%;
    max-width: var(--max-content-width);
  }
  .about-reel {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .about-reel-media {
    position: relative;
    display: block;
  }
  .about-reel-thumb {
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    background: var(--color-bg-elevated);
  }
  .about-reel-play {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-circle);
    background: var(--color-cream);
    color: var(--color-bg);
  }
  .about-reel-title {
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--color-cream);
    transition: color var(--transition-fast);
  }
  .about-reel:hover .about-reel-title {
    color: var(--color-gold-light);
  }
  .about-reel-duration {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .about-social-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
  .about-social-btn {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--space-6);
    border: 1px solid var(--color-text-muted);
    color: var(--color-cream);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }
  .about-social-btn:hover {
    background: var(--color-cream);
    color: var(--color-bg);
  }

  @media (max-width: 640px) {
    .about-reels-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
