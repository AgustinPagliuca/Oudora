---
import "@/styles/global.css";
import { SITE_METADATA } from "@/constants/ui";
import CartDrawer from "@/components/CartDrawer.astro";
import SearchOverlay from "@/components/SearchOverlay.astro";
import AnnouncementBar from "@/components/AnnouncementBar.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import CookieConsent from "@/components/CookieConsent.astro";
import GoogleTagManager from "@/components/GoogleTagManager.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title
  ? `${title} · ${SITE_METADATA.name}`
  : `${SITE_METADATA.name} · ${SITE_METADATA.tagline}`;
const pageDescription = description ?? SITE_METADATA.description;
---

<!doctype html>
<html lang="es">
  <head>
    {/* Define el loader de GTM y lo dispara solo si ya hay consentimiento
        guardado. Sigue primero en el <head> para no demorar el contenedor
        en quienes ya aceptaron. */}
    <GoogleTagManager />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0908" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    {/* Sin el <noscript> de GTM a propósito: ese iframe carga el contenedor sin
        pasar por el consentimiento, y sin JS no hay forma de leer la decisión
        ni de mostrar el banner. Preferimos no medir a esa minoría. */}
    <AnnouncementBar />
    <slot />
    <CartDrawer />
    <SearchOverlay />
    <WhatsAppButton />
    <CookieConsent />

    <script>
      import { initCartController } from "@/scripts/cart-controller";
      import { initSearchController } from "@/scripts/search-controller";
      import { initScrollReveal } from "@/scripts/scroll-reveal";
      import { initCookieConsent } from "@/scripts/cookie-consent";

      function bootGlobal(): void {
        initCartController();
        initSearchController();
        initScrollReveal();
        initCookieConsent();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", bootGlobal, { once: true });
      } else {
        bootGlobal();
      }
    </script>
  </body>
</html>
