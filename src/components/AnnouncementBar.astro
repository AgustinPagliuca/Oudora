---
/**
 * Barra de avisos rotativos arriba del nav (estilo editorial: fina, negra,
 * texto crema en minúscula, íconos de línea en vez de emojis).
 * - Varios avisos: rotan cada 5 s con un fundido. Se pausan al pasar el
 *   mouse o enfocar la barra, y no rotan solos con "reducir movimiento".
 * - Uno solo: queda fijo. Ninguno: no se renderiza.
 */

import { ANNOUNCEMENTS } from "@/data/catalog.generated";
import type { AnnouncementIcon } from "@/types/catalog";

const items = ANNOUNCEMENTS;
const hasMany = items.length > 1;

/** Trazos de íconos de línea (viewBox 24×24, stroke currentColor). */
const ICON_PATHS: Record<AnnouncementIcon, string> = {
  "truck": "M3 7h11v9H3zM14 10h4l3 3v3h-7M7 19a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM17 19a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z",
  "gift": "M4 11h16v9H4zM3 7h18v4H3zM12 7v13M12 7c-1.5-3-5-3-5-1s3 1 5 1c2 0 5 1 5-1s-3.5-2-5 1Z",
  "percent": "M19 5 5 19M7 9a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM17 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z",
  "credit-card": "M3 6h18v12H3zM3 10h18",
  "star": "m12 4 2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.6-4.8 2.6.9-5.4L4.2 9.7l5.4-.8Z",
  "clock": "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM12 7v5l3 2",
  "map-pin": "M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11ZM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z",
};
---

{items.length > 0 && (
  <div
    class="announcement-bar"
    data-announcement-bar
    data-count={items.length}
    role="region"
    aria-label="Avisos"
  >
    <div class="announcement-track">
      {items.map((a, idx) => (
        <p class="announcement-slide" data-slide={idx} data-active={idx === 0 ? "true" : "false"}>
          {a.icon && (
            <svg
              class="announcement-icon"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={ICON_PATHS[a.icon]} />
            </svg>
          )}
          <span>{a.text}</span>
        </p>
      ))}
    </div>
  </div>
)}

{hasMany && (
  <script>
    function initAnnouncements(): void {
      const bar = document.querySelector<HTMLElement>("[data-announcement-bar]");
      if (bar === null) return;
      const slides = bar.querySelectorAll<HTMLElement>("[data-slide]");
      if (slides.length <= 1) return;

      const AUTO_INTERVAL = 5000;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let currentIndex = 0;
      let autoTimer: number | null = null;

      function show(index: number): void {
        slides.forEach((s, i) => {
          s.dataset.active = i === index ? "true" : "false";
        });
        currentIndex = index;
      }
      function next(): void {
        show((currentIndex + 1) % slides.length);
      }
      function startAuto(): void {
        if (autoTimer !== null || reducedMotion) return;
        autoTimer = window.setInterval(next, AUTO_INTERVAL);
      }
      function pauseAuto(): void {
        if (autoTimer !== null) {
          clearInterval(autoTimer);
          autoTimer = null;
        }
      }

      // Pausa mientras se lee (mouse o foco) y con la pestaña oculta.
      bar.addEventListener("mouseenter", pauseAuto);
      bar.addEventListener("mouseleave", startAuto);
      bar.addEventListener("focusin", pauseAuto);
      bar.addEventListener("focusout", startAuto);
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) pauseAuto();
        else startAuto();
      });

      startAuto();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAnnouncements, { once: true });
    } else {
      initAnnouncements();
    }
  </script>
)}

<style>
  .announcement-bar {
    background: var(--color-bg-deep);
    padding: var(--space-2) var(--space-4);
  }

  /* Todos los avisos en la misma celda: el alto no salta al rotar. */
  .announcement-track {
    display: grid;
    max-width: var(--max-content-width);
    margin: 0 auto;
  }

  .announcement-slide {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-text);
    text-align: center;
    font-variant-numeric: tabular-nums lining-nums;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-slow), visibility var(--transition-slow);
  }
  .announcement-slide[data-active="true"] {
    opacity: 1;
    visibility: visible;
  }

  .announcement-icon {
    flex-shrink: 0;
    color: var(--color-gold);
  }

  @media (max-width: 720px) {
    .announcement-slide {
      font-size: var(--text-xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-slide {
      transition: none;
    }
  }
</style>
