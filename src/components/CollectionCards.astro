---
import { ALL_GENDERS } from "@/constants/ui";
import CollectionCard from "./CollectionCard.astro";
---

<section class="collections" aria-labelledby="collections-heading">
  <div class="collections-headings" data-reveal>
    <h2 class="collections-heading" id="collections-heading">
      Nuestra <em>colección</em> especial
    </h2>
  </div>
  <div class="collections-grid" data-reveal-stagger>
    {ALL_GENDERS.map((gender) => (
      <div data-reveal>
        <CollectionCard gender={gender} />
      </div>
    ))}
  </div>
</section>

<style>
  .collections {
    padding: var(--space-7) clamp(16px, 4vw, 32px) var(--space-6);
    max-width: var(--max-content-width);
    margin: 0 auto;
  }

  .collections-headings {
    text-align: center;
    margin-bottom: var(--space-5);
  }

  .collections-heading {
    font-family: var(--font-serif);
    font-size: clamp(22px, 3vw, 30px);
    color: var(--color-cream);
    letter-spacing: var(--tracking-tight);
    font-weight: 400;
    line-height: 1.1;
    margin: 0;
  }
  .collections-heading em {
    color: var(--color-gold);
    font-style: italic;
  }

  .collections-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  /* Mobile: carrusel horizontal con snap; se ve parte de la siguiente
     imagen para indicar que hay más. */
  @media (max-width: 640px) {
    .collections-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: clamp(16px, 4vw, 32px);
      margin-inline: calc(-1 * clamp(16px, 4vw, 32px));
      padding-inline: clamp(16px, 4vw, 32px);
      scrollbar-width: none;
    }
    .collections-grid > * {
      flex: 0 0 78%;
      scroll-snap-align: start;
    }
  }
</style>
