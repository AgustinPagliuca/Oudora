---
import { ALL_GENDERS } from "@/constants/ui";
import CollectionCard from "./CollectionCard.astro";
---

<section class="collections" aria-labelledby="collections-heading">
  <h2 class="collections-heading" id="collections-heading">
    Nuestra <em>colección</em> especial
  </h2>
  <div class="collections-grid">
    {ALL_GENDERS.map((gender) => <CollectionCard gender={gender} />)}
  </div>
</section>

<style>
  .collections {
    padding: clamp(40px, 6vw, 64px) clamp(16px, 4vw, 32px) 0;
    background: var(--color-bg-deep);
  }

  .collections-heading {
    text-align: center;
    font-family: var(--font-serif);
    font-size: clamp(22px, 3vw, 30px);
    color: var(--color-cream);
    letter-spacing: 1px;
    margin-bottom: 28px;
    font-weight: 400;
  }
  .collections-heading em {
    color: var(--color-gold);
    font-style: italic;
  }

  .collections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    max-width: var(--max-content-width);
    margin: 0 auto;
  }

  @media (max-width: 640px) {
    .collections-grid {
      grid-template-columns: 1fr;
      max-width: 360px;
    }
  }
</style>
