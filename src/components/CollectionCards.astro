---
import { ALL_GENDERS } from "@/constants/ui";
import CollectionCard from "./CollectionCard.astro";
---

<section class="collections" aria-labelledby="collections-heading">
  <div class="collections-headings" data-reveal>
    <h2 class="collections-heading" id="collections-heading">
      Encontrá tu estilo
    </h2>
  </div>
  <div class="collections-grid">
    {ALL_GENDERS.map((gender) => (
      <div data-reveal>
        <CollectionCard gender={gender} />
      </div>
    ))}
  </div>
</section>

<style>
  /* Imágenes editoriales casi de borde a borde (margen de 16px). */
  .collections {
    padding: var(--space-8) var(--space-4);
  }

  .collections-headings {
    text-align: center;
    margin-bottom: var(--space-6);
  }

  .collections-heading {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    color: var(--color-cream);
    letter-spacing: var(--tracking-tight);
    font-weight: 400;
    line-height: 1.1;
    margin: 0;
  }

  .collections-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  /* Mobile: carrusel horizontal con snap; se ve parte de la siguiente
     imagen para indicar que hay más. */
  @media (max-width: 640px) {
    .collections-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--space-4);
      margin-inline: calc(-1 * var(--space-4));
      padding-inline: var(--space-4);
      scrollbar-width: none;
    }
    .collections-grid > * {
      flex: 0 0 78%;
      scroll-snap-align: start;
    }
  }
</style>
