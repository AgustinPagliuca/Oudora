---
/**
 * Overlay de búsqueda global.
 * Se renderiza una sola vez en Layout.astro y queda disponible en
 * todas las páginas. El contenido (resultados) se popula dinámicamente
 * desde search-controller.ts.
 */
---

<div
  class="search-overlay"
  data-search-overlay
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Buscar fragancias"
>
  <div class="search-overlay-backdrop" data-search-overlay-backdrop></div>

  <div class="search-overlay-panel">
    <header class="search-overlay-header">
      <label class="search-overlay-input-wrap">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <line x1="16.5" y1="16.5" x2="21" y2="21" stroke-linecap="round" />
        </svg>
        <input
          type="search"
          placeholder="Fragancia, marca o nota"
          data-search-overlay-input
          autocomplete="off"
          aria-label="Término de búsqueda"
        />
      </label>
      <button
        type="button"
        class="search-overlay-close"
        aria-label="Cerrar búsqueda"
        data-search-overlay-close
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="18" y1="6" x2="6" y2="18" />
        </svg>
      </button>
    </header>

    <div class="search-overlay-body">
      <p class="search-overlay-hint" data-search-overlay-hint>
        Escribí para buscar entre todas las fragancias del catálogo.
      </p>

      <div class="search-overlay-no-results" data-search-overlay-no-results hidden>
        <svg
          class="search-overlay-no-results-icon"
          width="32"
          height="32"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7" />
          <line x1="21" y1="21" x2="16.5" y2="16.5" />
        </svg>
        <p class="search-overlay-no-results-title">Sin resultados</p>
        <p class="search-overlay-no-results-hint">
          Probá con otro término o ajustá la búsqueda.
        </p>
      </div>

      <ul class="search-overlay-results" data-search-overlay-results hidden></ul>

      <a
        class="search-overlay-cta"
        href="/catalogo"
        data-search-overlay-cta
        hidden
      >
        Ver todo en el catálogo
      </a>
    </div>
  </div>
</div>

<template id="search-result-template">
  <li class="search-result">
    <a class="search-result-link" data-result-href>
      <span class="search-result-brand" data-result-brand></span>
      <span class="search-result-name" data-result-name></span>
      <span class="search-result-meta" data-result-meta></span>
      <span class="search-result-price" data-result-price></span>
    </a>
  </li>
</template>

<style>
  /* Buscador: hoja que baja desde arriba con el fondo de la página,
     campo grande en serif con subrayado y resultados en filas. */
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    pointer-events: none;
  }
  .search-overlay[aria-hidden="false"] {
    pointer-events: auto;
  }

  .search-overlay-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    opacity: 0;
    transition: opacity var(--transition-default);
  }
  .search-overlay[aria-hidden="false"] .search-overlay-backdrop {
    opacity: 1;
  }

  .search-overlay-panel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    max-height: 100vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border-subtle);
    transform: translateY(-100%);
    transition: transform var(--transition-default);
  }
  .search-overlay[aria-hidden="false"] .search-overlay-panel {
    transform: translateY(0);
  }

  .search-overlay-header,
  .search-overlay-body {
    max-width: 880px;
    margin: 0 auto;
    padding-inline: clamp(16px, 4vw, 32px);
  }

  .search-overlay-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-7);
  }

  /* Campo grande con subrayado (sin caja ni píldora). */
  .search-overlay-input-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-text-muted);
    color: var(--color-text-muted);
    transition: border-color var(--transition-fast);
  }
  .search-overlay-input-wrap:focus-within {
    border-color: var(--color-cream);
    color: var(--color-cream);
  }
  .search-overlay-input-wrap input {
    flex: 1;
    min-width: 0;
    background: none;
    border: none;
    outline: none;
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-cream);
  }
  .search-overlay-input-wrap input::placeholder {
    color: var(--color-text-faint);
  }

  .search-overlay-close {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    color: var(--color-cream);
    transition: color var(--transition-fast);
  }
  .search-overlay-close:hover {
    color: var(--color-gold-light);
  }

  .search-overlay-body {
    padding-top: var(--space-5);
    padding-bottom: var(--space-7);
  }

  .search-overlay-hint {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .search-overlay-no-results {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-4) 0;
  }
  /* Sin esto, display: flex ganaba a [hidden] del browser y se mostraba
     simultáneamente con los resultados. */
  .search-overlay-no-results[hidden] {
    display: none;
  }
  .search-overlay-no-results-icon {
    display: none;
  }
  .search-overlay-no-results-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-cream);
  }
  .search-overlay-no-results-hint {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .search-overlay-results {
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .search-result {
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .search-result-link {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "brand price"
      "name price"
      "meta price";
    gap: 2px var(--space-4);
    align-items: center;
    padding: var(--space-4) 0;
  }
  .search-result-link:hover .search-result-name {
    color: var(--color-gold-light);
  }

  .search-result-brand {
    grid-area: brand;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .search-result-name {
    grid-area: name;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-cream);
    transition: color var(--transition-fast);
  }
  .search-result-meta {
    grid-area: meta;
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }
  .search-result-price {
    grid-area: price;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-cream);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .search-overlay-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: var(--space-5);
    padding: 0 var(--space-5);
    border: 1px solid var(--color-text-muted);
    color: var(--color-cream);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }
  .search-overlay-cta:hover {
    background: var(--color-cream);
    color: var(--color-bg);
  }
  .search-overlay-cta[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .search-overlay-panel,
    .search-overlay-backdrop {
      transition: none;
    }
  }
</style>
