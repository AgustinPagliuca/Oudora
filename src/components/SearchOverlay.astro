---
/**
 * Overlay de búsqueda global.
 * Se renderiza una sola vez en Layout.astro y queda disponible en
 * todas las páginas. El contenido (resultados) se popula dinámicamente
 * desde search-controller.ts.
 */
---

<div
  class="search-overlay"
  data-search-overlay
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Buscar fragancias"
>
  <div class="search-overlay-backdrop" data-search-overlay-backdrop></div>

  <div class="search-overlay-panel">
    <header class="search-overlay-header">
      <label class="search-overlay-input-wrap">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <line x1="16.5" y1="16.5" x2="21" y2="21" stroke-linecap="round" />
        </svg>
        <input
          type="search"
          placeholder="Buscar fragancia, marca o nota olfativa…"
          data-search-overlay-input
          autocomplete="off"
          aria-label="Término de búsqueda"
        />
      </label>
      <button
        type="button"
        class="search-overlay-close"
        aria-label="Cerrar búsqueda"
        data-search-overlay-close
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="18" y1="6" x2="6" y2="18" />
        </svg>
      </button>
    </header>

    <div class="search-overlay-body">
      <p class="search-overlay-hint" data-search-overlay-hint>
        Escribí para buscar entre todas las fragancias del catálogo.
      </p>

      <div class="search-overlay-no-results" data-search-overlay-no-results hidden>
        <svg
          class="search-overlay-no-results-icon"
          width="32"
          height="32"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7" />
          <line x1="21" y1="21" x2="16.5" y2="16.5" />
        </svg>
        <p class="search-overlay-no-results-title">Sin resultados</p>
        <p class="search-overlay-no-results-hint">
          Probá con otro término o ajustá la búsqueda.
        </p>
      </div>

      <ul class="search-overlay-results" data-search-overlay-results hidden></ul>

      <a
        class="search-overlay-cta"
        href="/catalogo"
        data-search-overlay-cta
        hidden
      >
        Ver todos los resultados en el catálogo →
      </a>
    </div>
  </div>
</div>

<template id="search-result-template">
  <li class="search-result">
    <a class="search-result-link" data-result-href>
      <span class="search-result-brand" data-result-brand></span>
      <span class="search-result-name" data-result-name></span>
      <span class="search-result-meta" data-result-meta></span>
      <span class="search-result-price" data-result-price></span>
    </a>
  </li>
</template>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    pointer-events: none;
  }
  .search-overlay[aria-hidden="false"] {
    pointer-events: auto;
  }

  .search-overlay-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    opacity: 0;
    transition: opacity var(--transition-default);
  }
  .search-overlay[aria-hidden="false"] .search-overlay-backdrop {
    opacity: 1;
  }

  .search-overlay-panel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background: var(--color-bg-deep);
    border-bottom: 0.5px solid var(--color-border-strong);
    transform: translateY(-100%);
    transition: transform var(--transition-default);
    max-height: 92vh;
    overflow-y: auto;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
  }
  .search-overlay[aria-hidden="false"] .search-overlay-panel {
    transform: translateY(0);
  }

  .search-overlay-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px clamp(16px, 4vw, 32px);
    border-bottom: 0.5px solid var(--color-border);
    max-width: var(--max-content-width);
    margin: 0 auto;
    width: 100%;
  }

  .search-overlay-input-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.05);
    border: 0.5px solid rgba(201, 168, 76, 0.3);
    border-radius: var(--radius-pill);
    padding: 12px 18px;
    color: var(--color-gold);
    transition: border-color var(--transition-fast);
  }
  .search-overlay-input-wrap:focus-within {
    border-color: var(--color-gold);
  }
  .search-overlay-input-wrap input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    color: var(--color-cream);
    font-size: var(--text-base);
    letter-spacing: var(--tracking-normal);
    font-family: inherit;
    min-width: 0;
  }
  .search-overlay-input-wrap input::placeholder {
    color: var(--color-text-muted);
  }

  .search-overlay-close {
    color: var(--color-gold-light);
    padding: 8px;
    border-radius: var(--radius-circle);
    transition: background var(--transition-fast);
  }
  .search-overlay-close:hover {
    background: rgba(201, 168, 76, 0.1);
  }

  .search-overlay-body {
    padding: 18px clamp(16px, 4vw, 32px) 24px;
    max-width: var(--max-content-width);
    margin: 0 auto;
    width: 100%;
  }

  .search-overlay-hint {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-align: center;
    padding: var(--space-5) var(--space-3);
  }
  .search-overlay-no-results {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-6) var(--space-3);
    gap: var(--space-2);
  }
  /* Sin esto, display: flex ganaba a [hidden] del browser y se mostraba
     simultáneamente con los resultados. */
  .search-overlay-no-results[hidden] {
    display: none;
  }
  .search-overlay-no-results-icon {
    color: var(--color-gold);
    opacity: 0.5;
    margin-bottom: var(--space-2);
    width: 32px;
    height: 32px;
    align-self: center;
    flex-shrink: 0;
  }
  .search-overlay-no-results-title {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    color: var(--color-cream);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }
  .search-overlay-no-results-hint {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin: 0;
    line-height: 1.55;
  }

  .search-overlay-results {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .search-result-link {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    grid-template-areas:
      "brand price"
      "name price"
      "meta price";
    gap: 2px 16px;
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    transition: background var(--transition-fast);
    align-items: center;
  }
  .search-result-link:hover {
    background: rgba(201, 168, 76, 0.06);
  }

  .search-result-brand {
    grid-area: brand;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .search-result-name {
    grid-area: name;
    font-size: var(--text-base);
    color: var(--color-cream);
    letter-spacing: var(--tracking-normal);
    font-weight: 500;
  }
  .search-result-meta {
    grid-area: meta;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
  }
  .search-result-price {
    grid-area: price;
    font-family: var(--font-serif);
    font-size: var(--text-md);
    color: var(--color-gold);
  }

  .search-overlay-cta {
    display: block;
    margin-top: 16px;
    padding: 12px;
    text-align: center;
    border: 0.5px solid rgba(201, 168, 76, 0.25);
    border-radius: var(--radius-pill);
    color: var(--color-gold-light);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    transition: all var(--transition-fast);
  }
  .search-overlay-cta:hover {
    background: rgba(201, 168, 76, 0.08);
    border-color: var(--color-gold);
  }
</style>
