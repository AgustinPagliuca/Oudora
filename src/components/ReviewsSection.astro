---
import type { Review } from "@/types/catalog";

interface Props {
  reviews: readonly Review[];
}

const { reviews } = Astro.props;
---

{reviews.length > 0 && (
  <section class="reviews-section">
    <h2 class="reviews-title">
      Lo que dicen <em>nuestros clientes</em>
    </h2>

    <div class="reviews-grid" data-count={reviews.length}>
      {reviews.map((r) => (
        <figure class="review-card">
          {r.rating !== null && (
            <div class="review-stars" role="img" aria-label={`${r.rating} de 5 estrellas`}>
              {"★".repeat(r.rating)}<span class="review-stars-off">{"★".repeat(5 - r.rating)}</span>
            </div>
          )}
          <blockquote class="review-body">“{r.body}”</blockquote>
          <figcaption class="review-author">{r.authorName}</figcaption>
        </figure>
      ))}
    </div>
  </section>
)}

<style>
  .reviews-section {
    padding: var(--space-9) clamp(16px, 4vw, 32px);
    max-width: var(--max-content-width);
    margin: 0 auto;
    /* Separador sutil cuando sigue a otra sección crema. */
    border-top: 1px solid var(--surface-tint, transparent);
  }

  .reviews-title {
    text-align: center;
    margin-bottom: var(--space-7);
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 400;
    color: var(--surface-text, var(--color-cream));
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }
  .reviews-title em {
    color: var(--surface-accent, var(--color-gold));
    font-style: italic;
  }

  /* Sin caja: cita grande centrada. Con varias reseñas, columnas. */
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-7) var(--space-6);
  }

  .review-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .review-stars {
    color: var(--surface-accent, var(--color-gold));
    font-size: var(--text-base);
    letter-spacing: var(--tracking-uppercase);
  }
  .review-stars-off {
    color: var(--surface-line, rgba(201, 168, 76, 0.25));
  }

  .review-body {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: 1.35;
    color: var(--surface-text, var(--color-cream));
    text-wrap: balance;
  }

  .review-author {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-uppercase);
    color: var(--surface-muted, var(--color-text-muted));
    text-transform: uppercase;
  }

  /* Una sola reseña: más grande y centrada, sin estirarse a todo el ancho. */
  .reviews-grid[data-count="1"] {
    grid-template-columns: minmax(0, 760px);
    justify-content: center;
  }
  .reviews-grid[data-count="1"] .review-body {
    font-size: var(--text-3xl);
    line-height: 1.2;
  }

  @media (max-width: 720px) {
    .reviews-section {
      padding: var(--space-7) var(--space-4);
    }
    .reviews-grid[data-count="1"] .review-body {
      font-size: var(--text-xl);
    }
  }
</style>
