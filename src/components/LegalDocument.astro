---
/**
 * Contenedor tipográfico de los documentos legales (privacidad, términos,
 * cookies). Las tres páginas comparten exactamente la misma maquetación, así
 * que el estilo de prosa vive acá una sola vez.
 */
interface Props {
  lastUpdated: string;
}

const { lastUpdated } = Astro.props;
---

<article class="legal">
  <p class="legal-updated">Última actualización: {lastUpdated}</p>
  <div class="legal-body">
    <slot />
  </div>
</article>

<style>
  /* Prosa legal. Usa --surface-* (crema en las páginas legales) con
     fallback a los colores de fondo oscuro. */
  .legal {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-5) clamp(16px, 4vw, 32px) var(--space-8);
  }

  .legal-updated {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--surface-tint, var(--color-border-subtle));
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-align: center;
    color: var(--surface-muted, var(--color-text-muted));
  }

  /* El contenido llega por <slot />, así que los selectores tienen que ser
     :global — Astro no aplica el scope a los hijos proyectados. */
  .legal-body :global(h2) {
    margin: var(--space-7) 0 var(--space-4);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 400;
    line-height: 1.2;
    color: var(--surface-text, var(--color-cream));
  }
  .legal-body :global(h2:first-child) {
    margin-top: 0;
  }
  .legal-body :global(h2 em) {
    font-style: normal;
  }

  .legal-body :global(h3) {
    margin: var(--space-5) 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--surface-text, var(--color-cream));
  }

  .legal-body :global(p),
  .legal-body :global(li) {
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--surface-muted, var(--color-text));
  }
  .legal-body :global(p) {
    margin: 0 0 var(--space-4);
    max-width: 68ch;
  }

  .legal-body :global(ul) {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
    list-style: none;
  }
  .legal-body :global(li) {
    position: relative;
    margin-bottom: var(--space-2);
  }
  .legal-body :global(li)::before {
    content: "·";
    position: absolute;
    left: calc(var(--space-5) * -1);
    color: var(--surface-text, var(--color-gold));
  }

  .legal-body :global(strong) {
    font-weight: 600;
    color: var(--surface-text, var(--color-cream));
  }

  .legal-body :global(a) {
    color: var(--surface-text, var(--color-gold-light));
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition-fast);
  }
  .legal-body :global(a:hover) {
    color: var(--surface-accent, var(--color-gold));
  }
</style>
