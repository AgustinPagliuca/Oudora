---
/**
 * Contenedor tipográfico de los documentos legales (privacidad, términos,
 * cookies). Las tres páginas comparten exactamente la misma maquetación, así
 * que el estilo de prosa vive acá una sola vez.
 */
interface Props {
  lastUpdated: string;
}

const { lastUpdated } = Astro.props;
---

<article class="legal">
  <p class="legal-updated">Última actualización: {lastUpdated}</p>
  <div class="legal-body">
    <slot />
  </div>
</article>

<style>
  .legal {
    padding: 32px clamp(16px, 4vw, 32px) 64px;
    max-width: 780px;
    margin: 0 auto;
  }

  .legal-updated {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-align: center;
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-6);
    border-bottom: 0.5px solid var(--color-border);
  }

  /* El contenido llega por <slot />, así que los selectores tienen que ser
     :global — Astro no aplica el scope a los hijos proyectados. */
  .legal-body :global(h2) {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-xl);
    color: var(--color-cream);
    letter-spacing: var(--tracking-tight);
    margin: var(--space-7) 0 var(--space-4);
  }
  .legal-body :global(h2:first-child) {
    margin-top: 0;
  }
  .legal-body :global(h2 em) {
    color: var(--color-gold);
    font-style: italic;
  }

  .legal-body :global(h3) {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: var(--text-md);
    color: var(--color-gold-light);
    letter-spacing: var(--tracking-tight);
    margin: var(--space-5) 0 var(--space-2);
  }

  .legal-body :global(p) {
    font-size: var(--text-base);
    line-height: 1.85;
    color: var(--color-text);
    margin: 0 0 var(--space-4);
  }

  .legal-body :global(ul) {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
    list-style: none;
  }
  .legal-body :global(li) {
    position: relative;
    font-size: var(--text-base);
    line-height: 1.85;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }
  .legal-body :global(li)::before {
    content: "·";
    position: absolute;
    left: calc(var(--space-5) * -1);
    color: var(--color-gold);
  }

  .legal-body :global(strong) {
    color: var(--color-cream);
    font-weight: 600;
  }

  .legal-body :global(a) {
    color: var(--color-gold-light);
    transition: color var(--transition-fast);
  }
  .legal-body :global(a:hover) {
    color: var(--color-gold);
  }
</style>
