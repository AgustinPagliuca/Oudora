---
import type {
  BrandWithCount,
  Catalog,
  Gender,
  PriceRange,
} from "@/types/catalog";
import {
  ALL_GENDERS,
  CATALOG_LABELS,
  GENDER_LABELS,
} from "@/constants/ui";
import { formatArs } from "@/lib/format";

/**
 * Filtros del catálogo.
 * - Desktop (≥921px): barra horizontal. Marca y Precio son desplegables
 *   (<details>) que se cierran al hacer click afuera o con Escape.
 * - Mobile: el mismo bloque es un drawer lateral (lo abre el botón de
 *   filtros del Nav) y los desplegables funcionan como acordeones.
 * El catalog-controller solo depende de los atributos data-*, no de la
 * estructura, así que la lógica de filtrado no cambia.
 */

interface CatalogGroup {
  readonly catalog: Catalog;
  readonly brands: readonly BrandWithCount[];
  readonly totalProducts: number;
  readonly priceRange: PriceRange;
}

interface Props {
  groups: readonly CatalogGroup[];
  activeCatalog: Catalog;
}

const { groups, activeCatalog } = Astro.props;
---

<div class="sidebar-backdrop" data-sidebar-backdrop aria-hidden="true"></div>

<aside class="sidebar" aria-label="Filtros del catálogo" data-sidebar data-open="false">
  <header class="sidebar-mobile-header">
    <span class="sidebar-mobile-title">Filtros</span>
    <button
      type="button"
      class="sidebar-close-mobile"
      aria-label="Cerrar filtros"
      data-sidebar-close
    >
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line x1="6" y1="6" x2="18" y2="18" />
        <line x1="18" y1="6" x2="6" y2="18" />
      </svg>
    </button>
  </header>

  <div class="sidebar-section sidebar-section-search">
    <label class="sidebar-search">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <line x1="16.5" y1="16.5" x2="21" y2="21" stroke-linecap="round" />
      </svg>
      <input
        id="filter-search"
        type="search"
        placeholder="Nombre, marca o nota…"
        data-filter-search
        autocomplete="off"
        aria-label="Buscar fragancia"
      />
    </label>
  </div>

  {
    groups.map((group) => (
      <div
        class="sidebar-section"
        data-catalog-group={group.catalog}
        data-hidden={group.catalog === activeCatalog ? "false" : "true"}
      >
        <details class="filter-drop" data-filter-drop>
          <summary class="filter-drop-toggle">
            Marca
            <svg class="filter-drop-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </summary>
          <div class="filter-drop-panel sidebar-list">
            <button
              type="button"
              class="sidebar-row active"
              data-filter-brand=""
              data-catalog={group.catalog}
              aria-pressed="true"
            >
              <span>Todas</span>
              <strong>{group.totalProducts}</strong>
            </button>
            {group.brands.map((brand) => (
              <button
                type="button"
                class="sidebar-row"
                data-filter-brand={brand.id}
                data-catalog={group.catalog}
                aria-pressed="false"
              >
                <span>{brand.name}</span>
                <strong>{brand.productCount}</strong>
              </button>
            ))}
          </div>
        </details>
      </div>
    ))
  }

  {
    groups.map((group) => {
      const range = group.priceRange.max - group.priceRange.min;
      const step = range > 100000 ? 5000 : range > 30000 ? 1000 : 500;
      return (
        <div
          class="sidebar-section"
          data-catalog-group={group.catalog}
          data-hidden={group.catalog === activeCatalog ? "false" : "true"}
        >
          <details class="filter-drop" data-filter-drop>
            <summary class="filter-drop-toggle">
              Precio
              <svg class="filter-drop-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <div class="filter-drop-panel">
              <div class="price-slider" data-price-slider data-catalog={group.catalog}>
                <div class="price-slider-track"></div>
                <div class="price-slider-fill" data-price-fill></div>
                <input
                  type="range"
                  class="price-slider-input price-slider-input-min"
                  min={group.priceRange.min}
                  max={group.priceRange.max}
                  value={group.priceRange.min}
                  step={step}
                  data-filter-price-min
                  data-catalog={group.catalog}
                  data-min-bound={group.priceRange.min}
                  data-max-bound={group.priceRange.max}
                  aria-label={`Precio mínimo (${CATALOG_LABELS[group.catalog]})`}
                />
                <input
                  type="range"
                  class="price-slider-input price-slider-input-max"
                  min={group.priceRange.min}
                  max={group.priceRange.max}
                  value={group.priceRange.max}
                  step={step}
                  data-filter-price-max
                  data-catalog={group.catalog}
                  data-min-bound={group.priceRange.min}
                  data-max-bound={group.priceRange.max}
                  aria-label={`Precio máximo (${CATALOG_LABELS[group.catalog]})`}
                />
              </div>
              <div class="price-slider-values">
                <span data-price-display-min data-catalog={group.catalog}>
                  {formatArs(group.priceRange.min)}
                </span>
                <span data-price-display-max data-catalog={group.catalog}>
                  {formatArs(group.priceRange.max)}
                </span>
              </div>
            </div>
          </details>
        </div>
      );
    })
  }

  <div class="sidebar-section sidebar-section-gender" role="group" aria-label="Género">
    <p class="sidebar-label">Género</p>
    <div class="sidebar-chips">
      <button
        type="button"
        class="sidebar-chip active"
        data-filter-gender=""
        aria-pressed="true"
      >
        Todos
      </button>
      {
        ALL_GENDERS.map((gender: Gender) => (
          <button
            type="button"
            class="sidebar-chip"
            data-filter-gender={gender}
            aria-pressed="false"
          >
            {GENDER_LABELS[gender]}
          </button>
        ))
      }
    </div>
  </div>

  <button type="button" class="sidebar-clear" data-filter-clear>
    Limpiar filtros
  </button>
</aside>

<script>
  // En desktop los <details> de Marca y Precio son desplegables: solo uno
  // abierto a la vez, y se cierran con click afuera o Escape. En mobile
  // (drawer) funcionan como acordeones normales.
  const desktop = window.matchMedia("(min-width: 921px)");
  const drops = Array.from(
    document.querySelectorAll<HTMLDetailsElement>("[data-filter-drop]"),
  );

  function closeDrops(except?: HTMLDetailsElement): void {
    drops.forEach((drop) => {
      if (drop !== except) drop.open = false;
    });
  }

  drops.forEach((drop) => {
    drop.addEventListener("toggle", () => {
      if (drop.open && desktop.matches) closeDrops(drop);
    });
  });
  document.addEventListener("click", (event) => {
    if (!desktop.matches) return;
    const target = event.target as Node;
    if (!drops.some((drop) => drop.contains(target))) closeDrops();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && desktop.matches) closeDrops();
  });
</script>

<style>
  .sidebar-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 89;
    opacity: 0;
    transition: opacity var(--transition-default);
    pointer-events: none;
  }

  /* ── Desktop: barra horizontal ─────────────────────────────── */
  .sidebar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .sidebar-mobile-header {
    display: none;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom: 0.5px solid var(--color-border);
  }

  .sidebar-mobile-title {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-cream);
  }

  .sidebar-close-mobile {
    color: var(--color-cream);
    padding: 6px;
    display: inline-flex;
    transition: color var(--transition-fast);
  }
  .sidebar-close-mobile:hover {
    color: var(--color-gold-light);
  }

  .sidebar-section {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .sidebar-section[data-hidden="true"] {
    display: none;
  }

  .sidebar-label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-uppercase);
    color: var(--surface-muted, var(--color-text-muted));
    text-transform: uppercase;
    font-weight: 600;
  }
  /* En la barra, "Género" se entiende por los chips: la etiqueta queda
     solo para lectores de pantalla (el grupo ya tiene aria-label). */
  .sidebar-section-gender .sidebar-label {
    display: none;
  }

  .sidebar-search {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 200px;
    min-height: 40px;
    padding: 0 var(--space-3);
    border: 1px solid var(--surface-line, rgba(245, 237, 216, 0.22));
    color: var(--surface-muted, var(--color-text-muted));
    transition: border-color var(--transition-fast);
  }
  .sidebar-search:focus-within {
    border-color: var(--surface-text, var(--color-cream));
  }
  .sidebar-search input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    color: var(--surface-text, var(--color-cream));
    font-size: var(--text-sm);
    min-width: 0;
  }
  .sidebar-search input::placeholder {
    color: var(--surface-muted, var(--color-text-muted));
  }

  /* Desplegables Marca / Precio */
  .filter-drop {
    position: relative;
  }
  .filter-drop-toggle {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 40px;
    padding: 0 var(--space-4);
    border: 1px solid var(--surface-line, rgba(245, 237, 216, 0.22));
    color: var(--surface-text, var(--color-cream));
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    cursor: pointer;
    user-select: none;
    transition: border-color var(--transition-fast);
  }
  .filter-drop-toggle::-webkit-details-marker {
    display: none;
  }
  .filter-drop-toggle:hover,
  .filter-drop[open] .filter-drop-toggle {
    border-color: var(--surface-text, var(--color-cream));
  }
  /* Marca con alguna marca elegida: el botón queda marcado. */
  .filter-drop:has([data-filter-brand]:not([data-filter-brand=""]).active) .filter-drop-toggle {
    background: var(--surface-text, var(--color-cream));
    border-color: var(--surface-text, var(--color-cream));
    color: var(--surface-bg, var(--color-bg));
  }
  .filter-drop-chevron {
    transition: transform var(--transition-fast);
  }
  .filter-drop[open] .filter-drop-chevron {
    transform: rotate(180deg);
  }

  .filter-drop-panel {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    z-index: 30;
    min-width: 260px;
    max-height: min(60vh, 420px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-2);
    background: var(--surface-bg, var(--color-bg-elevated));
    border: 1px solid var(--surface-line, rgba(245, 237, 216, 0.12));
    box-shadow: var(--elev-3);
  }

  .sidebar-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--space-3);
    font-size: var(--text-sm);
    color: var(--surface-muted, var(--color-text-muted));
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }
  .sidebar-row:hover {
    color: var(--surface-text, var(--color-cream));
  }
  .sidebar-row.active {
    color: var(--surface-text, var(--color-cream));
    background: var(--surface-tint, rgba(245, 237, 216, 0.08));
  }
  .sidebar-row strong {
    color: var(--surface-faint, var(--color-text-faint));
    font-weight: 500;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .sidebar-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .sidebar-chip {
    min-height: 40px;
    padding: 0 var(--space-3);
    border: 1px solid var(--surface-line, rgba(245, 237, 216, 0.22));
    color: var(--surface-muted, var(--color-text-muted));
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    transition: color var(--transition-fast), border-color var(--transition-fast),
      background-color var(--transition-fast);
  }
  .sidebar-chip:hover {
    color: var(--surface-text, var(--color-cream));
    border-color: var(--surface-text, var(--color-cream));
  }
  .sidebar-chip.active {
    background: var(--surface-text, var(--color-cream));
    border-color: var(--surface-text, var(--color-cream));
    color: var(--surface-bg, var(--color-bg));
  }

  .price-slider {
    position: relative;
    height: 28px;
    margin: var(--space-3) var(--space-3) 0;
  }

  .price-slider-track {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--surface-line, rgba(245, 237, 216, 0.2));
    transform: translateY(-50%);
    pointer-events: none;
  }

  .price-slider-fill {
    position: absolute;
    top: 50%;
    left: 0%;
    right: 0%;
    height: 2px;
    background: var(--surface-text, var(--color-cream));
    transform: translateY(-50%);
    pointer-events: none;
    transition: left 0.05s linear, right 0.05s linear;
  }

  .price-slider-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    -webkit-appearance: none;
    appearance: none;
    background: none;
    pointer-events: none;
    margin: 0;
    padding: 0;
  }

  .price-slider-input::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    background: var(--surface-text, var(--color-cream));
    border: 2px solid var(--surface-bg, var(--color-bg));
    border-radius: var(--radius-circle);
    cursor: grab;
    pointer-events: auto;
    box-shadow: 0 0 0 1px var(--surface-text, var(--color-cream));
  }
  .price-slider-input::-moz-range-thumb {
    width: 18px;
    height: 18px;
    background: var(--surface-text, var(--color-cream));
    border: 2px solid var(--surface-bg, var(--color-bg));
    border-radius: var(--radius-circle);
    cursor: grab;
    pointer-events: auto;
    box-shadow: 0 0 0 1px var(--surface-text, var(--color-cream));
  }

  .price-slider-input::-webkit-slider-runnable-track,
  .price-slider-input::-moz-range-track {
    background: none;
  }

  .price-slider-input-min {
    z-index: 2;
  }
  .price-slider-input-max {
    z-index: 3;
  }
  /* Trick: when min thumb is at the right end, raise its z-index so it stays grabbable */
  .price-slider-input-min[data-thumb-up="true"] {
    z-index: 4;
  }

  .price-slider-values {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
    color: var(--surface-text, var(--color-cream));
    font-variant-numeric: tabular-nums lining-nums;
    padding: var(--space-2) var(--space-2) var(--space-1);
  }

  .sidebar-clear {
    min-height: 40px;
    padding: 0 var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--surface-muted, var(--color-text-muted));
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition-fast);
  }
  .sidebar-clear:hover {
    color: var(--surface-text, var(--color-cream));
  }

  /* ── Mobile: drawer con backdrop ───────────────────────── */
  @media (max-width: 920px) {
    .sidebar-backdrop {
      display: block;
      z-index: 109;
    }
    body[data-sidebar-open="true"] .sidebar-backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: min(340px, 88vw);
      z-index: 110;
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: var(--space-5);
      padding: var(--space-5) var(--space-4);
      background: var(--color-bg-elevated);
      /* El drawer es oscuro aunque la página esté sobre crema: vuelve a
         los colores de fondo oscuro para todo lo que tiene adentro. */
      --surface-bg: var(--color-bg-elevated);
      --surface-text: var(--color-cream);
      --surface-muted: var(--color-text-muted);
      --surface-faint: var(--color-text-faint);
      --surface-accent: var(--color-gold-light);
      --surface-line: rgba(245, 237, 216, 0.22);
      --surface-tint: rgba(245, 237, 216, 0.08);
      color: var(--color-cream);
      transform: translateX(-100%);
      transition: transform var(--transition-default);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .sidebar[data-open="true"] {
      transform: translateX(0);
      box-shadow: 4px 0 30px rgba(0, 0, 0, 0.6);
    }

    .sidebar-mobile-header {
      display: flex;
    }

    .sidebar-section {
      flex-direction: column;
      align-items: stretch;
    }
    .sidebar-section-gender .sidebar-label {
      display: block;
    }
    .sidebar-search {
      width: auto;
    }

    /* Desplegables como acordeones dentro del drawer */
    .filter-drop-toggle {
      width: 100%;
      justify-content: space-between;
    }
    .filter-drop-panel {
      position: static;
      min-width: 0;
      max-height: none;
      margin-top: var(--space-2);
      box-shadow: none;
      background: transparent;
      border: 0;
      padding: 0;
    }

    .sidebar-clear {
      align-self: center;
    }
  }
</style>
