---
import type {
  BrandWithCount,
  Catalog,
  Gender,
  PriceRange,
} from "@/types/catalog";
import {
  ALL_CATALOGS,
  ALL_GENDERS,
  CATALOG_LABELS,
  GENDER_LABELS,
} from "@/constants/ui";
import { formatArs } from "@/lib/format";

interface CatalogGroup {
  readonly catalog: Catalog;
  readonly brands: readonly BrandWithCount[];
  readonly totalProducts: number;
  readonly priceRange: PriceRange;
}

interface Props {
  groups: readonly CatalogGroup[];
  activeCatalog: Catalog;
}

const { groups, activeCatalog } = Astro.props;
---

<div class="sidebar-backdrop" data-sidebar-backdrop aria-hidden="true"></div>

<aside class="sidebar" aria-label="Filtros del catálogo" data-sidebar data-open="false">
  <header class="sidebar-mobile-header">
    <span class="sidebar-mobile-title">Filtros</span>
    <button
      type="button"
      class="sidebar-close-mobile"
      aria-label="Cerrar filtros"
      data-sidebar-close
    >
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line x1="6" y1="6" x2="18" y2="18" />
        <line x1="18" y1="6" x2="6" y2="18" />
      </svg>
    </button>
  </header>

  <div class="sidebar-section sidebar-tabs">
    {
      ALL_CATALOGS.map((catalog) => (
        <button
          type="button"
          class={`sidebar-tab ${catalog === activeCatalog ? "active" : ""}`}
          aria-pressed={catalog === activeCatalog ? "true" : "false"}
          data-catalog-tab={catalog}
        >
          {CATALOG_LABELS[catalog]}
        </button>
      ))
    }
  </div>

  <div class="sidebar-section">
    <p class="sidebar-label">Buscar</p>
    <label class="sidebar-search">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <line x1="16.5" y1="16.5" x2="21" y2="21" stroke-linecap="round" />
      </svg>
      <input
        id="filter-search"
        type="search"
        placeholder="Nombre, marca o nota…"
        data-filter-search
        autocomplete="off"
        aria-label="Buscar fragancia"
      />
    </label>
  </div>

  {
    groups.map((group) => (
      <div
        class="sidebar-section"
        data-catalog-group={group.catalog}
        data-hidden={group.catalog === activeCatalog ? "false" : "true"}
      >
        <p class="sidebar-label">Marca</p>
        <div class="sidebar-list">
          <button
            type="button"
            class="sidebar-row active"
            data-filter-brand=""
            data-catalog={group.catalog}
            aria-pressed="true"
          >
            <span>Todas</span>
            <strong>{group.totalProducts}</strong>
          </button>
          {group.brands.map((brand) => (
            <button
              type="button"
              class="sidebar-row"
              data-filter-brand={brand.id}
              data-catalog={group.catalog}
              aria-pressed="false"
            >
              <span>{brand.name}</span>
              <strong>{brand.productCount}</strong>
            </button>
          ))}
        </div>
      </div>
    ))
  }

  <div class="sidebar-section">
    <p class="sidebar-label">Género</p>
    <div class="sidebar-chips">
      <button
        type="button"
        class="sidebar-chip active"
        data-filter-gender=""
        aria-pressed="true"
      >
        Todos
      </button>
      {
        ALL_GENDERS.map((gender: Gender) => (
          <button
            type="button"
            class="sidebar-chip"
            data-filter-gender={gender}
            aria-pressed="false"
          >
            {GENDER_LABELS[gender]}
          </button>
        ))
      }
    </div>
  </div>

  {
    groups.map((group) => {
      const range = group.priceRange.max - group.priceRange.min;
      const step = range > 100000 ? 5000 : range > 30000 ? 1000 : 500;
      return (
        <div
          class="sidebar-section"
          data-catalog-group={group.catalog}
          data-hidden={group.catalog === activeCatalog ? "false" : "true"}
        >
          <p class="sidebar-label">Rango de precio</p>
          <div class="price-slider" data-price-slider data-catalog={group.catalog}>
            <div class="price-slider-track"></div>
            <div class="price-slider-fill" data-price-fill></div>
            <input
              type="range"
              class="price-slider-input price-slider-input-min"
              min={group.priceRange.min}
              max={group.priceRange.max}
              value={group.priceRange.min}
              step={step}
              data-filter-price-min
              data-catalog={group.catalog}
              data-min-bound={group.priceRange.min}
              data-max-bound={group.priceRange.max}
              aria-label={`Precio mínimo (${CATALOG_LABELS[group.catalog]})`}
            />
            <input
              type="range"
              class="price-slider-input price-slider-input-max"
              min={group.priceRange.min}
              max={group.priceRange.max}
              value={group.priceRange.max}
              step={step}
              data-filter-price-max
              data-catalog={group.catalog}
              data-min-bound={group.priceRange.min}
              data-max-bound={group.priceRange.max}
              aria-label={`Precio máximo (${CATALOG_LABELS[group.catalog]})`}
            />
          </div>
          <div class="price-slider-values">
            <span data-price-display-min data-catalog={group.catalog}>
              {formatArs(group.priceRange.min)}
            </span>
            <span data-price-display-max data-catalog={group.catalog}>
              {formatArs(group.priceRange.max)}
            </span>
          </div>
        </div>
      );
    })
  }

  <button type="button" class="sidebar-clear" data-filter-clear>
    Limpiar filtros
  </button>
</aside>

<style>
  .sidebar-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 89;
    opacity: 0;
    transition: opacity var(--transition-default);
    pointer-events: none;
  }

  .sidebar {
    background: var(--color-bg-deep);
    border: 0.5px solid rgba(201, 168, 76, 0.14);
    border-radius: var(--radius-md);
    padding: 22px 18px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-self: start;
    position: sticky;
    top: 84px;
    /* Si el contenido del sidebar (filtros, marcas, slider de precio)
       supera la altura del viewport restante, debemos permitirle scroll
       interno para que se vea todo. Sin esto el bottom se corta. */
    max-height: calc(100vh - 104px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  /* Scrollbar fina y discreta para no romper el look luxury */
  .sidebar::-webkit-scrollbar {
    width: 6px;
  }
  .sidebar::-webkit-scrollbar-track {
    background: transparent;
  }
  .sidebar::-webkit-scrollbar-thumb {
    background: rgba(201, 168, 76, 0.2);
    border-radius: 3px;
  }
  .sidebar::-webkit-scrollbar-thumb:hover {
    background: rgba(201, 168, 76, 0.4);
  }

  .sidebar-mobile-header {
    display: none;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom: 0.5px solid var(--color-border);
  }

  .sidebar-mobile-title {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-cream);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
  }

  .sidebar-close-mobile {
    color: var(--color-gold-light);
    padding: 6px;
    border-radius: var(--radius-circle);
    transition: background var(--transition-fast);
    display: inline-flex;
  }
  .sidebar-close-mobile:hover {
    background: rgba(201, 168, 76, 0.1);
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sidebar-section[data-hidden="true"] {
    display: none;
  }

  .sidebar-label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-uppercase);
    color: var(--color-text-muted);
    text-transform: uppercase;
    font-weight: 500;
  }

  .sidebar-tabs {
    flex-direction: column;
    gap: 4px;
    padding-bottom: 18px;
    border-bottom: 0.5px solid rgba(201, 168, 76, 0.12);
  }

  .sidebar-tab {
    text-align: left;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding: 11px 12px;
    border-radius: var(--radius-sm);
    border-left: 2px solid transparent;
    transition: all var(--transition-fast);
  }
  .sidebar-tab:hover {
    color: var(--color-cream);
  }
  .sidebar-tab.active {
    color: var(--color-gold-light);
    border-left-color: var(--color-gold);
    background: rgba(201, 168, 76, 0.06);
  }

  .sidebar-search {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 0.5px solid rgba(201, 168, 76, 0.18);
    border-radius: var(--radius-pill);
    padding: 10px 16px;
    color: var(--color-gold);
    transition: border-color var(--transition-fast);
  }
  .sidebar-search:focus-within {
    border-color: var(--color-gold);
  }
  .sidebar-search input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    color: var(--color-cream);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-normal);
    min-width: 0;
  }
  .sidebar-search input::placeholder {
    color: var(--color-text-muted);
  }

  .sidebar-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 9px 10px;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
    letter-spacing: var(--tracking-normal);
    transition: all var(--transition-fast);
  }
  .sidebar-row:hover {
    background: rgba(201, 168, 76, 0.05);
    color: var(--color-gold-light);
  }
  .sidebar-row.active {
    color: var(--color-gold-light);
    background: rgba(201, 168, 76, 0.08);
  }
  .sidebar-row strong {
    color: var(--color-text-faint);
    font-weight: 500;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
  }
  .sidebar-row.active strong {
    color: var(--color-gold);
  }

  .sidebar-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .sidebar-chip {
    border: 0.5px solid rgba(255, 255, 255, 0.12);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    padding: 7px 13px;
    border-radius: var(--radius-pill);
    transition: all var(--transition-fast);
  }
  .sidebar-chip:hover {
    border-color: rgba(255, 255, 255, 0.3);
    color: var(--color-cream);
  }
  .sidebar-chip.active {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.3);
    color: var(--color-cream);
  }

  .price-slider {
    position: relative;
    height: 28px;
    margin: 4px 6px 0;
  }

  .price-slider-track {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    background: rgba(201, 168, 76, 0.18);
    border-radius: 1px;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .price-slider-fill {
    position: absolute;
    top: 50%;
    left: 0%;
    right: 0%;
    height: 3px;
    background: var(--color-gold);
    border-radius: 2px;
    transform: translateY(-50%);
    pointer-events: none;
    transition: left 0.05s linear, right 0.05s linear;
  }

  .price-slider-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    -webkit-appearance: none;
    appearance: none;
    background: none;
    pointer-events: none;
    margin: 0;
    padding: 0;
  }

  .price-slider-input::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    background: var(--color-gold-light);
    border: 1.5px solid var(--color-gold);
    border-radius: 50%;
    cursor: grab;
    pointer-events: auto;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
    transition: transform var(--transition-fast);
  }
  .price-slider-input::-webkit-slider-thumb:hover,
  .price-slider-input::-webkit-slider-thumb:active {
    transform: scale(1.15);
  }

  .price-slider-input::-moz-range-thumb {
    width: 18px;
    height: 18px;
    background: var(--color-gold-light);
    border: 1.5px solid var(--color-gold);
    border-radius: 50%;
    cursor: grab;
    pointer-events: auto;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  .price-slider-input::-webkit-slider-runnable-track,
  .price-slider-input::-moz-range-track {
    background: none;
  }

  .price-slider-input-min {
    z-index: 2;
  }
  .price-slider-input-max {
    z-index: 3;
  }
  /* Trick: when min thumb is at the right end, raise its z-index so it stays grabbable */
  .price-slider-input-min[data-thumb-up="true"] {
    z-index: 4;
  }

  .price-slider-values {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    color: var(--color-gold-light);
    padding: 8px 4px 0;
  }

  .sidebar-clear {
    margin-top: 6px;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    align-self: center;
    padding: 6px 12px;
    transition: color var(--transition-fast);
  }
  .sidebar-clear:hover {
    color: var(--color-gold-light);
  }

  /* ── Mobile: drawer con backdrop ───────────────────────── */
  @media (max-width: 920px) {
    .sidebar-backdrop {
      display: block;
      z-index: 109;
    }
    body[data-sidebar-open="true"] .sidebar-backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: min(340px, 88vw);
      z-index: 110;
      transform: translateX(-100%);
      transition: transform var(--transition-default);
      border-radius: 0;
      overflow-y: auto;
      max-height: 100vh;
    }
    .sidebar[data-open="true"] {
      transform: translateX(0);
      box-shadow: 4px 0 30px rgba(0, 0, 0, 0.6);
    }

    .sidebar-mobile-header {
      display: flex;
    }
  }
</style>
