---
import { CONTACT, NAV_LINKS, SITE_METADATA } from "@/constants/ui";

const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.endsWith("/") && currentPath !== "/"
  ? currentPath.slice(0, -1)
  : currentPath;
const isCatalogPage = normalizedPath === "/catalogo";

const whatsappHref = `https://wa.me/${CONTACT.whatsappE164}`;

/** Entradas del menú que apuntan a un catálogo (?catalogo=…): se marcan
 *  activas en el navegador, porque la página se genera estática. */
function catalogOf(href: string): string | undefined {
  return new URL(href, "https://oudora.local").searchParams.get("catalogo") ?? undefined;
}

function isActive(href: string): boolean {
  if (href === "/") return normalizedPath === "/";
  return normalizedPath === href || normalizedPath.startsWith(`${href}/`);
}
---

<nav class="nav" aria-label="Navegación principal">
  <div class="nav-left">
  <button
    type="button"
    class="nav-icon-btn nav-hamburger"
    aria-label="Abrir menú"
    aria-expanded="false"
    data-mobile-menu-toggle
  >
    <svg class="hamburger-icon-open" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <line x1="4" y1="7" x2="20" y2="7" />
      <line x1="4" y1="12" x2="20" y2="12" />
      <line x1="4" y1="17" x2="20" y2="17" />
    </svg>
    <svg class="hamburger-icon-close" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <line x1="6" y1="6" x2="18" y2="18" />
      <line x1="18" y1="6" x2="6" y2="18" />
    </svg>
  </button>
  <button
    type="button"
    class="nav-icon-btn nav-search"
    aria-label="Buscar fragancia"
    data-search-trigger
  >
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="11" cy="11" r="7" />
      <line x1="16.5" y1="16.5" x2="21" y2="21" stroke-linecap="round" />
    </svg>
    <span class="nav-search-label" aria-hidden="true">Buscar</span>
  </button>
  </div>

  <a href="/" class="nav-logo" aria-label={`${SITE_METADATA.name} inicio`}>
    Oud<span class="nav-logo-accent">ora</span>
  </a>

  <ul class="nav-menu" role="menubar">
    {
      NAV_LINKS.map((link) => (
        <li role="none">
          <a
            href={link.href}
            role="menuitem"
            class={isActive(link.href) ? "active" : ""}
            aria-current={isActive(link.href) ? "page" : undefined}
            data-nav-catalog={catalogOf(link.href)}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="nav-icons">
    {isCatalogPage && (
      <button
        type="button"
        class="nav-filter-toggle"
        aria-label="Filtros"
        aria-expanded="false"
        data-sidebar-toggle
      >
        <svg class="filter-icon-open" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="7" y1="12" x2="17" y2="12" />
          <line x1="10" y1="17" x2="14" y2="17" />
        </svg>
        <svg class="filter-icon-close" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="18" y1="6" x2="6" y2="18" />
        </svg>
      </button>
    )}
    <a
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class="nav-icon-btn nav-whatsapp"
      aria-label="Escribinos por WhatsApp"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 20l1.3-3.9A8 8 0 1 1 8 19l-4 1Z" />
      </svg>
    </a>
    <button type="button" class="nav-icon-btn" aria-label="Ver carrito" data-cart-button>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 7h12l-1 13H7L6 7Z" />
        <path d="M9 7a3 3 0 0 1 6 0" />
      </svg>
      <span class="nav-cart-count" data-cart-count hidden>0</span>
    </button>
  </div>
</nav>

<div class="mobile-menu-overlay" data-mobile-menu aria-hidden="true" inert>
  <div class="mobile-menu-panel">
    <ul class="mobile-menu-list">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class={isActive(link.href) ? "active" : ""}
              aria-current={isActive(link.href) ? "page" : undefined}
              data-nav-catalog={catalogOf(link.href)}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mobile-menu-footer">
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-menu-cta"
      >
        Escribinos por WhatsApp
      </a>
      <div class="mobile-menu-social">
        <a href={CONTACT.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href={CONTACT.tiktokUrl} target="_blank" rel="noopener noreferrer">TikTok</a>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    const toggle = document.querySelector<HTMLButtonElement>(
      "[data-mobile-menu-toggle]",
    );
    const overlay = document.querySelector<HTMLDivElement>(
      "[data-mobile-menu]",
    );
    if (toggle === null || overlay === null) return;

    function setOpen(open: boolean): void {
      toggle!.setAttribute("aria-expanded", open ? "true" : "false");
      overlay!.setAttribute("aria-hidden", open ? "false" : "true");
      // inert: con el menú cerrado sus links no reciben foco con Tab.
      overlay!.inert = !open;
      document.body.style.overflow = open ? "hidden" : "";
    }

    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      setOpen(!isOpen);
    });

    overlay.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target === overlay || target.tagName === "A") {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
      }
    });
  })();
</script>

<script>
  import { DEFAULT_CATALOG } from "@/constants/ui";

  // En /catalogo, marcar como activa la entrada del catálogo que se está
  // viendo (por la URL al cargar, y al cambiar de pestaña).
  function syncCatalogNav(catalog: string): void {
    document
      .querySelectorAll<HTMLAnchorElement>("[data-nav-catalog]")
      .forEach((link) => {
        const isActive = link.dataset.navCatalog === catalog;
        link.classList.toggle("active", isActive);
        if (isActive) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      });
  }

  if (window.location.pathname.replace(/\/$/, "") === "/catalogo") {
    const fromUrl = new URLSearchParams(window.location.search).get("catalogo");
    syncCatalogNav(fromUrl ?? DEFAULT_CATALOG);
    window.addEventListener("catalog:change", (event) => {
      syncCatalogNav((event as CustomEvent<string>).detail);
    });
  }
</script>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: 14px clamp(16px, 4vw, 32px);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border-subtle);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-logo {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-cream);
    letter-spacing: var(--tracking-logo);
    /* El tracking deja espacio después de la última letra: lo compensamos
       a la izquierda para que el logo quede centrado ópticamente. */
    padding-left: var(--tracking-logo);
    text-transform: uppercase;
    font-weight: 400;
    white-space: nowrap;
  }
  /* "ORA" en dorado, en la misma serif recta que el resto (sin cursiva). */
  .nav-logo-accent {
    color: var(--color-gold);
  }

  .nav-menu {
    display: flex;
    gap: clamp(14px, 2.5vw, 28px);
    list-style: none;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--color-text-muted);
    font-weight: 500;
  }
  .nav-menu a {
    transition: color var(--transition-fast);
  }
  .nav-menu a:hover,
  .nav-menu a.active {
    color: var(--color-cream);
  }

  /* Desktop: logo centrado arriba e íconos a la derecha; el menú va en
     una segunda fila centrada (patrón de perfumerías de lujo). */
  @media (min-width: 721px) {
    .nav {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      grid-template-areas:
        "left logo icons"
        "menu menu menu";
      row-gap: var(--space-2);
      padding-bottom: 0;
    }
    .nav-left {
      grid-area: left;
      justify-self: start;
    }
    .nav-logo {
      grid-area: logo;
      font-size: var(--text-2xl);
    }
    .nav-icons {
      grid-area: icons;
      justify-self: end;
    }
    .nav-menu {
      grid-area: menu;
      justify-content: center;
      gap: var(--space-xl);
      font-size: var(--text-xs);
      font-weight: 600;
      color: var(--color-text);
    }
    .nav-menu a {
      display: inline-block;
      padding: var(--space-2) 0 var(--space-3);
      border-bottom: 1px solid transparent;
      transition: color var(--transition-fast), border-color var(--transition-fast);
    }
    .nav-menu a:hover,
    .nav-menu a.active {
      color: var(--color-cream);
      border-bottom-color: var(--color-gold);
    }
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .nav-search-label {
    margin-left: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .nav-icons {
    display: flex;
    gap: 8px;
    color: var(--color-cream);
    align-items: center;
  }
  .nav-icon-btn,
  .nav-filter-toggle {
    position: relative;
    padding: 8px;
    border-radius: var(--radius-circle);
    transition: background var(--transition-fast);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-cream);
    transition: color var(--transition-fast);
  }
  .nav-icon-btn:hover,
  .nav-filter-toggle:hover {
    color: var(--color-gold-light);
  }

  /* Hamburguesa: oculta en desktop, visible en mobile */
  .nav-hamburger {
    display: none;
  }
  .nav-hamburger .hamburger-icon-close {
    display: none;
  }
  .nav-hamburger[aria-expanded="true"] .hamburger-icon-open {
    display: none;
  }
  .nav-hamburger[aria-expanded="true"] .hamburger-icon-close {
    display: inline-block;
  }

  /* Toggle de íconos según estado del sidebar */
  .nav-filter-toggle .filter-icon-close {
    display: none;
  }
  .nav-filter-toggle[aria-expanded="true"] .filter-icon-open {
    display: none;
  }
  .nav-filter-toggle[aria-expanded="true"] .filter-icon-close {
    display: inline-block;
  }
  .nav-filter-toggle[aria-expanded="true"] {
    background: rgba(201, 168, 76, 0.18);
    color: var(--color-gold);
  }

  /* Cantidad al lado del ícono, como texto: "(2)". */
  .nav-cart-count {
    margin-left: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 500;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .nav-cart-count::before {
    content: "(";
  }
  .nav-cart-count::after {
    content: ")";
  }
  .nav-cart-count[hidden] {
    display: none;
  }

  /* El botón de filtros solo tiene sentido en mobile, donde el sidebar
     es un drawer. En desktop el sidebar es permanente. */
  .nav-filter-toggle {
    display: none;
  }
  @media (max-width: 920px) {
    .nav-filter-toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 720px) {
    .nav {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 8px;
      padding: 12px 16px;
    }
    .nav-menu {
      display: none;
    }
    .nav-hamburger {
      display: inline-flex;
    }
    .nav-left {
      justify-self: start;
    }
    /* En mobile: solo el ícono de buscar, y WhatsApp queda en el botón flotante. */
    .nav-search-label,
    .nav-whatsapp {
      display: none;
    }
    .nav-logo {
      font-size: var(--text-lg);
      letter-spacing: 0.28em;
      padding-left: 0.28em;
      grid-column: 2;
      justify-self: center;
    }
    .nav-icons {
      gap: 2px;
      justify-self: end;
    }
  }

  /* Menú mobile: panel a pantalla completa debajo del header (el header
     queda encima y su botón pasa a "cerrar"). Links grandes en serif. */
  .mobile-menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 99;
    background: var(--color-bg);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-default);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mobile-menu-overlay[aria-hidden="false"] {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu-panel {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-7);
    /* Deja libre el alto de la barra de avisos + header. */
    padding: 136px var(--space-5) var(--space-6);
    transform: translateY(-8px);
    transition: transform var(--transition-default);
  }
  .mobile-menu-overlay[aria-hidden="false"] .mobile-menu-panel {
    transform: none;
  }

  .mobile-menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .mobile-menu-list li {
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .mobile-menu-list a {
    display: block;
    padding: var(--space-4) 0;
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    line-height: 1.1;
    color: var(--color-cream);
    transition: color var(--transition-fast);
  }
  .mobile-menu-list a:hover,
  .mobile-menu-list a.active {
    color: var(--color-gold-light);
  }

  .mobile-menu-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .mobile-menu-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    background: var(--color-cream);
    color: var(--color-bg);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
  }
  .mobile-menu-social {
    display: flex;
    gap: var(--space-5);
    font-size: var(--text-sm);
  }
  .mobile-menu-social a {
    color: var(--color-text-muted);
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-overlay,
    .mobile-menu-panel {
      transition: none;
    }
  }

  /* En desktop el menú mobile no debe aparecer nunca */
  @media (min-width: 721px) {
    .mobile-menu-overlay {
      display: none;
    }
  }
</style>
