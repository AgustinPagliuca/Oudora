---
import { NAV_LINKS, SITE_METADATA } from "@/constants/ui";

const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.endsWith("/") && currentPath !== "/"
  ? currentPath.slice(0, -1)
  : currentPath;
const isCatalogPage = normalizedPath === "/catalogo";

function isActive(href: string): boolean {
  if (href === "/") return normalizedPath === "/";
  return normalizedPath === href || normalizedPath.startsWith(`${href}/`);
}
---

<nav class="nav" aria-label="Navegación principal">
  <button
    type="button"
    class="nav-icon-btn nav-hamburger"
    aria-label="Abrir menú"
    aria-expanded="false"
    data-mobile-menu-toggle
  >
    <svg class="hamburger-icon-open" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <line x1="4" y1="7" x2="20" y2="7" />
      <line x1="4" y1="12" x2="20" y2="12" />
      <line x1="4" y1="17" x2="20" y2="17" />
    </svg>
    <svg class="hamburger-icon-close" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <line x1="6" y1="6" x2="18" y2="18" />
      <line x1="18" y1="6" x2="6" y2="18" />
    </svg>
  </button>

  <a href="/" class="nav-logo" aria-label={`${SITE_METADATA.name} inicio`}>
    Oud<em>ora</em>
  </a>

  <ul class="nav-menu" role="menubar">
    {
      NAV_LINKS.map((link) => (
        <li role="none">
          <a
            href={link.href}
            role="menuitem"
            class={isActive(link.href) ? "active" : ""}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="nav-icons">
    {isCatalogPage && (
      <button
        type="button"
        class="nav-filter-toggle"
        aria-label="Filtros"
        aria-expanded="false"
        data-sidebar-toggle
      >
        <svg class="filter-icon-open" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="7" y1="12" x2="17" y2="12" />
          <line x1="10" y1="17" x2="14" y2="17" />
        </svg>
        <svg class="filter-icon-close" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="18" y1="6" x2="6" y2="18" />
        </svg>
      </button>
    )}
    <button
      type="button"
      class="nav-icon-btn"
      aria-label="Buscar fragancia"
      data-search-trigger
    >
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="11" cy="11" r="7" />
        <line x1="16.5" y1="16.5" x2="21" y2="21" stroke-linecap="round" />
      </svg>
    </button>
    <button type="button" class="nav-icon-btn" aria-label="Ver carrito" data-cart-button>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M6 7h12l-1.5 11a2 2 0 0 1-2 1.7H9.5a2 2 0 0 1-2-1.7L6 7z" stroke-linejoin="round" />
        <path d="M9 7V5a3 3 0 0 1 6 0v2" stroke-linecap="round" />
      </svg>
      <span class="nav-cart-count" data-cart-count hidden>0</span>
    </button>
  </div>
</nav>

<div class="mobile-menu-overlay" data-mobile-menu aria-hidden="true">
  <div class="mobile-menu-panel">
    <ul class="mobile-menu-list">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class={isActive(link.href) ? "active" : ""}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  (function () {
    const toggle = document.querySelector<HTMLButtonElement>(
      "[data-mobile-menu-toggle]",
    );
    const overlay = document.querySelector<HTMLDivElement>(
      "[data-mobile-menu]",
    );
    if (toggle === null || overlay === null) return;

    function setOpen(open: boolean): void {
      toggle!.setAttribute("aria-expanded", open ? "true" : "false");
      overlay!.setAttribute("aria-hidden", open ? "false" : "true");
      document.body.style.overflow = open ? "hidden" : "";
    }

    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      setOpen(!isOpen);
    });

    overlay.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target === overlay || target.tagName === "A") {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
      }
    });
  })();
</script>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: 14px clamp(16px, 4vw, 32px);
    background: var(--color-bg-deep);
    border-bottom: 0.5px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(6px);
  }

  .nav-logo {
    font-family: var(--font-serif);
    font-size: 24px;
    color: var(--color-gold-light);
    letter-spacing: 6px;
    text-transform: uppercase;
    font-weight: 400;
    white-space: nowrap;
  }
  .nav-logo em {
    color: var(--color-gold);
    font-style: italic;
  }

  .nav-menu {
    display: flex;
    gap: clamp(14px, 2.5vw, 28px);
    list-style: none;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .nav-menu a {
    transition: color var(--transition-fast);
  }
  .nav-menu a:hover,
  .nav-menu a.active {
    color: var(--color-gold-light);
  }

  .nav-icons {
    display: flex;
    gap: 8px;
    color: var(--color-gold-light);
    align-items: center;
  }
  .nav-icon-btn,
  .nav-filter-toggle {
    position: relative;
    padding: 8px;
    border-radius: var(--radius-circle);
    transition: background var(--transition-fast);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gold-light);
  }
  .nav-icon-btn:hover,
  .nav-filter-toggle:hover {
    background: rgba(201, 168, 76, 0.1);
  }

  /* Hamburguesa: oculta en desktop, visible en mobile */
  .nav-hamburger {
    display: none;
  }
  .nav-hamburger .hamburger-icon-close {
    display: none;
  }
  .nav-hamburger[aria-expanded="true"] .hamburger-icon-open {
    display: none;
  }
  .nav-hamburger[aria-expanded="true"] .hamburger-icon-close {
    display: inline-block;
  }

  /* Toggle de íconos según estado del sidebar */
  .nav-filter-toggle .filter-icon-close {
    display: none;
  }
  .nav-filter-toggle[aria-expanded="true"] .filter-icon-open {
    display: none;
  }
  .nav-filter-toggle[aria-expanded="true"] .filter-icon-close {
    display: inline-block;
  }
  .nav-filter-toggle[aria-expanded="true"] {
    background: rgba(201, 168, 76, 0.18);
    color: var(--color-gold);
  }

  .nav-cart-count {
    position: absolute;
    top: 2px;
    right: 2px;
    background: var(--color-gold);
    color: var(--color-bg);
    font-size: 11px;
    font-weight: 500;
    min-width: 18px;
    height: 18px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 5px;
  }
  .nav-cart-count[hidden] {
    display: none;
  }

  /* El botón de filtros solo tiene sentido en mobile, donde el sidebar
     es un drawer. En desktop el sidebar es permanente. */
  .nav-filter-toggle {
    display: none;
  }
  @media (max-width: 920px) {
    .nav-filter-toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 720px) {
    .nav {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 8px;
      padding: 12px 16px;
    }
    .nav-menu {
      display: none;
    }
    .nav-hamburger {
      display: inline-flex;
      justify-self: start;
    }
    .nav-logo {
      font-size: 20px;
      letter-spacing: 4px;
      grid-column: 2;
      justify-self: center;
    }
    .nav-icons {
      gap: 2px;
      justify-self: end;
    }
  }

  /* Menú mobile overlay */
  .mobile-menu-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    z-index: 99;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .mobile-menu-overlay[aria-hidden="false"] {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu-panel {
    position: absolute;
    top: 80px;
    left: 0;
    right: 0;
    background: var(--color-bg-deep);
    border-bottom: 0.5px solid var(--color-border);
    padding: 16px 20px 24px;
    transform: translateY(-12px);
    transition: transform 0.25s ease;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
  }
  .mobile-menu-overlay[aria-hidden="false"] .mobile-menu-panel {
    transform: translateY(0);
  }

  .mobile-menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mobile-menu-list a {
    display: block;
    padding: 14px 16px;
    font-size: 15px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
    transition: background var(--transition-fast), color var(--transition-fast);
    text-decoration: none;
  }
  .mobile-menu-list a:hover,
  .mobile-menu-list a.active {
    color: var(--color-gold-light);
    background: rgba(201, 168, 76, 0.08);
  }

  /* En desktop el menú mobile no debe aparecer nunca */
  @media (min-width: 721px) {
    .mobile-menu-overlay {
      display: none;
    }
  }
</style>
