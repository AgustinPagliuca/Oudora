---
import type { Gender } from "@/types/catalog";
import { GENDER_DESCRIPTIONS, GENDER_LABELS } from "@/constants/ui";

interface Props {
  gender: Gender;
}

const { gender } = Astro.props;
const label = GENDER_LABELS[gender];
const description = GENDER_DESCRIPTIONS[gender];
const imageSrc = `/collections/${gender}.jpg`;
---

<a class="collection-card" href={`/catalogo?gender=${gender}`} data-collection={gender}>
  <img src={imageSrc} alt={label} class="collection-bg" loading="lazy" />
  <div class="collection-overlay" aria-hidden="true"></div>
  <div class="collection-content">
    <h3 class="collection-title">{label}</h3>
    <span class="collection-btn">Ver más</span>
  </div>
</a>

<style>
  .collection-card {
    position: relative;
    aspect-ratio: 1 / 1.15;
    background: var(--color-bg-card);
    border: 0.5px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding: 22px 14px 18px;
    transition: all var(--transition-default);
    text-decoration: none;
  }
  .collection-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-gold);
  }

  .collection-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-default), filter var(--transition-default);
    filter: brightness(0.85) saturate(1.05);
  }
  .collection-card:hover .collection-bg {
    transform: scale(1.04);
    filter: brightness(1) saturate(1.15);
  }

  .collection-overlay {
    position: absolute;
    inset: 0;
    transition: opacity var(--transition-default);
  }

  .collection-content {
    position: relative;
    z-index: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 28px 12px 12px;
    width: 100%;
    margin: 0 -14px -18px;
  }

  .collection-title {
    font-family: var(--font-serif);
    font-size: 22px;
    color: var(--color-cream);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    font-weight: 400;
  }

  .collection-btn {
    margin-top: 8px;
    padding: 8px 18px;
    border: 0.5px solid var(--color-gold);
    background: rgba(0, 0, 0, 0.5);
    color: var(--color-gold-light);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    border-radius: var(--radius-pill);
  }
</style>
