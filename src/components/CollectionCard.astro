---
import type { Gender } from "@/types/catalog";
import { GENDER_LABELS } from "@/constants/ui";

interface Props {
  gender: Gender;
}

const { gender } = Astro.props;
const label = GENDER_LABELS[gender];
const imageSrc = `/collections/${gender}.jpg`;
---

<a class="collection-card" href={`/catalogo?gender=${gender}`} data-collection={gender}>
  <img src={imageSrc} alt="" class="collection-bg" loading="lazy" />
  <h3 class="collection-title">{label}</h3>
  <span class="collection-btn">Ver fragancias</span>
</a>

<style>
  /* Imagen editorial limpia con el título debajo: sin texto ni velo
     encima de la foto. El hover solo cambia el color del título. */
  .collection-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
  }

  .collection-bg {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    margin-bottom: var(--space-2);
  }

  .collection-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-cream);
    font-weight: 400;
    transition: color var(--transition-fast);
  }
  .collection-card:hover .collection-title {
    color: var(--color-gold-light);
  }

  .collection-btn {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--color-text-muted);
    border-bottom: 1px solid currentColor;
    padding-bottom: var(--space-1);
  }
</style>
