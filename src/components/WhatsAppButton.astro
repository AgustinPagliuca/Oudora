---
import { CONTACT } from "@/constants/ui";

const prefilledMessage = encodeURIComponent(
  "Hola! Vi su sitio y me gustaría hacer una consulta sobre los perfumes."
);
const href = `https://wa.me/${CONTACT.whatsappE164}?text=${prefilledMessage}`;
---

<div class="whatsapp-fab-wrapper">
  <div class="whatsapp-tip" data-whatsapp-tip>
    <button
      type="button"
      class="whatsapp-tip-close"
      data-whatsapp-tip-close
      aria-label="Cerrar mensaje"
    >
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <line x1="6" y1="6" x2="18" y2="18" />
        <line x1="18" y1="6" x2="6" y2="18" />
      </svg>
    </button>
    <p class="whatsapp-tip-text">
      <span class="whatsapp-tip-greeting">¡Hola!</span>
      ¿Tenés dudas sobre qué perfume es para vos?
      <strong>Por WhatsApp te asesoramos! 🙋‍♂️</strong>
    </p>
  </div>

  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class="whatsapp-fab"
    aria-label="Contactar por WhatsApp"
  >
    <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
    </svg>
  </a>
</div>

<script>
  // Cerrar el tip al hacer click en la X. Sin persistencia: si la persona
  // recarga la página, el tip vuelve a aparecer (criterio de simplicidad —
  // si más adelante molesta, sumamos localStorage).
  function initWhatsAppTip(): void {
    const closeBtn = document.querySelector<HTMLButtonElement>(
      "[data-whatsapp-tip-close]",
    );
    const tip = document.querySelector<HTMLElement>("[data-whatsapp-tip]");
    if (closeBtn === null || tip === null) return;
    closeBtn.addEventListener("click", () => {
      tip.classList.add("is-dismissed");
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWhatsAppTip, { once: true });
  } else {
    initWhatsAppTip();
  }
</script>

<style>
  /* Wrapper: contiene botón + tip, los dos en el mismo rincón fixed */
  .whatsapp-fab-wrapper {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 90;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .whatsapp-fab {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25d366;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    animation: whatsapp-pulse 2.5s ease-in-out infinite;
    flex-shrink: 0;
  }
  .whatsapp-fab:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 22px rgba(37, 211, 102, 0.5);
    animation: none;
  }
  .whatsapp-fab:active {
    transform: scale(0.98);
  }

  @keyframes whatsapp-pulse {
    0%, 100% {
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35),
                  0 0 0 0 rgba(37, 211, 102, 0.45);
    }
    50% {
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35),
                  0 0 0 12px rgba(37, 211, 102, 0);
    }
  }

  /* ── Tip: bocadillo a la izquierda del botón ───────────────────── */
  .whatsapp-tip {
    position: relative;
    max-width: 230px;
    padding: 10px 14px;
    background: #4d3f2c;
    border: 0.5px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    /* Dos animaciones que no se pisan: la entrada anima `opacity`, el
       bounce anima `transform`. Bounce arranca cuando termina la entrada. */
    opacity: 0;
    animation:
      whatsapp-tip-in 0.5s var(--ease-premium) 0.3s forwards,
      whatsapp-tip-bounce 2.5s ease-in-out 0.8s infinite;
  }
  .whatsapp-tip.is-dismissed {
    animation: whatsapp-tip-out 0.25s var(--ease-premium) forwards;
    pointer-events: none;
  }

  /* Tail/punta del bocadillo apuntando al botón WA (a la derecha) */
  .whatsapp-tip::after {
    content: "";
    position: absolute;
    right: -6px;
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
    width: 10px;
    height: 10px;
    background: #4d3f2c;
    border-right: 0.5px solid rgba(255, 255, 255, 0.08);
    border-top: 0.5px solid rgba(255, 255, 255, 0.08);
  }

  .whatsapp-tip-text {
    font-size: var(--text-xs);
    line-height: 1.4;
    color: var(--color-cream);
    margin: 0;
  }
  /* "¡Hola!" en bold pero del mismo color que el resto del texto */
  .whatsapp-tip-greeting {
    font-weight: 600;
    margin-right: 2px;
  }
  .whatsapp-tip-text strong {
    display: block;
    margin-top: 2px;
    color: #ffffff;
    font-weight: 600;
  }

  .whatsapp-tip-close {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 20px;
    height: 20px;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .whatsapp-tip-close:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  @keyframes whatsapp-tip-in {
    to { opacity: 1; }
  }
  @keyframes whatsapp-tip-out {
    to { opacity: 0; transform: translateY(6px); }
  }
  @keyframes whatsapp-tip-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }

  /* ── Mobile: tip arriba del botón en vez de a la izquierda ──────── */
  @media (max-width: 720px) {
    .whatsapp-fab-wrapper {
      bottom: 16px;
      right: 16px;
      /* En mobile el tip va arriba del botón, no al costado */
      flex-direction: column;
      align-items: flex-end;
      gap: 8px;
    }
    .whatsapp-fab {
      width: 52px;
      height: 52px;
    }
    .whatsapp-fab svg {
      width: 26px;
      height: 26px;
    }
    .whatsapp-tip {
      max-width: 200px;
      padding: 9px 11px 9px 12px;
    }
    /* La punta ahora apunta hacia ABAJO al botón */
    .whatsapp-tip::after {
      right: 18px;
      top: auto;
      bottom: -6px;
      transform: rotate(45deg);
      background: #4d3f2c;
      border-right: 0.5px solid rgba(255, 255, 255, 0.08);
      border-bottom: 0.5px solid rgba(255, 255, 255, 0.08);
      border-top: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-fab {
      animation: none;
    }
    .whatsapp-tip {
      opacity: 1;
      animation: none;
    }
    .whatsapp-tip.is-dismissed {
      animation: none;
      opacity: 0;
      visibility: hidden;
    }
  }
</style>
