---
import type { Product } from "@/types/catalog";
import { getBrandById } from "@/data/brands";
import ProductCard from "@/components/ProductCard.astro";

interface Props {
  title: string;
  highlight?: string;
  products: readonly Product[];
}

const { title, highlight, products } = Astro.props;
const visibleProducts = products.slice(0, 8);
---

<section class="featured">
  <header class="featured-header" data-reveal>
    <h2 class="featured-title">
      {title}
      {highlight && <em>{highlight}</em>}
    </h2>
    <a href="/catalogo" class="featured-link">Ver todo el catálogo →</a>
  </header>

  <div class="featured-grid">
    {
      visibleProducts.map((product) => {
        const brand = getBrandById(product.brandId);
        if (brand === undefined) return null;
        return (
          <div data-reveal>
            <ProductCard product={product} brand={brand} />
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .featured {
    padding: var(--space-7) clamp(16px, 4vw, 32px) var(--space-6);
    max-width: var(--max-content-width);
    margin: 0 auto;
  }

  .featured-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .featured-title {
    font-family: var(--font-serif);
    font-size: clamp(22px, 3vw, 28px);
    color: var(--surface-text, var(--color-cream));
    letter-spacing: var(--tracking-tight);
    font-weight: 400;
    line-height: 1.1;
  }
  .featured-title em {
    color: var(--surface-accent, var(--color-gold));
    font-style: italic;
  }

  /* Link "Ver todo el catálogo" ahora con subrayado dorado sutil — comunica
     mejor "esto es clickeable" sin romper la jerarquía. */
  .featured-link {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--surface-accent, var(--color-gold));
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
    transition: color var(--transition-fast);
  }
  .featured-link:hover {
    color: var(--surface-text, var(--color-cream));
  }

  /* Columnas fluidas: ocupan todo el ancho (4 en desktop) en vez de quedar
     fijas a 230px con un hueco a la derecha. */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    column-gap: var(--space-4);
    row-gap: var(--space-6);
  }

  @media (max-width: 640px) {
    .featured-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
