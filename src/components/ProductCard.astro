---
import type { Brand, Product } from "@/types/catalog";
import { formatArs, formatPresentation } from "@/lib/format";
import { getStockLabel } from "@/lib/grouping";
import PerfumeBottle from "@/components/PerfumeBottle.astro";
import ProductLabels from "@/components/ProductLabels.astro";

interface Props {
  product: Product;
  brand: Brand;
}

const { product, brand } = Astro.props;
const stockLabel = getStockLabel(product.stock);
const presentation = formatPresentation(product.concentration, product.volumeMl);
const formattedPrice = formatArs(product.priceArs);
const detailHref = `/producto/${product.slug}`;
const variant = product.gender === "femenino"
  ? "warm"
  : product.gender === "masculino"
    ? "default"
    : "deep";
const searchText =
  `${product.name} ${brand.name} ${product.concentration} ${(product.notes ?? []).join(" ")}`.toLowerCase();

// Si el producto tiene al menos una imagen subida, usamos la primera (la portada).
// Sino caemos al SVG genérico con el nombre escrito.
const coverImage = product.images?.[0]?.url ?? product.imageUrl;

// Hint visible para el sort: ¿el producto está marcado como destacado o tiene
// alguna etiqueta de descuento (color rojo)? Las leemos como data-attrs para
// que el catalog-controller pueda reordenar sin recalcular nada.
const hasDiscountLabel = (product.labels ?? []).some(
  (label) => label.color === "red",
);
---

<article
  class="product-card"
  data-product-card
  data-product-id={product.id}
  data-brand={product.brandId}
  data-catalog={product.catalog}
  data-gender={product.gender}
  data-price={product.priceArs}
  data-featured={product.featured ? "true" : "false"}
  data-has-discount={hasDiscountLabel ? "true" : "false"}
  data-search-text={searchText}
>
  <a class="product-image" href={detailHref} aria-label={`Ver detalle de ${product.name}`}>
    <ProductLabels labels={product.labels} />
    {
      coverImage !== undefined ? (
        <img
          src={coverImage}
          alt={`${brand.name} ${product.name}`}
          class="product-image-real"
          loading="lazy"
        />
      ) : (
        <PerfumeBottle
          label={product.name.length <= 10 ? product.name : undefined}
          variant={variant}
          size="md"
          ariaLabel={`${brand.name} ${product.name}`}
        />
      )
    }
    {stockLabel && <span class="product-stock">{stockLabel}</span>}
  </a>

  <div class="product-body">
    <p class="product-brand">
      <a href={`/marcas/${brand.slug}`}>{brand.name}</a>
    </p>
    <h3 class="product-name">
      <a href={detailHref}>{product.name}</a>
    </h3>
    <p class="product-presentation">{presentation}</p>

    <div class="product-footer">
      <p class="product-price">{formattedPrice}</p>
      <button
        type="button"
        class="product-add"
        data-add-to-cart
        data-product-id={product.id}
        aria-label={`Agregar ${product.name} al carrito`}
      >
        Agregar
      </button>
    </div>
  </div>
</article>

<style>
  /* Card sin caja: la foto sobre blanco puro y el texto centrado debajo,
     directamente sobre el fondo de la página (patrón de perfumerías de
     lujo). Sin bordes ni sombras; los hovers solo cambian color. */
  .product-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    height: 100%;
    position: relative;
  }

  .product-image {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 4 / 5;
    /* Blanco puro igual que el fondo de la foto del producto, así no se nota
       el "cuadrado" de la imagen. */
    background: #ffffff;
    position: relative;
    overflow: hidden;
    padding: var(--space-5);
    box-sizing: border-box;
    color: inherit;
  }

  .product-image-real {
    width: 100%;
    height: 100%;
    object-fit: contain;
    position: relative;
    z-index: 0;
  }

  .product-stock {
    position: absolute;
    bottom: var(--space-2);
    left: 50%;
    translate: -50% 0;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-cream);
    background: var(--color-bg-deep);
    padding: var(--space-1) var(--space-2);
    white-space: nowrap;
    z-index: 2;
  }

  .product-body {
    width: 100%;
    padding: var(--space-4) var(--space-1) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    flex: 1;
  }

  .product-brand a {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-base);
    color: var(--surface-muted, var(--color-text-muted));
    transition: color var(--transition-fast);
  }
  .product-brand a:hover {
    color: var(--surface-accent, var(--color-gold-light));
  }

  .product-name {
    line-height: 1.3;
  }
  .product-name a {
    font-size: 14px;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--surface-text, var(--color-cream));
    font-weight: 600;
    text-wrap: balance;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /* Reserva 2 líneas para que precios y botones queden alineados entre
       cards aunque el nombre ocupe una sola. */
    min-height: 2.6em;
    transition: color var(--transition-fast);
  }
  .product-name a:hover {
    color: var(--surface-accent, var(--color-gold-light));
  }

  .product-presentation {
    font-size: var(--text-sm);
    color: var(--surface-faint, var(--color-text-faint));
  }

  .product-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .product-price {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--surface-text, var(--color-cream));
    line-height: 1;
    font-weight: 600;
    font-variant-numeric: tabular-nums lining-nums;
  }

  /* Botón rectangular con borde; en hover se rellena (cambio de color). */
  .product-add {
    min-height: 40px;
    padding: 0 var(--space-5);
    background: transparent;
    border: 1px solid var(--surface-muted, var(--color-text-muted));
    color: var(--surface-text, var(--color-cream));
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--transition-fast),
                color var(--transition-fast),
                border-color var(--transition-fast);
  }
  .product-add:hover {
    background: var(--surface-text, var(--color-cream));
    border-color: var(--surface-text, var(--color-cream));
    color: var(--surface-bg, var(--color-bg));
  }
  .product-add:focus-visible {
    outline: 2px solid var(--surface-accent, var(--color-gold-light));
    outline-offset: 2px;
  }

  /* En mobile las cards son angostas: botón a todo el ancho. */
  @media (max-width: 640px) {
    .product-footer {
      align-self: stretch;
    }
    .product-add {
      width: 100%;
      padding: 0 var(--space-2);
    }
  }
</style>
