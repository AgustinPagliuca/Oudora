---
import type { Brand, Product } from "@/types/catalog";
import { formatArs, formatPresentation } from "@/lib/format";
import { getStockLabel } from "@/lib/grouping";
import PerfumeBottle from "@/components/PerfumeBottle.astro";
import ProductLabels from "@/components/ProductLabels.astro";

interface Props {
  product: Product;
  brand: Brand;
}

const { product, brand } = Astro.props;
const stockLabel = getStockLabel(product.stock);
const presentation = formatPresentation(product.concentration, product.volumeMl);
const formattedPrice = formatArs(product.priceArs);
const detailHref = `/producto/${product.slug}`;
const variant = product.gender === "femenino"
  ? "warm"
  : product.gender === "masculino"
    ? "default"
    : "deep";
const searchText =
  `${product.name} ${brand.name} ${product.concentration} ${(product.notes ?? []).join(" ")}`.toLowerCase();

// Si el producto tiene al menos una imagen subida, usamos la primera (la portada).
// Sino caemos al SVG genérico con el nombre escrito.
const coverImage = product.images?.[0]?.url ?? product.imageUrl;

// Hint visible para el sort: ¿el producto está marcado como destacado o tiene
// alguna etiqueta de descuento (color rojo)? Las leemos como data-attrs para
// que el catalog-controller pueda reordenar sin recalcular nada.
const hasDiscountLabel = (product.labels ?? []).some(
  (label) => label.color === "red",
);
---

<article
  class="product-card"
  data-product-card
  data-product-id={product.id}
  data-brand={product.brandId}
  data-catalog={product.catalog}
  data-gender={product.gender}
  data-price={product.priceArs}
  data-featured={product.featured ? "true" : "false"}
  data-has-discount={hasDiscountLabel ? "true" : "false"}
  data-search-text={searchText}
>
  <a class="product-image" href={detailHref} aria-label={`Ver detalle de ${product.name}`}>
    <ProductLabels labels={product.labels} />
    {
      coverImage !== undefined ? (
        <img
          src={coverImage}
          alt={`${brand.name} ${product.name}`}
          class="product-image-real"
          loading="lazy"
        />
      ) : (
        <PerfumeBottle
          label={product.name.length <= 10 ? product.name : undefined}
          variant={variant}
          size="md"
          ariaLabel={`${brand.name} ${product.name}`}
        />
      )
    }
    {stockLabel && <span class="product-stock">{stockLabel}</span>}
  </a>

  <div class="product-body">
    <p class="product-brand">
      <a href={`/marcas/${brand.slug}`}>{brand.name}</a>
    </p>
    <h3 class="product-name">
      <a href={detailHref}>{product.name}</a>
    </h3>
    <p class="product-presentation">{presentation}</p>

    <div class="product-footer">
      <p class="product-price">{formattedPrice}</p>
      <button
        type="button"
        class="product-add"
        data-add-to-cart
        data-product-id={product.id}
        aria-label={`Agregar ${product.name} al carrito`}
      >
        Agregar
      </button>
    </div>
  </div>
</article>

<style>
  .product-card {
    background: var(--color-bg-card);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
    /* Hairline dorado en el borde superior — da definición sin necesitar un
       borde completo. En dark themes esto sustituye con elegancia al border. */
    box-shadow: var(--elev-1);
    transition: transform var(--transition-default),
                box-shadow var(--transition-default);
  }
  .product-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--elev-3);
  }

  .product-image {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1 / 1;
    /* Blanco puro igual que el fondo de la foto del producto, así no se nota
       el "cuadrado" de la imagen. */
    background: #ffffff;
    position: relative;
    overflow: hidden;
    padding: 14px;
    box-sizing: border-box;
    color: inherit;
  }

  .product-image-real {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 4px;
    position: relative;
    z-index: 0;
  }

  .product-stock {
    position: absolute;
    bottom: 10px;
    right: 10px;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-gold-light);
    background: rgba(0, 0, 0, 0.6);
    padding: 4px 10px;
    border-radius: 10px;
    z-index: 2;
  }

  .product-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .product-brand a {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-normal);
    transition: color var(--transition-fast);
  }
  .product-brand a:hover {
    color: var(--color-gold-light);
  }

  .product-name {
    line-height: 1.3;
    margin-top: 2px;
  }
  .product-name a {
    font-size: 14px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-cream);
    font-weight: 500;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 38px;
    transition: color var(--transition-fast);
  }
  .product-name a:hover {
    color: var(--color-gold-light);
  }

  .product-presentation {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-uppercase);
    color: var(--color-text-faint);
    text-transform: uppercase;
    margin-top: 4px;
  }

  .product-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 14px;
    gap: 8px;
  }

  .product-price {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-cream);
    letter-spacing: var(--tracking-tight);
    line-height: 1;
    font-weight: 500;
    font-variant-numeric: tabular-nums lining-nums;
    font-feature-settings: "tnum" 1, "lnum" 1;
  }

  /* ── Botón "Agregar" con signature fill animation ────────────────
     Outline gold en reposo. En hover, un pseudo-elemento ::before se
     desliza de izquierda a derecha rellenando el botón con dorado sólido,
     y el texto pasa de dorado a cocoa oscuro para mantener contraste.
     Es el único hover "expresivo" del sitio — todo lo demás es funcional.
     Easing premium (cubic-bezier 0.4, 0, 0.2, 1) en 350ms. */
  .product-add {
    position: relative;
    background: transparent;
    border: 0.5px solid var(--color-gold);
    color: var(--color-gold);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    padding: 9px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    flex-shrink: 0;
    transition: color 0.35s var(--ease-premium);
  }
  .product-add::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-gold);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.35s var(--ease-premium);
    z-index: -1;
  }
  .product-add:hover {
    color: var(--color-bg);
  }
  .product-add:hover::before {
    clip-path: inset(0 0 0 0);
  }
  .product-add:active {
    transform: scale(0.96);
  }

  /* En mobile las cards son muy angostas para precio + botón en fila */
  @media (max-width: 640px) {
    .product-footer {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }
    .product-price {
      font-size: var(--text-base);
      text-align: start;
    }
    .product-add {
      width: 100%;
      text-align: center;
      padding: 10px 12px;
    }
  }
</style>
