---
import type { Brand, Product } from "@/types/catalog";
import ProductCard from "./ProductCard.astro";

interface Props {
  brand: Brand;
  products: readonly Product[];
}

const { brand, products } = Astro.props;
---

<section
  class="brand-section"
  data-brand-section
  data-brand={brand.id}
  data-catalog={brand.catalog}
>
  <header class="brand-header">
    <h2 class="brand-name">{brand.name}</h2>
    <span class="brand-line" aria-hidden="true"></span>
    <span class="brand-count" data-brand-count>{products.length} piezas</span>
  </header>

  <div class="product-grid" data-reveal-stagger>
    {products.map((product) => (
      <div data-reveal>
        <ProductCard product={product} brand={brand} />
      </div>
    ))}
  </div>
</section>

<style>
  .brand-section {
    margin-bottom: var(--space-6);
  }

  .brand-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding: 0 4px;
  }

  /* Marca = título serif italic. Antes tenía letter-spacing 3px que estiraba
     demasiado el serif. Tracking tight queda más cohesionado y editorial. */
  .brand-name {
    font-family: var(--font-serif);
    font-size: clamp(20px, 3vw, 26px);
    font-weight: 400;
    letter-spacing: var(--tracking-tight);
    color: var(--color-cream);
    white-space: nowrap;
    font-style: italic;
  }

  /* Línea dorada que conecta nombre con count, da estructura editorial. */
  .brand-line {
    flex: 1;
    height: 0.5px;
    background: linear-gradient(
      to right,
      rgba(201, 168, 76, 0.4),
      rgba(201, 168, 76, 0.05)
    );
    align-self: center;
  }

  .brand-count {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-uppercase);
    color: var(--color-text-muted);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 230px));
    gap: var(--space-4);
    justify-content: start;
  }

  @media (max-width: 480px) {
    .product-grid {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    }
  }
</style>
