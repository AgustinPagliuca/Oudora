---
/**
 * Panel lateral del carrito.
 * El contenido se renderiza dinámicamente desde cart-controller.ts.
 * Acá definimos solo el contenedor, el header y los slots de datos.
 */
---

<aside
  class="cart-drawer"
  aria-label="Carrito de compras"
  aria-hidden="true"
  data-cart-drawer
>
  <div class="cart-drawer-backdrop" data-cart-backdrop></div>

  <div class="cart-drawer-panel" role="dialog" aria-modal="true" aria-labelledby="cart-title">
    <header class="cart-drawer-header">
      <h2 class="cart-drawer-title" id="cart-title">Tu carrito</h2>
      <button
        type="button"
        class="cart-drawer-close"
        aria-label="Cerrar carrito"
        data-cart-close
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="18" y1="6" x2="6" y2="18" />
        </svg>
      </button>
    </header>

    <div class="cart-drawer-body">
      <div class="cart-empty" data-cart-empty>
        <svg
          class="cart-empty-icon"
          width="40"
          height="40"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 2 L3 6 v14 a2 2 0 0 0 2 2 h14 a2 2 0 0 0 2 -2 V6 l-3 -4 z" />
          <line x1="3" y1="6" x2="21" y2="6" />
          <path d="M16 10 a4 4 0 0 1 -8 0" />
        </svg>
        <p class="cart-empty-title">Tu carrito está vacío</p>
        <p class="cart-empty-subtitle">
          Explorá el catálogo y sumá tus fragancias favoritas.
        </p>
        <a href="/catalogo" class="cart-empty-action" data-cart-empty-action>
          Ver el catálogo
        </a>
      </div>

      <ul class="cart-lines" data-cart-lines hidden></ul>
    </div>

    <footer class="cart-drawer-footer" data-cart-footer hidden>
      <div class="cart-total">
        <span class="cart-total-label">Total</span>
        <span class="cart-total-amount" data-cart-total>$ 0</span>
      </div>
      <p class="cart-disclaimer">
        Para iniciar la compra, deberás completar tus datos de contacto. Al finalizar, se abrirá WhatsApp
        con el pedido para que el vendedor te confirme stock y forma de pago.
      </p>
      <div class="cart-cta-row">
        <button
          type="button"
          class="cart-continue"
          data-cart-continue
        >
          Seguir comprando
        </button>
        <a
          class="cart-checkout"
          href="/checkout"
          data-cart-checkout
        >
          Iniciar compra
        </a>
      </div>
      <button
        type="button"
        class="cart-clear"
        data-cart-clear
        data-confirming="false"
      >
        <span data-cart-clear-label>Vaciar carrito</span>
      </button>
    </footer>
  </div>
</aside>

<template id="cart-line-template">
  <li class="cart-line">
    <div class="cart-line-info">
      <p class="cart-line-brand" data-line-brand></p>
      <p class="cart-line-name" data-line-name></p>
      <p class="cart-line-pres" data-line-pres></p>
    </div>
    <div class="cart-line-actions">
      <div class="cart-qty">
        <button type="button" data-line-decrease aria-label="Disminuir cantidad">−</button>
        <span data-line-qty>1</span>
        <button type="button" data-line-increase aria-label="Aumentar cantidad">+</button>
      </div>
      <p class="cart-line-total" data-line-total></p>
      <button
        type="button"
        class="cart-line-remove"
        data-line-remove
        aria-label="Quitar del carrito"
      >
        Quitar
      </button>
    </div>
  </li>
</template>

<style>
  /* Carrito: panel lateral con el fondo de la página, líneas finas entre
     productos y botones rectangulares (estilo editorial del rediseño). */
  .cart-drawer {
    position: fixed;
    inset: 0;
    z-index: 1000;
    pointer-events: none;
  }
  .cart-drawer[aria-hidden="false"] {
    pointer-events: auto;
  }

  .cart-drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    opacity: 0;
    transition: opacity var(--transition-default);
  }
  .cart-drawer[aria-hidden="false"] .cart-drawer-backdrop {
    opacity: 1;
  }

  .cart-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(440px, 100vw);
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    border-left: 1px solid var(--color-border-subtle);
    transform: translateX(100%);
    transition: transform var(--transition-default);
  }
  .cart-drawer[aria-hidden="false"] .cart-drawer-panel {
    transform: translateX(0);
  }

  .cart-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5);
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .cart-drawer-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 400;
    color: var(--color-cream);
  }
  .cart-drawer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--color-cream);
    transition: color var(--transition-fast);
  }
  .cart-drawer-close:hover {
    color: var(--color-gold-light);
  }

  .cart-drawer-body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 var(--space-5);
  }

  /* Carrito vacío */
  .cart-empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-7) 0;
  }
  /* Sin esto, display: flex ganaba a [hidden] y se mostraba con productos. */
  .cart-empty[hidden] {
    display: none;
  }
  .cart-empty-icon {
    display: none;
  }
  .cart-empty-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-cream);
  }
  .cart-empty-subtitle {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .cart-empty-action {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    margin-top: var(--space-3);
    padding: 0 var(--space-6);
    background: var(--color-cream);
    color: var(--color-bg);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    transition: background-color var(--transition-fast);
  }
  .cart-empty-action:hover {
    background: var(--color-gold-light);
  }

  /* Líneas del carrito */
  .cart-lines {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cart-line {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .cart-line-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }
  .cart-line-brand {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .cart-line-name {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    line-height: 1.3;
    color: var(--color-cream);
  }
  .cart-line-pres {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  .cart-line-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-3);
  }
  .cart-qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-text-muted);
  }
  .cart-qty button {
    width: 36px;
    height: 36px;
    font-size: var(--text-md);
    color: var(--color-cream);
    transition: color var(--transition-fast);
  }
  .cart-qty button:hover {
    color: var(--color-gold-light);
  }
  .cart-qty span {
    min-width: 24px;
    text-align: center;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-cream);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .cart-line-total {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-cream);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .cart-line-remove {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition-fast);
  }
  .cart-line-remove:hover {
    color: var(--color-cream);
  }

  /* Pie: total y acciones */
  .cart-drawer-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
    border-top: 1px solid var(--color-border-subtle);
  }
  .cart-drawer-footer[hidden] {
    display: none;
  }
  .cart-total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .cart-total-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .cart-total-amount {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-cream);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .cart-disclaimer {
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .cart-cta-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }
  .cart-continue,
  .cart-checkout {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    text-align: center;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }
  .cart-continue {
    border: 1px solid var(--color-text-muted);
    color: var(--color-cream);
  }
  .cart-continue:hover {
    background: var(--color-cream);
    color: var(--color-bg);
  }
  .cart-checkout {
    background: var(--color-cream);
    color: var(--color-bg);
  }
  .cart-checkout:hover {
    background: var(--color-gold-light);
  }
  .cart-checkout[aria-disabled="true"] {
    opacity: 0.45;
    pointer-events: none;
  }

  @media (max-width: 360px) {
    .cart-cta-row {
      grid-template-columns: 1fr;
    }
  }

  .cart-clear {
    align-self: center;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    border: 1px solid transparent;
    transition: color var(--transition-fast);
  }
  .cart-clear:hover {
    color: var(--color-cream);
  }
  /* Segundo click para confirmar: aviso en rojo suave (mismos valores
     que antes; no hay token de color de error). */
  .cart-clear[data-confirming="true"] {
    color: #ffb3b3;
    border-color: rgba(200, 70, 70, 0.5);
    text-decoration: none;
  }

  .cart-drawer-close:focus-visible,
  .cart-continue:focus-visible,
  .cart-checkout:focus-visible,
  .cart-empty-action:focus-visible,
  .cart-qty button:focus-visible {
    outline: 2px solid var(--color-gold-light);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-drawer-panel,
    .cart-drawer-backdrop {
      transition: none;
    }
  }
</style>
