---
/**
 * Panel lateral del carrito.
 * El contenido se renderiza dinámicamente desde cart-controller.ts.
 * Acá definimos solo el contenedor, el header y los slots de datos.
 */
---

<aside
  class="cart-drawer"
  aria-label="Carrito de compras"
  aria-hidden="true"
  data-cart-drawer
>
  <div class="cart-drawer-backdrop" data-cart-backdrop></div>

  <div class="cart-drawer-panel" role="dialog" aria-modal="true" aria-labelledby="cart-title">
    <header class="cart-drawer-header">
      <h2 class="cart-drawer-title" id="cart-title">Tu carrito</h2>
      <button
        type="button"
        class="cart-drawer-close"
        aria-label="Cerrar carrito"
        data-cart-close
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="18" y1="6" x2="6" y2="18" />
        </svg>
      </button>
    </header>

    <div class="cart-drawer-body">
      <p class="cart-empty" data-cart-empty>
        Todavía no agregaste fragancias. Explorá el catálogo y sumá tus favoritas.
      </p>

      <ul class="cart-lines" data-cart-lines hidden></ul>
    </div>

    <footer class="cart-drawer-footer" data-cart-footer hidden>
      <div class="cart-total">
        <span class="cart-total-label">Total</span>
        <span class="cart-total-amount" data-cart-total>$ 0</span>
      </div>
      <p class="cart-disclaimer">
        El pedido se envía por WhatsApp. Te confirmamos disponibilidad y forma
        de pago antes de cerrar la compra.
      </p>
      <div class="cart-cta-row">
        <button
          type="button"
          class="cart-continue"
          data-cart-continue
        >
          Seguir comprando
        </button>
        <a
          class="cart-checkout"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          data-cart-checkout
        >
          Finalizar por WhatsApp
        </a>
      </div>
      <button
        type="button"
        class="cart-clear"
        data-cart-clear
        data-confirming="false"
      >
        <span data-cart-clear-label>Vaciar carrito</span>
      </button>
    </footer>
  </div>
</aside>

<template id="cart-line-template">
  <li class="cart-line">
    <div class="cart-line-info">
      <p class="cart-line-brand" data-line-brand></p>
      <p class="cart-line-name" data-line-name></p>
      <p class="cart-line-pres" data-line-pres></p>
    </div>
    <div class="cart-line-actions">
      <div class="cart-qty">
        <button type="button" data-line-decrease aria-label="Disminuir cantidad">−</button>
        <span data-line-qty>1</span>
        <button type="button" data-line-increase aria-label="Aumentar cantidad">+</button>
      </div>
      <p class="cart-line-total" data-line-total></p>
      <button
        type="button"
        class="cart-line-remove"
        data-line-remove
        aria-label="Quitar del carrito"
      >
        Quitar
      </button>
    </div>
  </li>
</template>

<style>
  .cart-drawer {
    position: fixed;
    inset: 0;
    z-index: 1000;
    pointer-events: none;
  }
  .cart-drawer[aria-hidden="false"] {
    pointer-events: auto;
  }

  .cart-drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    opacity: 0;
    transition: opacity var(--transition-default);
  }
  .cart-drawer[aria-hidden="false"] .cart-drawer-backdrop {
    opacity: 1;
  }

  .cart-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(420px, 100vw);
    background: var(--color-bg-deep);
    border-left: 0.5px solid var(--color-border-strong);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform var(--transition-default);
    box-shadow: -16px 0 40px rgba(0, 0, 0, 0.7);
  }
  .cart-drawer[aria-hidden="false"] .cart-drawer-panel {
    transform: translateX(0);
  }

  .cart-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 24px;
    border-bottom: 0.5px solid var(--color-border);
  }
  .cart-drawer-title {
    font-family: var(--font-serif);
    font-size: 22px;
    color: var(--color-cream);
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: 400;
  }
  .cart-drawer-close {
    color: var(--color-gold-light);
    padding: 6px;
    border-radius: var(--radius-circle);
    transition: background var(--transition-fast);
  }
  .cart-drawer-close:hover {
    background: rgba(201, 168, 76, 0.12);
  }

  .cart-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 16px 24px;
  }

  .cart-empty {
    color: var(--color-text-muted);
    font-size: 14px;
    line-height: 1.6;
    text-align: center;
    margin-top: 32px;
  }
  .cart-lines {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cart-line {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 16px;
    border-bottom: 0.5px solid var(--color-border-subtle);
  }
  .cart-line-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .cart-line-brand {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 12px;
    color: var(--color-text-muted);
  }
  .cart-line-name {
    font-size: 14px;
    color: var(--color-cream);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    font-weight: 500;
  }
  .cart-line-pres {
    font-size: 11px;
    color: var(--color-text-muted);
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .cart-line-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }

  .cart-qty {
    display: flex;
    align-items: center;
    gap: 0;
    border: 0.5px solid rgba(201, 168, 76, 0.3);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }
  .cart-qty button {
    color: var(--color-gold-light);
    padding: 4px 12px;
    font-size: 16px;
    line-height: 1;
    transition: background var(--transition-fast);
  }
  .cart-qty button:hover {
    background: rgba(201, 168, 76, 0.1);
  }
  .cart-qty span {
    color: var(--color-cream);
    font-size: 14px;
    padding: 0 8px;
    min-width: 20px;
    text-align: center;
  }

  .cart-line-total {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-gold);
    flex: 1;
    text-align: right;
    letter-spacing: 0;
    font-weight: 500;
    font-variant-numeric: tabular-nums lining-nums;
    font-feature-settings: "tnum" 1, "lnum" 1;
  }

  .cart-line-remove {
    color: var(--color-text-muted);
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition-fast);
  }
  .cart-line-remove:hover {
    color: var(--color-gold-light);
  }

  .cart-drawer-footer {
    padding: 20px 24px 24px;
    border-top: 0.5px solid var(--color-border);
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .cart-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .cart-total-label {
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .cart-total-amount {
    font-family: var(--font-sans);
    font-size: 22px;
    color: var(--color-gold);
    letter-spacing: 0;
    font-weight: 500;
    font-variant-numeric: tabular-nums lining-nums;
    font-feature-settings: "tnum" 1, "lnum" 1;
  }

  .cart-disclaimer {
    font-size: 11px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .cart-cta-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .cart-continue {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 16px;
    background: rgba(201, 168, 76, 0.1);
    border: 0.5px solid var(--color-gold);
    color: var(--color-gold-light);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    border-radius: var(--radius-pill);
    transition: all var(--transition-fast);
  }
  .cart-continue:hover {
    background: rgba(201, 168, 76, 0.2);
  }
  .cart-continue:active {
    transform: scale(0.97);
  }

  .cart-checkout {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 14px 16px;
    background: #25d366;
    color: #fff;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    border-radius: var(--radius-pill);
    transition: opacity var(--transition-fast);
  }
  .cart-checkout:hover {
    opacity: 0.9;
  }

  @media (max-width: 360px) {
    .cart-cta-row {
      grid-template-columns: 1fr;
    }
  }

  .cart-clear {
    color: var(--color-text-muted);
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 3px;
    align-self: center;
    transition: all var(--transition-fast);
    padding: 6px 12px;
    border-radius: var(--radius-pill);
  }
  .cart-clear:hover {
    color: var(--color-gold-light);
  }
  .cart-clear[data-confirming="true"] {
    background: rgba(200, 70, 70, 0.18);
    border: 0.5px solid rgba(200, 70, 70, 0.5);
    color: #ffb3b3;
    text-decoration: none;
  }
  .cart-clear[data-confirming="true"]:hover {
    background: rgba(200, 70, 70, 0.28);
    color: #fff;
  }
</style>
