---
/**
 * Formulario de reel. Incluye upload de imagen de portada (thumbnail).
 * El upload se hace client-side a un endpoint dedicado ANTES de submit
 * del form, para mantener simple el endpoint principal.
 */

interface ReelValues {
  id: string;
  title: string;
  thumbnailUrl: string;
  thumbnailPath: string;
  instagramUrl: string;
  duration: string | null;
  sortOrder: number;
  published: boolean;
}

interface Props {
  reel?: ReelValues;
  errorMessage?: string | null;
  successMessage?: string | null;
}

const { reel, errorMessage = null, successMessage = null } = Astro.props;

const isEdit = reel !== undefined;
const formAction = isEdit ? `/api/admin/reels/${reel.id}` : "/api/admin/reels";

const values = {
  title: reel?.title ?? "",
  thumbnailUrl: reel?.thumbnailUrl ?? "",
  thumbnailPath: reel?.thumbnailPath ?? "",
  instagramUrl: reel?.instagramUrl ?? "",
  duration: reel?.duration ?? "",
  sortOrder: reel?.sortOrder ?? 100,
  published: reel?.published ?? true,
};
---

<div class="form-shell">
  <div class="page-header">
    <div>
      <p class="breadcrumb">
        <a href="/admin">Panel</a>
        <span aria-hidden="true">›</span>
        <a href="/admin/reels">Reels</a>
        <span aria-hidden="true">›</span>
        <span>{isEdit ? "Editar" : "Nuevo"}</span>
      </p>
      <h1>{isEdit ? values.title : "Nuevo reel"}</h1>
    </div>
    <div class="form-actions">
      <a href="/admin/reels" class="btn btn-ghost">Cancelar</a>
      <button type="submit" form="reel-form" class="btn btn-primary">
        {isEdit ? "Guardar cambios" : "Crear reel"}
      </button>
    </div>
  </div>

  {errorMessage !== null && <div class="alert alert-error">{errorMessage}</div>}
  {successMessage !== null && <div class="alert alert-success">{successMessage}</div>}

  <form id="reel-form" method="POST" action={formAction} class="reel-form" data-reel-form>
    {isEdit && <input type="hidden" name="_method" value="PUT" />}
    {isEdit && <input type="hidden" name="previous_thumbnail_path" value={values.thumbnailPath} />}

    <input type="hidden" name="thumbnail_url" data-thumb-url-input value={values.thumbnailUrl} />
    <input type="hidden" name="thumbnail_path" data-thumb-path-input value={values.thumbnailPath} />

    <section class="panel form-panel">
      <h2 class="panel-title">Portada del reel</h2>
      <p class="panel-description">
        Subí una imagen que represente el reel (puede ser una captura del video). Se va a mostrar con un botón de play encima.
      </p>

      <div class="thumb-zone" data-thumb-zone>
        <div class="thumb-preview" data-thumb-preview style={values.thumbnailUrl !== "" ? "" : "display:none;"}>
          <img src={values.thumbnailUrl} alt="Vista previa de la portada" data-thumb-img />
          <button type="button" class="thumb-replace" data-thumb-replace>Cambiar imagen</button>
        </div>

        <div class="thumb-empty" data-thumb-empty style={values.thumbnailUrl === "" ? "" : "display:none;"}>
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <polyline points="21 15 16 10 5 21" />
          </svg>
          <p>
            <strong>Hacé click para subir</strong> o arrastrá una imagen aquí
          </p>
          <p class="thumb-hint">JPG, PNG o WebP · máx. 5 MB · proporción vertical 9:16 recomendada</p>
        </div>

        <input
          type="file"
          accept="image/jpeg,image/png,image/webp"
          data-thumb-input
          hidden
        />
      </div>

      <p class="thumb-status" data-thumb-status hidden></p>
    </section>

    <section class="panel form-panel">
      <h2 class="panel-title">Datos del reel</h2>

      <div class="form-grid">
        <div class="field">
          <label class="field-label" for="title">Título</label>
          <input
            id="title"
            class="field-input"
            type="text"
            name="title"
            required
            maxlength="80"
            value={values.title}
            autocomplete="off"
            placeholder="Ej: Nuestra esencia"
          />
          <p class="field-hint">Título corto que aparece sobre la imagen.</p>
        </div>

        <div class="field">
          <label class="field-label" for="instagram_url">Link del reel en Instagram</label>
          <input
            id="instagram_url"
            class="field-input"
            type="url"
            name="instagram_url"
            required
            value={values.instagramUrl}
            autocomplete="off"
            placeholder="https://www.instagram.com/reel/ABC123/"
          />
          <p class="field-hint">URL completa del reel. Al hacer click en la portada se abre acá.</p>
        </div>

        <div class="field-row">
          <div class="field">
            <label class="field-label" for="duration">Duración (opcional)</label>
            <input
              id="duration"
              class="field-input"
              type="text"
              name="duration"
              maxlength="20"
              value={values.duration}
              autocomplete="off"
              placeholder="2:14 MIN"
            />
            <p class="field-hint">Texto libre. Aparece debajo del título.</p>
          </div>

          <div class="field">
            <label class="field-label" for="sort_order">Orden</label>
            <input
              id="sort_order"
              class="field-input"
              type="number"
              name="sort_order"
              min="0"
              max="9999"
              step="1"
              value={values.sortOrder}
            />
            <p class="field-hint">Menor = aparece antes.</p>
          </div>
        </div>

        <div class="field-checkboxes">
          <label class="check">
            <input type="checkbox" name="published" checked={values.published} />
            <span>Publicar (visible en el sitio)</span>
          </label>
        </div>
      </div>
    </section>

    <div class="form-footer-actions">
      <a href="/admin/reels" class="btn btn-ghost">Cancelar</a>
      <button type="submit" class="btn btn-primary">
        {isEdit ? "Guardar cambios" : "Crear reel"}
      </button>
    </div>

    {
      isEdit && (
        <section class="danger-zone">
          <div>
            <p class="danger-title">Zona peligrosa</p>
            <p class="danger-description">
              Borrar este reel es irreversible. También se elimina la imagen de portada del almacenamiento.
            </p>
          </div>
          <button
            type="button"
            class="btn btn-danger-outline"
            data-delete-trigger
            data-reel-id={reel.id}
            data-reel-title={reel.title}>
            Borrar reel
          </button>
        </section>
      )
    }
  </form>

  {
    isEdit && (
      <div class="modal-backdrop" data-delete-modal aria-hidden="true">
        <div class="modal" role="dialog" aria-modal="true">
          <h2>Borrar reel</h2>
          <p>
            Estás por borrar <strong data-delete-reel-title>—</strong>. Esta acción no se puede deshacer.
          </p>
          <form method="POST" data-delete-form>
            <input type="hidden" name="_method" value="DELETE" />
            <div class="modal-actions">
              <button type="button" class="btn btn-ghost" data-delete-cancel>Cancelar</button>
              <button type="submit" class="btn btn-danger">Borrar reel</button>
            </div>
          </form>
        </div>
      </div>
    )
  }
</div>

<script>
  // Upload de thumbnail + modal de borrar
  document.addEventListener("DOMContentLoaded", () => {
    setupThumbnailUpload();
    setupDeleteModal();
  });

  function setupThumbnailUpload(): void {
    const form = document.querySelector<HTMLFormElement>("[data-reel-form]");
    const zone = document.querySelector<HTMLElement>("[data-thumb-zone]");
    const fileInput = document.querySelector<HTMLInputElement>("[data-thumb-input]");
    const preview = document.querySelector<HTMLElement>("[data-thumb-preview]");
    const empty = document.querySelector<HTMLElement>("[data-thumb-empty]");
    const img = document.querySelector<HTMLImageElement>("[data-thumb-img]");
    const replaceBtn = document.querySelector<HTMLButtonElement>("[data-thumb-replace]");
    const urlInput = document.querySelector<HTMLInputElement>("[data-thumb-url-input]");
    const pathInput = document.querySelector<HTMLInputElement>("[data-thumb-path-input]");
    const status = document.querySelector<HTMLElement>("[data-thumb-status]");

    if (
      form === null || zone === null || fileInput === null || preview === null ||
      empty === null || img === null || urlInput === null || pathInput === null ||
      status === null
    ) return;

    function showStatus(message: string, kind: "info" | "error" = "info"): void {
      status!.textContent = message;
      status!.hidden = false;
      status!.dataset.kind = kind;
    }
    function hideStatus(): void {
      status!.hidden = true;
    }

    async function uploadFile(file: File): Promise<void> {
      hideStatus();
      if (file.size > 5 * 1024 * 1024) {
        showStatus("La imagen supera los 5 MB.", "error");
        return;
      }

      showStatus("Subiendo imagen…");
      const fd = new FormData();
      fd.append("file", file);

      try {
        const response = await fetch("/api/admin/reels/upload", {
          method: "POST",
          body: fd,
        });
        const data = await response.json();
        if (!response.ok || data.ok !== true) {
          showStatus(data.message ?? "No se pudo subir la imagen.", "error");
          return;
        }
        // Actualizar UI
        img!.src = data.url;
        urlInput!.value = data.url;
        pathInput!.value = data.path;
        preview!.style.display = "";
        empty!.style.display = "none";
        showStatus("Imagen lista.", "info");
        setTimeout(hideStatus, 2000);
      } catch (err) {
        console.error("[reel upload]", err);
        showStatus("Error de red. Reintentá.", "error");
      }
    }

    // Click en zona vacía
    empty.addEventListener("click", () => fileInput.click());
    // Cambiar imagen
    replaceBtn?.addEventListener("click", () => fileInput.click());
    // Selección de archivo
    fileInput.addEventListener("change", () => {
      const file = fileInput.files?.[0];
      if (file !== undefined) void uploadFile(file);
    });
    // Drag & drop
    zone.addEventListener("dragover", (e) => {
      e.preventDefault();
      zone.classList.add("is-drop-target");
    });
    zone.addEventListener("dragleave", () => zone.classList.remove("is-drop-target"));
    zone.addEventListener("drop", (e) => {
      e.preventDefault();
      zone.classList.remove("is-drop-target");
      const file = e.dataTransfer?.files?.[0];
      if (file !== undefined) void uploadFile(file);
    });

    // Validar al hacer submit que haya thumbnail
    form.addEventListener("submit", (e) => {
      if (urlInput.value.trim() === "" || pathInput.value.trim() === "") {
        e.preventDefault();
        showStatus("Subí una imagen de portada antes de guardar.", "error");
        zone.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    });
  }

  function setupDeleteModal(): void {
    const modal = document.querySelector<HTMLDivElement>("[data-delete-modal]");
    const form = document.querySelector<HTMLFormElement>("[data-delete-form]");
    const titleTarget = document.querySelector<HTMLElement>("[data-delete-reel-title]");
    const cancelBtn = document.querySelector<HTMLButtonElement>("[data-delete-cancel]");
    if (modal === null || form === null) return;

    function open(reelId: string, title: string): void {
      if (titleTarget !== null) titleTarget.textContent = title;
      form!.action = `/api/admin/reels/${reelId}`;
      modal!.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }
    function close(): void {
      modal!.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    document.querySelectorAll<HTMLButtonElement>("[data-delete-trigger]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.reelId;
        const title = btn.dataset.reelTitle ?? "este reel";
        if (id === undefined) return;
        open(id, title);
      });
    });

    cancelBtn?.addEventListener("click", close);
    modal.addEventListener("click", (e) => {
      if (e.target === modal) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.getAttribute("aria-hidden") === "false") close();
    });
  }
</script>

<style>
  .form-shell {
    max-width: 880px;
    margin: 0 auto;
  }
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 24px;
  }
  .breadcrumb {
    font-size: 14px;
    color: var(--admin-text-muted);
    margin-bottom: 4px;
  }
  .breadcrumb a {
    color: var(--admin-accent);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb span[aria-hidden] {
    margin: 0 6px;
    color: var(--admin-text-faint);
  }
  .form-actions {
    display: flex;
    gap: 8px;
  }
  .alert {
    padding: 12px 16px;
    border-radius: var(--admin-radius-sm);
    font-size: 14px;
    margin-bottom: 16px;
  }
  .alert-error {
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }
  .alert-success {
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  .reel-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .form-panel {
    padding: 20px 24px;
  }
  .panel-title {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .panel-description {
    font-size: 13px;
    color: var(--admin-text-muted);
    margin-bottom: 16px;
  }

  /* Thumbnail upload zone */
  .thumb-zone {
    border: 2px dashed var(--admin-border-strong);
    border-radius: var(--admin-radius-md);
    transition: all 0.15s;
    overflow: hidden;
  }
  .thumb-zone.is-drop-target {
    border-color: var(--admin-accent);
    background: rgba(37, 99, 235, 0.04);
  }
  .thumb-empty {
    padding: 40px 20px;
    text-align: center;
    cursor: pointer;
    color: var(--admin-text-muted);
  }
  .thumb-empty:hover {
    background: var(--admin-bg);
  }
  .thumb-empty svg {
    margin: 0 auto 12px;
    color: var(--admin-text-faint);
  }
  .thumb-empty p {
    margin: 0;
    font-size: 14px;
  }
  .thumb-empty strong {
    color: var(--admin-accent);
  }
  .thumb-hint {
    margin-top: 6px !important;
    font-size: 12px !important;
    color: var(--admin-text-faint);
  }

  .thumb-preview {
    position: relative;
    display: flex;
    justify-content: center;
    background: var(--admin-bg);
  }
  .thumb-preview img {
    max-height: 360px;
    width: auto;
    object-fit: contain;
    display: block;
  }
  .thumb-replace {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(0, 0, 0, 0.75);
    color: #fff;
    border: none;
    padding: 8px 14px;
    border-radius: var(--admin-radius-sm);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s;
  }
  .thumb-replace:hover {
    background: rgba(0, 0, 0, 0.9);
  }

  .thumb-status {
    margin-top: 10px;
    font-size: 13px;
    color: var(--admin-text-muted);
  }
  .thumb-status[data-kind="error"] {
    color: var(--admin-danger);
  }

  .form-grid {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 12px;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  @media (max-width: 600px) {
    .field-row {
      grid-template-columns: 1fr;
    }
  }
  .field-hint {
    margin-top: 4px;
    font-size: 12px;
    color: var(--admin-text-faint);
  }
  .field-checkboxes {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    cursor: pointer;
  }
  .check input {
    width: 16px;
    height: 16px;
  }

  .form-footer-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 16px;
    padding: 16px 20px;
    background: var(--admin-bg-panel);
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius-md);
  }

  .danger-zone {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--admin-border);
    gap: 16px;
  }
  .danger-title {
    color: var(--admin-danger);
    font-weight: 600;
    font-size: 14px;
  }
  .danger-description {
    color: var(--admin-text-muted);
    font-size: 13px;
    margin-top: 2px;
  }
  .btn-danger-outline {
    background: #fef2f2;
    color: var(--admin-danger);
    border: 1px solid #fecaca;
    flex-shrink: 0;
  }
  .btn-danger-outline:hover {
    background: var(--admin-danger);
    color: #fff;
    border-color: var(--admin-danger);
  }

  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 20px;
  }
  .modal-backdrop[aria-hidden="false"] {
    display: flex;
  }
  .modal {
    background: var(--admin-bg-panel);
    border-radius: var(--admin-radius-lg);
    padding: 24px;
    max-width: 440px;
    width: 100%;
    box-shadow: var(--admin-shadow-lg);
  }
  .modal h2 {
    margin-bottom: 8px;
  }
  .modal p {
    color: var(--admin-text-muted);
    margin-bottom: 20px;
  }
  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }
</style>
