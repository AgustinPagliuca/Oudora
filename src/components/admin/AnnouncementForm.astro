---
import type { AnnouncementIcon } from "@/types/catalog";

interface AnnouncementValues {
  id: string;
  text: string;
  icon: AnnouncementIcon | null;
  sortOrder: number;
  published: boolean;
}

interface Props {
  announcement?: AnnouncementValues;
  errorMessage?: string | null;
  successMessage?: string | null;
}

const { announcement, errorMessage = null, successMessage = null } = Astro.props;

const isEdit = announcement !== undefined;
const formAction = isEdit
  ? `/api/admin/announcements/${announcement.id}`
  : "/api/admin/announcements";

const values = {
  text: announcement?.text ?? "",
  icon: announcement?.icon ?? null,
  sortOrder: announcement?.sortOrder ?? 100,
  published: announcement?.published ?? true,
};

const iconOptions: { value: string; label: string }[] = [
  { value: "", label: "Sin ícono" },
  { value: "truck", label: "🚚 Camión (envíos)" },
  { value: "gift", label: "🎁 Regalo (promo)" },
  { value: "percent", label: "🏷️ Etiqueta (descuento)" },
  { value: "credit-card", label: "💳 Tarjeta (cuotas/pagos)" },
  { value: "star", label: "⭐ Estrella (destacado)" },
  { value: "clock", label: "⏰ Reloj (tiempo limitado)" },
  { value: "map-pin", label: "📍 Ubicación (retiro local)" },
];
---

<div class="form-shell">
  <div class="page-header">
    <div>
      <p class="breadcrumb">
        <a href="/admin">Panel</a>
        <span aria-hidden="true">›</span>
        <a href="/admin/avisos">Avisos</a>
        <span aria-hidden="true">›</span>
        <span>{isEdit ? "Editar" : "Nuevo"}</span>
      </p>
      <h1>{isEdit ? "Editar aviso" : "Nuevo aviso"}</h1>
    </div>
    <div class="form-actions">
      <a href="/admin/avisos" class="btn btn-ghost">Cancelar</a>
      <button type="submit" form="announcement-form" class="btn btn-primary">
        {isEdit ? "Guardar cambios" : "Crear aviso"}
      </button>
    </div>
  </div>

  {errorMessage !== null && <div class="alert alert-error">{errorMessage}</div>}
  {successMessage !== null && <div class="alert alert-success">{successMessage}</div>}

  <form id="announcement-form" method="POST" action={formAction} class="announcement-form">
    {isEdit && <input type="hidden" name="_method" value="PUT" />}

    <section class="panel form-panel">
      <h2 class="panel-title">Aviso</h2>
      <p class="panel-description">
        Aparece en la barra superior del sitio. Si hay varios, rotan automáticamente cada 5 segundos.
      </p>

      <div class="form-grid">
        <div class="field">
          <label class="field-label" for="text">Texto del aviso</label>
          <input
            id="text"
            class="field-input"
            type="text"
            name="text"
            required
            maxlength="140"
            value={values.text}
            autocomplete="off"
            placeholder="Ej: Envío gratis a partir de $130.000"
          />
          <p class="field-hint">Hasta 140 caracteres. Aparece en MAYÚSCULAS automáticamente.</p>
        </div>

        <div class="field-row">
          <div class="field">
            <label class="field-label" for="icon">Ícono</label>
            <select id="icon" name="icon" class="field-input">
              {iconOptions.map((opt) => (
                <option value={opt.value} selected={values.icon === opt.value || (values.icon === null && opt.value === "")}>
                  {opt.label}
                </option>
              ))}
            </select>
            <p class="field-hint">Aparece a la izquierda del texto.</p>
          </div>

          <div class="field">
            <label class="field-label" for="sort_order">Orden</label>
            <input
              id="sort_order"
              class="field-input"
              type="number"
              name="sort_order"
              min="0"
              max="9999"
              step="1"
              value={values.sortOrder}
            />
            <p class="field-hint">Menor = aparece primero.</p>
          </div>
        </div>

        <div class="field-checkboxes">
          <label class="check">
            <input type="checkbox" name="published" checked={values.published} />
            <span>Publicar (visible en el sitio)</span>
          </label>
        </div>
      </div>
    </section>

    <div class="form-footer-actions">
      <a href="/admin/avisos" class="btn btn-ghost">Cancelar</a>
      <button type="submit" class="btn btn-primary">
        {isEdit ? "Guardar cambios" : "Crear aviso"}
      </button>
    </div>

    {
      isEdit && (
        <section class="danger-zone">
          <div>
            <p class="danger-title">Zona peligrosa</p>
            <p class="danger-description">Borrar este aviso es irreversible.</p>
          </div>
          <button
            type="button"
            class="btn btn-danger-outline"
            data-delete-trigger
            data-announcement-id={announcement.id}
            data-announcement-text={announcement.text}>
            Borrar aviso
          </button>
        </section>
      )
    }
  </form>

  {
    isEdit && (
      <div class="modal-backdrop" data-delete-modal aria-hidden="true">
        <div class="modal" role="dialog" aria-modal="true">
          <h2>Borrar aviso</h2>
          <p>Estás por borrar el aviso "<strong data-delete-announcement-text>—</strong>". Esta acción no se puede deshacer.</p>
          <form method="POST" data-delete-form>
            <input type="hidden" name="_method" value="DELETE" />
            <div class="modal-actions">
              <button type="button" class="btn btn-ghost" data-delete-cancel>Cancelar</button>
              <button type="submit" class="btn btn-danger">Borrar aviso</button>
            </div>
          </form>
        </div>
      </div>
    )
  }
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.querySelector<HTMLDivElement>("[data-delete-modal]");
    const form = document.querySelector<HTMLFormElement>("[data-delete-form]");
    const textTarget = document.querySelector<HTMLElement>("[data-delete-announcement-text]");
    const cancelBtn = document.querySelector<HTMLButtonElement>("[data-delete-cancel]");
    if (modal === null || form === null) return;

    function open(id: string, text: string): void {
      if (textTarget !== null) textTarget.textContent = text;
      form!.action = `/api/admin/announcements/${id}`;
      modal!.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }
    function close(): void {
      modal!.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    document.querySelectorAll<HTMLButtonElement>("[data-delete-trigger]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.announcementId;
        const text = btn.dataset.announcementText ?? "este aviso";
        if (id === undefined) return;
        open(id, text);
      });
    });
    cancelBtn?.addEventListener("click", close);
    modal.addEventListener("click", (e) => {
      if (e.target === modal) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.getAttribute("aria-hidden") === "false") close();
    });
  });
</script>

<style>
  .form-shell { max-width: 760px; margin: 0 auto; }
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 24px;
  }
  .breadcrumb {
    font-size: 14px;
    color: var(--admin-text-muted);
    margin-bottom: 4px;
  }
  .breadcrumb a { color: var(--admin-accent); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb span[aria-hidden] { margin: 0 6px; color: var(--admin-text-faint); }
  .form-actions { display: flex; gap: 8px; }

  .alert {
    padding: 12px 16px;
    border-radius: var(--admin-radius-sm);
    font-size: 14px;
    margin-bottom: 16px;
  }
  .alert-error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
  .alert-success { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }

  .announcement-form { display: flex; flex-direction: column; gap: 12px; }
  .form-panel { padding: 20px 24px; }
  .panel-title { font-size: 14px; font-weight: 600; margin-bottom: 4px; }
  .panel-description { font-size: 13px; color: var(--admin-text-muted); margin-bottom: 8px; }

  .form-grid { display: flex; flex-direction: column; gap: 14px; margin-top: 12px; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 600px) { .field-row { grid-template-columns: 1fr; } }
  .field-hint { margin-top: 4px; font-size: 12px; color: var(--admin-text-faint); }

  .field-checkboxes { display: flex; flex-direction: column; gap: 8px; }
  .check { display: flex; align-items: center; gap: 8px; font-size: 14px; cursor: pointer; }
  .check input { width: 16px; height: 16px; }

  .form-footer-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 16px;
    padding: 16px 20px;
    background: var(--admin-bg-panel);
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius-md);
  }

  .danger-zone {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--admin-border);
    gap: 16px;
  }
  .danger-title { color: var(--admin-danger); font-weight: 600; font-size: 14px; }
  .danger-description { color: var(--admin-text-muted); font-size: 13px; margin-top: 2px; }
  .btn-danger-outline {
    background: #fef2f2;
    color: var(--admin-danger);
    border: 1px solid #fecaca;
    flex-shrink: 0;
  }
  .btn-danger-outline:hover {
    background: var(--admin-danger);
    color: #fff;
    border-color: var(--admin-danger);
  }

  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 20px;
  }
  .modal-backdrop[aria-hidden="false"] { display: flex; }
  .modal {
    background: var(--admin-bg-panel);
    border-radius: var(--admin-radius-lg);
    padding: 24px;
    max-width: 440px;
    width: 100%;
    box-shadow: var(--admin-shadow-lg);
  }
  .modal h2 { margin-bottom: 8px; }
  .modal p { color: var(--admin-text-muted); margin-bottom: 20px; }
  .modal-actions { display: flex; justify-content: flex-end; gap: 8px; }
</style>
