---
/**
 * Formulario de slide del carrusel hero.
 * Reutiliza el patrón de ReelForm para upload de imagen.
 */

interface HeroSlideValues {
  id: string;
  overline: string | null;
  title: string;
  subtitle: string | null;
  imageUrl: string;
  imagePath: string;
  ctaLabel: string | null;
  ctaHref: string | null;
  sortOrder: number;
  published: boolean;
}

interface Props {
  slide?: HeroSlideValues;
  errorMessage?: string | null;
  successMessage?: string | null;
}

const { slide, errorMessage = null, successMessage = null } = Astro.props;

const isEdit = slide !== undefined;
const formAction = isEdit ? `/api/admin/hero-slides/${slide.id}` : "/api/admin/hero-slides";

const values = {
  overline: slide?.overline ?? "",
  title: slide?.title ?? "",
  subtitle: slide?.subtitle ?? "",
  imageUrl: slide?.imageUrl ?? "",
  imagePath: slide?.imagePath ?? "",
  ctaLabel: slide?.ctaLabel ?? "",
  ctaHref: slide?.ctaHref ?? "",
  sortOrder: slide?.sortOrder ?? 100,
  published: slide?.published ?? true,
};
---

<div class="form-shell">
  <div class="page-header">
    <div>
      <p class="breadcrumb">
        <a href="/admin">Panel</a>
        <span aria-hidden="true">›</span>
        <a href="/admin/hero">Hero</a>
        <span aria-hidden="true">›</span>
        <span>{isEdit ? "Editar" : "Nuevo"}</span>
      </p>
      <h1>{isEdit ? values.title : "Nuevo slide"}</h1>
    </div>
    <div class="form-actions">
      <a href="/admin/hero" class="btn btn-ghost">Cancelar</a>
      <button type="submit" form="slide-form" class="btn btn-primary">
        {isEdit ? "Guardar cambios" : "Crear slide"}
      </button>
    </div>
  </div>

  {errorMessage !== null && <div class="alert alert-error">{errorMessage}</div>}
  {successMessage !== null && <div class="alert alert-success">{successMessage}</div>}

  <form id="slide-form" method="POST" action={formAction} class="slide-form" data-slide-form>
    {isEdit && <input type="hidden" name="_method" value="PUT" />}
    {isEdit && <input type="hidden" name="previous_image_path" value={values.imagePath} />}

    <input type="hidden" name="image_url" data-image-url-input value={values.imageUrl} />
    <input type="hidden" name="image_path" data-image-path-input value={values.imagePath} />

    <section class="panel form-panel">
      <h2 class="panel-title">Imagen de fondo</h2>
      <p class="panel-description">
        Imagen grande horizontal (recomendado 1920×800px o similar). Se muestra como fondo del slide con un overlay oscuro para que se lea el texto.
      </p>

      <div class="image-zone" data-image-zone>
        <div class="image-preview" data-image-preview style={values.imageUrl !== "" ? "" : "display:none;"}>
          <img src={values.imageUrl} alt="Vista previa del slide" data-image-img />
          <button type="button" class="image-replace" data-image-replace>Cambiar imagen</button>
        </div>

        <div class="image-empty" data-image-empty style={values.imageUrl === "" ? "" : "display:none;"}>
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <polyline points="21 15 16 10 5 21" />
          </svg>
          <p>
            <strong>Hacé click para subir</strong> o arrastrá una imagen aquí
          </p>
          <p class="image-hint">JPG, PNG o WebP · máx. 5 MB · horizontal 16:7 recomendado</p>
        </div>

        <input
          type="file"
          accept="image/jpeg,image/png,image/webp"
          data-image-input
          hidden
        />
      </div>

      <p class="image-status" data-image-status hidden></p>
    </section>

    <section class="panel form-panel">
      <h2 class="panel-title">Contenido del slide</h2>

      <div class="form-grid">
        <div class="field">
          <label class="field-label" for="overline">Línea superior (opcional)</label>
          <input
            id="overline"
            class="field-input"
            type="text"
            name="overline"
            maxlength="80"
            value={values.overline}
            autocomplete="off"
            placeholder="Ej: NUEVA COLECCIÓN"
          />
          <p class="field-hint">Texto pequeño en mayúsculas que aparece arriba del título.</p>
        </div>

        <div class="field">
          <label class="field-label" for="title">Título</label>
          <input
            id="title"
            class="field-input"
            type="text"
            name="title"
            required
            maxlength="120"
            value={values.title}
            autocomplete="off"
            placeholder="Ej: Perfumes árabes de colección"
          />
          <p class="field-hint">Texto grande en serif. Hasta 120 caracteres.</p>
        </div>

        <div class="field">
          <label class="field-label" for="subtitle">Bajada (opcional)</label>
          <textarea
            id="subtitle"
            class="field-input field-textarea"
            name="subtitle"
            maxlength="200"
            rows="2"
            placeholder="Una o dos líneas que acompañan al título"
          >{values.subtitle}</textarea>
          <p class="field-hint">Hasta 200 caracteres.</p>
        </div>
      </div>
    </section>

    <section class="panel form-panel">
      <h2 class="panel-title">Botón de acción (opcional)</h2>
      <p class="panel-description">
        Si querés que el slide tenga un botón clickeable, completá los dos campos. Si los dejás vacíos, el slide no muestra botón.
      </p>

      <div class="form-grid">
        <div class="field-row">
          <div class="field">
            <label class="field-label" for="cta_label">Texto del botón</label>
            <input
              id="cta_label"
              class="field-input"
              type="text"
              name="cta_label"
              maxlength="40"
              value={values.ctaLabel}
              autocomplete="off"
              placeholder="Ej: Ver colección"
            />
          </div>

          <div class="field">
            <label class="field-label" for="cta_href">Link de destino</label>
            <input
              id="cta_href"
              class="field-input"
              type="text"
              name="cta_href"
              maxlength="500"
              value={values.ctaHref}
              autocomplete="off"
              placeholder="Ej: /catalogo o /producto/khamrah"
            />
            <p class="field-hint">Puede ser interna (/catalogo) o externa (https://…)</p>
          </div>
        </div>
      </div>
    </section>

    <section class="panel form-panel">
      <h2 class="panel-title">Publicación</h2>

      <div class="form-grid">
        <div class="field-row">
          <div class="field">
            <label class="field-label" for="sort_order">Orden</label>
            <input
              id="sort_order"
              class="field-input"
              type="number"
              name="sort_order"
              min="0"
              max="9999"
              step="1"
              value={values.sortOrder}
            />
            <p class="field-hint">Menor = aparece primero.</p>
          </div>
        </div>

        <div class="field-checkboxes">
          <label class="check">
            <input type="checkbox" name="published" checked={values.published} />
            <span>Publicar (visible en la home)</span>
          </label>
        </div>
      </div>
    </section>

    <div class="form-footer-actions">
      <a href="/admin/hero" class="btn btn-ghost">Cancelar</a>
      <button type="submit" class="btn btn-primary">
        {isEdit ? "Guardar cambios" : "Crear slide"}
      </button>
    </div>

    {
      isEdit && (
        <section class="danger-zone">
          <div>
            <p class="danger-title">Zona peligrosa</p>
            <p class="danger-description">
              Borrar este slide es irreversible. También se elimina la imagen del almacenamiento.
            </p>
          </div>
          <button
            type="button"
            class="btn btn-danger-outline"
            data-delete-trigger
            data-slide-id={slide.id}
            data-slide-title={slide.title}>
            Borrar slide
          </button>
        </section>
      )
    }
  </form>

  {
    isEdit && (
      <div class="modal-backdrop" data-delete-modal aria-hidden="true">
        <div class="modal" role="dialog" aria-modal="true">
          <h2>Borrar slide</h2>
          <p>
            Estás por borrar <strong data-delete-slide-title>—</strong>. Esta acción no se puede deshacer.
          </p>
          <form method="POST" data-delete-form>
            <input type="hidden" name="_method" value="DELETE" />
            <div class="modal-actions">
              <button type="button" class="btn btn-ghost" data-delete-cancel>Cancelar</button>
              <button type="submit" class="btn btn-danger">Borrar slide</button>
            </div>
          </form>
        </div>
      </div>
    )
  }
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    setupImageUpload();
    setupDeleteModal();
  });

  function setupImageUpload(): void {
    const form = document.querySelector<HTMLFormElement>("[data-slide-form]");
    const zone = document.querySelector<HTMLElement>("[data-image-zone]");
    const fileInput = document.querySelector<HTMLInputElement>("[data-image-input]");
    const preview = document.querySelector<HTMLElement>("[data-image-preview]");
    const empty = document.querySelector<HTMLElement>("[data-image-empty]");
    const img = document.querySelector<HTMLImageElement>("[data-image-img]");
    const replaceBtn = document.querySelector<HTMLButtonElement>("[data-image-replace]");
    const urlInput = document.querySelector<HTMLInputElement>("[data-image-url-input]");
    const pathInput = document.querySelector<HTMLInputElement>("[data-image-path-input]");
    const status = document.querySelector<HTMLElement>("[data-image-status]");

    if (
      form === null || zone === null || fileInput === null || preview === null ||
      empty === null || img === null || urlInput === null || pathInput === null ||
      status === null
    ) return;

    function showStatus(message: string, kind: "info" | "error" = "info"): void {
      status!.textContent = message;
      status!.hidden = false;
      status!.dataset.kind = kind;
    }
    function hideStatus(): void { status!.hidden = true; }

    async function uploadFile(file: File): Promise<void> {
      hideStatus();
      if (file.size > 5 * 1024 * 1024) {
        showStatus("La imagen supera los 5 MB.", "error");
        return;
      }

      showStatus("Subiendo imagen…");
      const fd = new FormData();
      fd.append("file", file);

      try {
        const response = await fetch("/api/admin/hero-slides/upload", {
          method: "POST",
          body: fd,
        });
        const data = await response.json();
        if (!response.ok || data.ok !== true) {
          showStatus(data.message ?? "No se pudo subir la imagen.", "error");
          return;
        }
        img!.src = data.url;
        urlInput!.value = data.url;
        pathInput!.value = data.path;
        preview!.style.display = "";
        empty!.style.display = "none";
        showStatus("Imagen lista.", "info");
        setTimeout(hideStatus, 2000);
      } catch (err) {
        console.error("[slide upload]", err);
        showStatus("Error de red. Reintentá.", "error");
      }
    }

    empty.addEventListener("click", () => fileInput.click());
    replaceBtn?.addEventListener("click", () => fileInput.click());
    fileInput.addEventListener("change", () => {
      const file = fileInput.files?.[0];
      if (file !== undefined) void uploadFile(file);
    });
    zone.addEventListener("dragover", (e) => {
      e.preventDefault();
      zone.classList.add("is-drop-target");
    });
    zone.addEventListener("dragleave", () => zone.classList.remove("is-drop-target"));
    zone.addEventListener("drop", (e) => {
      e.preventDefault();
      zone.classList.remove("is-drop-target");
      const file = e.dataTransfer?.files?.[0];
      if (file !== undefined) void uploadFile(file);
    });

    form.addEventListener("submit", (e) => {
      if (urlInput.value.trim() === "" || pathInput.value.trim() === "") {
        e.preventDefault();
        showStatus("Subí una imagen antes de guardar.", "error");
        zone.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    });
  }

  function setupDeleteModal(): void {
    const modal = document.querySelector<HTMLDivElement>("[data-delete-modal]");
    const form = document.querySelector<HTMLFormElement>("[data-delete-form]");
    const titleTarget = document.querySelector<HTMLElement>("[data-delete-slide-title]");
    const cancelBtn = document.querySelector<HTMLButtonElement>("[data-delete-cancel]");
    if (modal === null || form === null) return;

    function open(id: string, title: string): void {
      if (titleTarget !== null) titleTarget.textContent = title;
      form!.action = `/api/admin/hero-slides/${id}`;
      modal!.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }
    function close(): void {
      modal!.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    document.querySelectorAll<HTMLButtonElement>("[data-delete-trigger]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.slideId;
        const title = btn.dataset.slideTitle ?? "este slide";
        if (id === undefined) return;
        open(id, title);
      });
    });

    cancelBtn?.addEventListener("click", close);
    modal.addEventListener("click", (e) => { if (e.target === modal) close(); });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.getAttribute("aria-hidden") === "false") close();
    });
  }
</script>

<style>
  .form-shell { max-width: 880px; margin: 0 auto; }
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 24px;
  }
  .breadcrumb { font-size: 14px; color: var(--admin-text-muted); margin-bottom: 4px; }
  .breadcrumb a { color: var(--admin-accent); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb span[aria-hidden] { margin: 0 6px; color: var(--admin-text-faint); }
  .form-actions { display: flex; gap: 8px; }

  .alert {
    padding: 12px 16px;
    border-radius: var(--admin-radius-sm);
    font-size: 14px;
    margin-bottom: 16px;
  }
  .alert-error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
  .alert-success { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }

  .slide-form { display: flex; flex-direction: column; gap: 12px; }
  .form-panel { padding: 20px 24px; }
  .panel-title { font-size: 14px; font-weight: 600; margin-bottom: 4px; }
  .panel-description { font-size: 13px; color: var(--admin-text-muted); margin-bottom: 16px; }

  /* Upload zone */
  .image-zone {
    border: 2px dashed var(--admin-border-strong);
    border-radius: var(--admin-radius-md);
    transition: all 0.15s;
    overflow: hidden;
  }
  .image-zone.is-drop-target {
    border-color: var(--admin-accent);
    background: rgba(37, 99, 235, 0.04);
  }
  .image-empty {
    padding: 40px 20px;
    text-align: center;
    cursor: pointer;
    color: var(--admin-text-muted);
  }
  .image-empty:hover { background: var(--admin-bg); }
  .image-empty svg { margin: 0 auto 12px; color: var(--admin-text-faint); }
  .image-empty p { margin: 0; font-size: 14px; }
  .image-empty strong { color: var(--admin-accent); }
  .image-hint { margin-top: 6px !important; font-size: 12px !important; color: var(--admin-text-faint); }

  .image-preview {
    position: relative;
    display: flex;
    justify-content: center;
    background: var(--admin-bg);
  }
  .image-preview img {
    max-height: 360px;
    width: 100%;
    object-fit: cover;
    display: block;
  }
  .image-replace {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(0, 0, 0, 0.75);
    color: #fff;
    border: none;
    padding: 8px 14px;
    border-radius: var(--admin-radius-sm);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s;
  }
  .image-replace:hover { background: rgba(0, 0, 0, 0.9); }

  .image-status { margin-top: 10px; font-size: 13px; color: var(--admin-text-muted); }
  .image-status[data-kind="error"] { color: var(--admin-danger); }

  .form-grid { display: flex; flex-direction: column; gap: 14px; margin-top: 12px; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 600px) { .field-row { grid-template-columns: 1fr; } }
  .field-hint { margin-top: 4px; font-size: 12px; color: var(--admin-text-faint); }
  .field-textarea { resize: vertical; min-height: 70px; font-family: inherit; }

  .field-checkboxes { display: flex; flex-direction: column; gap: 8px; }
  .check { display: flex; align-items: center; gap: 8px; font-size: 14px; cursor: pointer; }
  .check input { width: 16px; height: 16px; }

  .form-footer-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 16px;
    padding: 16px 20px;
    background: var(--admin-bg-panel);
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius-md);
  }

  .danger-zone {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--admin-border);
    gap: 16px;
  }
  .danger-title { color: var(--admin-danger); font-weight: 600; font-size: 14px; }
  .danger-description { color: var(--admin-text-muted); font-size: 13px; margin-top: 2px; }
  .btn-danger-outline {
    background: #fef2f2;
    color: var(--admin-danger);
    border: 1px solid #fecaca;
    flex-shrink: 0;
  }
  .btn-danger-outline:hover {
    background: var(--admin-danger);
    color: #fff;
    border-color: var(--admin-danger);
  }

  .modal-backdrop {
    position: fixed; inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 20px;
  }
  .modal-backdrop[aria-hidden="false"] { display: flex; }
  .modal {
    background: var(--admin-bg-panel);
    border-radius: var(--admin-radius-lg);
    padding: 24px;
    max-width: 440px;
    width: 100%;
    box-shadow: var(--admin-shadow-lg);
  }
  .modal h2 { margin-bottom: 8px; }
  .modal p { color: var(--admin-text-muted); margin-bottom: 20px; }
  .modal-actions { display: flex; justify-content: flex-end; gap: 8px; }
</style>
