---
/**
 * Formulario de producto compartido entre /admin/productos/nuevo y /[id].
 *
 * Si recibe `product`, opera en modo edición (POST a /api/admin/products/[id]
 * con _method=PUT y muestra zona peligrosa con botón de borrar).
 * Si no, opera en modo creación (POST a /api/admin/products).
 *
 * Las notas olfativas se renderizan como tags. El JS controller las maneja:
 * al escribir y apretar Enter o coma agrega un tag; click en la X borra.
 */

import ProductImagesPanel from "@/components/admin/ProductImagesPanel.astro";

interface BrandOption {
  id: string;
  name: string;
}

interface ImageRecord {
  id: string;
  url: string;
  position: number;
}

interface ProductValues {
  id: string;
  slug: string;
  brandId: string;
  catalog: string;
  name: string;
  gender: string;
  concentration: string;
  volumeMl: number;
  priceArs: number;
  stock: number;
  notes: string[];
  featured: boolean;
  createdAt?: string;
  images?: ImageRecord[];
}

interface Props {
  brands: BrandOption[];
  product?: ProductValues;
  errorMessage?: string | null;
  successMessage?: string | null;
}

const {
  brands,
  product,
  errorMessage = null,
  successMessage = null,
} = Astro.props as Props;

const isEdit = product !== undefined;
const formAction = isEdit
  ? `/api/admin/products/${product.id}`
  : "/api/admin/products";

const values = {
  slug: product?.slug ?? "",
  brandId: product?.brandId ?? brands[0]?.id ?? "",
  catalog: product?.catalog ?? "arabe",
  name: product?.name ?? "",
  gender: product?.gender ?? "unisex",
  concentration: product?.concentration ?? "EDP",
  volumeMl: product?.volumeMl ?? 100,
  priceArs: product?.priceArs ?? 0,
  stock: product?.stock ?? 0,
  notes: product?.notes ?? [],
  featured: product?.featured ?? false,
};

const createdAtFormatted =
  product?.createdAt !== undefined
    ? new Date(product.createdAt).toLocaleDateString("es-AR", {
        day: "numeric",
        month: "short",
        year: "numeric",
      })
    : null;

const currentBrand = brands.find((b) => b.id === values.brandId);
---

<div class="form-shell">
  <div class="page-header">
    <div>
      <p class="breadcrumb">
        <a href="/admin">Panel</a>
        <span aria-hidden="true">›</span>
        <a href="/admin/productos">Productos</a>
        <span aria-hidden="true">›</span>
        <span>{isEdit ? "Editar" : "Nuevo"}</span>
      </p>
      <h1>{isEdit ? values.name : "Nuevo producto"}</h1>
      {
        isEdit && currentBrand && createdAtFormatted !== null && (
          <p class="page-subtitle">
            {currentBrand.name} · creado el {createdAtFormatted}
          </p>
        )
      }
    </div>
    <div class="form-actions">
      <a href="/admin/productos" class="btn btn-ghost">Cancelar</a>
      <button type="submit" form="product-form" class="btn btn-primary">
        {isEdit ? "Guardar cambios" : "Crear producto"}
      </button>
    </div>
  </div>

  {errorMessage !== null && <div class="alert alert-error">{errorMessage}</div>}
  {successMessage !== null && <div class="alert alert-success">{successMessage}</div>}

  {
    isEdit && (
      <ProductImagesPanel productId={product.id} images={product.images ?? []} />
    )
  }

  <form
    id="product-form"
    method="POST"
    action={formAction}
    data-product-form
    class="product-form"
  >
    {isEdit && <input type="hidden" name="_method" value="PUT" />}

    <!-- Panel: Identidad -->
    <section class="panel form-panel">
      <h2 class="panel-title">Identidad</h2>
      <div class="form-grid two-col">
        <div class="field">
          <label class="field-label" for="brand_id">Marca</label>
          <select
            id="brand_id"
            name="brand_id"
            class="field-input"
            required
            data-product-brand
          >
            {
              brands.map((b) => (
                <option value={b.id} selected={b.id === values.brandId}>
                  {b.name}
                </option>
              ))
            }
          </select>
        </div>

        <div class="field">
          <label class="field-label" for="name">Nombre</label>
          <input
            id="name"
            class="field-input"
            type="text"
            name="name"
            required
            value={values.name}
            data-product-name
            autocomplete="off"
          />
        </div>

        <div class="field full">
          <label class="field-label" for="slug">URL del producto</label>
          <div class="slug-input">
            <span class="slug-prefix">oudora.com.ar/producto/</span>
            <input
              id="slug"
              type="text"
              name="slug"
              required
              value={values.slug}
              data-product-slug
              autocomplete="off"
              pattern="[a-z0-9\-]+"
            />
          </div>
          <p class="field-hint">
            Se autogenera desde el nombre. Solo minúsculas, números y guiones.
          </p>
        </div>
      </div>
    </section>

    <!-- Panel: Clasificación -->
    <section class="panel form-panel">
      <h2 class="panel-title">Clasificación</h2>
      <div class="form-grid four-col">
        <div class="field">
          <label class="field-label" for="catalog">Catálogo</label>
          <select id="catalog" name="catalog" class="field-input" required>
            <option value="arabe" selected={values.catalog === "arabe"}>
              Árabes
            </option>
            <option value="disenador" selected={values.catalog === "disenador"}>
              Diseñador
            </option>
          </select>
        </div>

        <div class="field">
          <label class="field-label" for="gender">Género</label>
          <select id="gender" name="gender" class="field-input" required>
            <option value="femenino" selected={values.gender === "femenino"}>
              Femenino
            </option>
            <option value="masculino" selected={values.gender === "masculino"}>
              Masculino
            </option>
            <option value="unisex" selected={values.gender === "unisex"}>
              Unisex
            </option>
          </select>
        </div>

        <div class="field">
          <label class="field-label" for="concentration">Concentración</label>
          <select
            id="concentration"
            name="concentration"
            class="field-input"
            required
          >
            <option value="EDP" selected={values.concentration === "EDP"}>
              EDP
            </option>
            <option value="EDT" selected={values.concentration === "EDT"}>
              EDT
            </option>
            <option value="Parfum" selected={values.concentration === "Parfum"}>
              Parfum
            </option>
            <option
              value="Extrait"
              selected={values.concentration === "Extrait"}>Extrait</option>
          </select>
        </div>

        <div class="field">
          <label class="field-label" for="volume_ml">Volumen (ml)</label>
          <input
            id="volume_ml"
            class="field-input"
            type="number"
            name="volume_ml"
            required
            min="1"
            max="1000"
            value={values.volumeMl}
          />
        </div>
      </div>
    </section>

    <!-- Panel: Comercial -->
    <section class="panel form-panel">
      <h2 class="panel-title">Comercial</h2>
      <div class="form-grid two-col">
        <div class="field">
          <label class="field-label" for="price_ars">Precio (ARS)</label>
          <div class="price-input">
            <span class="price-prefix">$</span>
            <input
              id="price_ars"
              type="number"
              name="price_ars"
              required
              min="0"
              step="1"
              value={values.priceArs}
            />
          </div>
        </div>

        <div class="field">
          <label class="field-label" for="stock">Stock</label>
          <input
            id="stock"
            class="field-input"
            type="number"
            name="stock"
            required
            min="0"
            step="1"
            value={values.stock}
          />
        </div>
      </div>

      <label class="checkbox-row">
        <input type="checkbox" name="featured" checked={values.featured} />
        <span>Destacado en home</span>
        <span class="field-hint inline">
          — aparece en el strip de la portada
        </span>
      </label>
    </section>

    <!-- Panel: Notas olfativas -->
    <section class="panel form-panel">
      <h2 class="panel-title">Notas olfativas</h2>
      <p class="panel-description">
        Escribí cada nota y apretá Enter o coma para agregarla.
      </p>
      <div class="tag-input" data-tag-input>
        <div class="tag-list" data-tag-list>
          {
            values.notes.map((note) => (
              <span class="tag" data-tag-value={note}>
                {note}
                <button
                  type="button"
                  class="tag-remove"
                  data-tag-remove
                  aria-label={`Quitar ${note}`}>
                  ×
                </button>
                <input type="hidden" name="notes" value={note} />
              </span>
            ))
          }
        </div>
        <input
          type="text"
          class="tag-text-input"
          placeholder="agregar nota…"
          data-tag-text-input
          autocomplete="off"
        />
      </div>
    </section>

    {
      isEdit && (
        <section class="danger-zone">
          <div>
            <p class="danger-title">Zona peligrosa</p>
            <p class="danger-description">
              Borrar este producto es irreversible.
            </p>
          </div>
          <button
            type="button"
            class="btn btn-danger-outline"
            data-delete-trigger
            data-product-id={product.id}
            data-product-name={`${currentBrand?.name ?? ""} ${values.name}`.trim()}>
            Borrar producto
          </button>
        </section>
      )
    }
  </form>

  {
    isEdit && (
      <div class="modal-backdrop" data-delete-modal aria-hidden="true">
        <div
          class="modal"
          role="dialog"
          aria-modal="true"
          aria-labelledby="delete-modal-title">
          <h2 id="delete-modal-title">Borrar producto</h2>
          <p>
            Estás por borrar <strong data-delete-product-name>—</strong>. Esta
            acción no se puede deshacer.
          </p>
          <form method="POST" data-delete-form>
            <input type="hidden" name="_method" value="DELETE" />
            <div class="modal-actions">
              <button type="button" class="btn btn-ghost" data-delete-cancel>
                Cancelar
              </button>
              <button type="submit" class="btn btn-danger">
                Borrar producto
              </button>
            </div>
          </form>
        </div>
      </div>
    )
  }
</div>

<style>
  .form-shell {
    max-width: 880px;
    margin: 0 auto;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 24px;
  }
  .breadcrumb {
    font-size: 14px;
    color: var(--admin-text-muted);
    margin-bottom: 4px;
  }
  .breadcrumb a {
    color: var(--admin-accent);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb span[aria-hidden] {
    margin: 0 6px;
    color: var(--admin-text-faint);
  }
  .page-subtitle {
    color: var(--admin-text-muted);
    font-size: 14px;
    margin-top: 4px;
  }
  .form-actions {
    display: flex;
    gap: 8px;
  }

  .alert {
    padding: 12px 16px;
    border-radius: var(--admin-radius-sm);
    font-size: 14px;
    margin-bottom: 16px;
  }
  .alert-error {
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }
  .alert-success {
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  .product-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .form-panel {
    padding: 20px 24px;
  }
  .panel-title {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .panel-description {
    font-size: 12px;
    color: var(--admin-text-faint);
    margin-bottom: 14px;
  }

  .form-grid {
    display: grid;
    gap: 14px;
    margin-top: 12px;
  }
  .form-grid.two-col {
    grid-template-columns: 1fr 1fr;
  }
  .form-grid.four-col {
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 720px) {
    .form-grid.two-col,
    .form-grid.four-col {
      grid-template-columns: 1fr;
    }
  }
  .field.full {
    grid-column: 1 / -1;
  }

  .field-hint {
    margin-top: 4px;
    font-size: 11px;
    color: var(--admin-text-faint);
  }
  .field-hint.inline {
    display: inline;
    margin-left: 4px;
    margin-top: 0;
  }

  .slug-input,
  .price-input {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius-sm);
    background: var(--admin-bg);
    overflow: hidden;
  }
  .slug-input:focus-within,
  .price-input:focus-within {
    border-color: var(--admin-accent);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }
  .slug-prefix,
  .price-prefix {
    padding: 10px 0 10px 12px;
    color: var(--admin-text-muted);
    font-size: 14px;
    user-select: none;
  }
  .slug-input input,
  .price-input input {
    flex: 1;
    border: none;
    background: var(--admin-bg-input);
    padding: 10px 12px;
    font-family: inherit;
    font-size: 14px;
    color: var(--admin-text);
    outline: none;
  }
  .price-input input {
    font-variant-numeric: tabular-nums;
  }

  .checkbox-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    cursor: pointer;
    font-size: 14px;
  }
  .checkbox-row input[type="checkbox"] {
    width: 16px;
    height: 16px;
    cursor: pointer;
    accent-color: var(--admin-accent);
  }

  /* Tag input */
  .tag-input {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    padding: 8px;
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius-sm);
    background: var(--admin-bg-input);
    min-height: 44px;
    cursor: text;
  }
  .tag-input:focus-within {
    border-color: var(--admin-accent);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }
  .tag-list {
    display: contents;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 4px 4px 10px;
    background: #dbeafe;
    color: #1e40af;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 500;
  }
  .tag-remove {
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
    padding: 0 4px;
    font-size: 16px;
    line-height: 1;
    border-radius: 50%;
    opacity: 0.6;
  }
  .tag-remove:hover {
    opacity: 1;
  }
  .tag-text-input {
    flex: 1;
    min-width: 120px;
    border: none;
    background: transparent;
    padding: 4px 6px;
    font-family: inherit;
    font-size: 14px;
    color: var(--admin-text);
    outline: none;
  }

  /* Danger zone */
  .danger-zone {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--admin-border);
  }
  .danger-title {
    color: var(--admin-danger);
    font-weight: 600;
    font-size: 14px;
  }
  .danger-description {
    color: var(--admin-text-muted);
    font-size: 12px;
    margin-top: 2px;
  }
  .btn-danger-outline {
    background: #fef2f2;
    color: var(--admin-danger);
    border: 1px solid #fecaca;
  }
  .btn-danger-outline:hover:not(:disabled) {
    background: var(--admin-danger);
    color: #fff;
    border-color: var(--admin-danger);
  }

  /* Modal */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 20px;
  }
  .modal-backdrop[aria-hidden="false"] {
    display: flex;
  }
  .modal {
    background: var(--admin-bg-panel);
    border-radius: var(--admin-radius-lg);
    padding: 24px;
    max-width: 440px;
    width: 100%;
    box-shadow: var(--admin-shadow-lg);
  }
  .modal h2 {
    margin-bottom: 8px;
  }
  .modal p {
    color: var(--admin-text-muted);
    margin-bottom: 20px;
  }
  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }
</style>
