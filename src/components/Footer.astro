---
import { CONTACT, SITE_METADATA } from "@/constants/ui";

const whatsappHref = `https://wa.me/${CONTACT.whatsappE164}`;
---

<footer class="footer" id="contacto">
  <div class="footer-tagline">
    <em>{SITE_METADATA.tagline}</em>
  </div>
  <div class="footer-meta">
    {SITE_METADATA.name} · {SITE_METADATA.location}
  </div>
  <div class="footer-contact">
    <a href={CONTACT.instagramUrl} target="_blank" rel="noopener noreferrer">
      Instagram
    </a>
    <span aria-hidden="true">·</span>
    <a href={whatsappHref} target="_blank" rel="noopener noreferrer">
      WhatsApp
    </a>
  </div>
</footer>

<style>
  .footer {
    text-align: center;
    padding: 32px 20px 28px;
    background: var(--color-bg-deep);
    border-top: 0.5px solid rgba(201, 168, 76, 0.15);
    color: var(--color-text-muted);
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .footer-tagline em {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-gold);
    letter-spacing: 1px;
    text-transform: none;
    font-size: 16px;
  }

  .footer-contact {
    display: flex;
    gap: 12px;
    margin-top: 8px;
  }
  .footer-contact a {
    transition: color var(--transition-fast);
    letter-spacing: 2px;
  }
  .footer-contact a:hover {
    color: var(--color-gold-light);
  }
</style>
