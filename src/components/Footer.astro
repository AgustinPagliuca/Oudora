---
import { CONTACT, DEVELOPER_CREDIT, SITE_METADATA } from "@/constants/ui";
import { LEGAL_LINKS } from "@/constants/legal";

/**
 * Footer en columnas con el logo grande abajo.
 * - Desktop: columnas fijas (las <details> están abiertas y su resumen
 *   no es clickeable).
 * - Mobile: cada columna es un acordeón; arrancan cerradas.
 */

const whatsappHref = `https://wa.me/${CONTACT.whatsappE164}`;
const currentYear = new Date().getFullYear();
---

<footer class="footer" id="contacto">
  <div class="footer-columns">
    <div class="footer-intro">
      <p class="footer-heading">Atención por WhatsApp</p>
      <p class="footer-intro-text">
        Te asesoramos para elegir tu perfume y coordinamos la entrega.
      </p>
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-intro-link"
      >
        Escribinos
      </a>
    </div>

    <details class="footer-group" open data-footer-group>
      <summary class="footer-heading">Tienda</summary>
      <ul>
        <li><a href="/catalogo">Catálogo</a></li>
        <li><a href="/marcas">Marcas</a></li>
      </ul>
    </details>

    <details class="footer-group" open data-footer-group>
      <summary class="footer-heading">{SITE_METADATA.name}</summary>
      <ul>
        <li><a href="/nosotros">Nosotros</a></li>
        <li><a href="/contacto">Contacto</a></li>
        <li>
          <a href={CONTACT.instagramUrl} target="_blank" rel="noopener noreferrer">
            Instagram
          </a>
        </li>
        <li>
          <a href={CONTACT.tiktokUrl} target="_blank" rel="noopener noreferrer">
            TikTok
          </a>
        </li>
      </ul>
    </details>

    <details class="footer-group" open data-footer-group>
      <summary class="footer-heading">Legal</summary>
      <ul>
        {LEGAL_LINKS.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
        <li>
          {/* Revocar o cambiar la decisión de cookies: reabre el banner.
              Lo engancha cookie-consent.ts por el data-attribute. */}
          <button type="button" class="footer-legal-btn" data-cookie-settings>
            Configurar cookies
          </button>
        </li>
      </ul>
    </details>
  </div>

  <p class="footer-wordmark" aria-hidden="true">{SITE_METADATA.name}</p>

  <div class="footer-credit">
    <span>© {currentYear} {SITE_METADATA.name} · {SITE_METADATA.location}</span>
    <span>
      <em class="footer-tagline">{SITE_METADATA.tagline}</em>
      <span aria-hidden="true"> · </span>
      Sitio por <a
        href={DEVELOPER_CREDIT.url}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-credit-link"
      >{DEVELOPER_CREDIT.label}</a>
    </span>
  </div>
</footer>

<script>
  // En mobile los grupos arrancan cerrados (acordeón); en desktop quedan
  // abiertos como columnas.
  if (window.matchMedia("(max-width: 640px)").matches) {
    document
      .querySelectorAll<HTMLDetailsElement>("[data-footer-group]")
      .forEach((group) => {
        group.open = false;
      });
  }
</script>

<style>
  .footer {
    background: var(--color-bg);
    border-top: 1px solid var(--color-border-subtle);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    overflow: hidden;
  }

  .footer-columns {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-6);
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: var(--space-8) clamp(16px, 4vw, 32px) 0;
  }

  .footer-heading {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--color-cream);
  }

  .footer-intro {
    flex: 1 1 280px;
    max-width: 340px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .footer-intro-text {
    line-height: 1.6;
  }
  .footer-intro-link,
  .footer-group a,
  .footer-legal-btn {
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }
  .footer-intro-link {
    color: var(--color-cream);
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  .footer-intro-link:hover,
  .footer-group a:hover,
  .footer-legal-btn:hover {
    color: var(--color-gold-light);
  }

  .footer-group summary {
    list-style: none;
    margin-bottom: var(--space-3);
  }
  .footer-group summary::-webkit-details-marker {
    display: none;
  }
  .footer-group ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  /* Es un <button> porque abre el banner, no navega. */
  .footer-legal-btn {
    font: inherit;
    padding: 0;
    text-align: start;
  }

  /* Desktop: columnas fijas, el resumen no se puede plegar. */
  @media (min-width: 641px) {
    .footer-group {
      min-width: 140px;
    }
    .footer-group summary {
      pointer-events: none;
    }
  }

  /* Logo grande de cierre, decorativo. */
  .footer-wordmark {
    max-width: var(--max-content-width);
    margin: var(--space-7) auto 0;
    padding: 0 clamp(16px, 4vw, 32px);
    font-family: var(--font-serif);
    /* Ocupa el ancho del contenido sin desbordar (≈ 3,5 × font-size). */
    font-size: clamp(4rem, 18vw, 16.5rem);
    line-height: 0.8;
    letter-spacing: 0.06em;
    color: var(--color-cream);
    white-space: nowrap;
  }

  .footer-credit {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: var(--space-5) clamp(16px, 4vw, 32px) var(--space-6);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }
  .footer-tagline {
    font-family: var(--font-serif);
  }
  .footer-credit-link {
    color: var(--color-text-muted);
    border-bottom: 1px solid currentColor;
    transition: color var(--transition-fast);
  }
  .footer-credit-link:hover {
    color: var(--color-gold-light);
  }

  /* Mobile: columnas apiladas como acordeones. */
  @media (max-width: 640px) {
    .footer-columns {
      flex-direction: column;
      gap: 0;
      padding-top: var(--space-6);
    }
    .footer-intro {
      flex: none;
      max-width: none;
      padding-bottom: var(--space-5);
    }
    .footer-group {
      border-top: 1px solid var(--color-border-subtle);
    }
    .footer-group summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      min-height: 52px;
      margin: 0;
      cursor: pointer;
    }
    .footer-group summary::after {
      content: "+";
      font-size: var(--text-lg);
      font-weight: 400;
    }
    .footer-group[open] summary::after {
      content: "−";
    }
    .footer-group ul {
      padding-bottom: var(--space-4);
    }
    .footer-group a,
    .footer-legal-btn {
      display: inline-block;
      padding: var(--space-1) 0;
      font-size: var(--text-base);
    }
    .footer-credit {
      flex-direction: column;
    }
  }
</style>
