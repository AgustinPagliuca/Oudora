---
/**
 * Carrusel del hero. Reemplaza el Hero estático cuando hay slides cargados.
 *
 * Layout v4: full-bleed con drag-to-swipe.
 * - Slides en un track horizontal (display: flex) movido con transform: translateX
 * - Pointer events unificados: funciona con dedo en mobile y mouse en desktop
 * - Durante el drag, el track sigue al dedo en tiempo real (sin transition)
 * - Al soltar, snap a slide vecino si el drag > 18% del ancho o velocidad > 0.4 px/ms
 * - Resistencia elástica en bordes (primer/último slide cuesta más arrastrarlo)
 * - touch-action: pan-y para no pisar el scroll vertical del resto de la página
 */

import type { HeroSlide } from "@/types/catalog";

interface Props {
  slides: readonly HeroSlide[];
}

const { slides } = Astro.props;
const hasMany = slides.length > 1;

/**
 * Parsea {texto} dentro del título como itálica dorada (énfasis).
 */
function parseTitleEmphasis(title: string): Array<{ text: string; emphasis: boolean }> {
  const parts: Array<{ text: string; emphasis: boolean }> = [];
  const regex = /\{([^}]+)\}/g;
  let lastIndex = 0;
  let match: RegExpExecArray | null;
  while ((match = regex.exec(title)) !== null) {
    if (match.index > lastIndex) {
      parts.push({ text: title.slice(lastIndex, match.index), emphasis: false });
    }
    parts.push({ text: match[1], emphasis: true });
    lastIndex = match.index + match[0].length;
  }
  if (lastIndex < title.length) {
    parts.push({ text: title.slice(lastIndex), emphasis: false });
  }
  return parts;
}
---

<section class="hero-carousel" data-hero-carousel data-count={slides.length}>
  <div class="hero-track" data-hero-track>
    {slides.map((slide, idx) => (
      <div class="hero-slide" data-slide={idx}>
        <img
          src={slide.imageUrl}
          alt=""
          class="hero-slide-bg"
          draggable="false"
          loading={idx === 0 ? "eager" : "lazy"}
        />
        <div class="hero-slide-overlay" aria-hidden="true"></div>
        <div class="hero-slide-content">
          <div
            class="hero-slide-text"
            {...(idx === 0 ? { "data-fade-in-on-load": "" } : {})}
          >
            {slide.overline && <p class="hero-slide-overline">{slide.overline}</p>}
            <h1 class="hero-slide-title">
              {parseTitleEmphasis(slide.title).map((p) =>
                p.emphasis ? <em>{p.text}</em> : <>{p.text}</>
              )}
            </h1>
            {slide.subtitle && <p class="hero-slide-subtitle">{slide.subtitle}</p>}
            {slide.ctaLabel && slide.ctaHref && (
              <a href={slide.ctaHref} class="hero-slide-cta">
                <span>{slide.ctaLabel}</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>

  {hasMany && (
    <button type="button" class="hero-arrow hero-arrow-prev" data-hero-prev aria-label="Slide anterior">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
  )}
  {hasMany && (
    <button type="button" class="hero-arrow hero-arrow-next" data-hero-next aria-label="Slide siguiente">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  )}
  {hasMany && (
    <div class="hero-indicators">
      {slides.map((_, idx) => (
        <button
          type="button"
          class="hero-indicator"
          data-indicator={idx}
          data-active={idx === 0 ? "true" : "false"}
          aria-label={`Slide ${idx + 1}`}
        ></button>
      ))}
    </div>
  )}
</section>

{hasMany && (
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const carousel = document.querySelector<HTMLElement>("[data-hero-carousel]");
      const track = document.querySelector<HTMLElement>("[data-hero-track]");
      if (carousel === null || track === null) return;

      const slides = track.querySelectorAll<HTMLElement>("[data-slide]");
      const indicators = carousel.querySelectorAll<HTMLButtonElement>("[data-indicator]");
      const prevBtn = carousel.querySelector<HTMLButtonElement>("[data-hero-prev]");
      const nextBtn = carousel.querySelector<HTMLButtonElement>("[data-hero-next]");

      if (slides.length <= 1) return;

      const AUTO_INTERVAL = 3000;
      // Umbral para considerar que el usuario quiso pasar de slide
      const SWIPE_DISTANCE_PCT = 0.18; // 18% del ancho
      const SWIPE_VELOCITY = 0.4;      // px/ms (gesto rápido aunque corto)
      // Cuanto se "resiste" arrastrar más allá del primer o último slide
      const EDGE_RESISTANCE = 0.4;

      let currentIndex = 0;
      let autoTimer: number | null = null;

      // Estado del drag
      let activePointerId: number | null = null;
      let dragStartX = 0;
      let dragStartTime = 0;
      let dragStartTranslatePct = 0;
      let didDrag = false;

      function setTrackTranslate(pct: number, animated: boolean): void {
        track!.dataset.dragging = animated ? "false" : "true";
        track!.style.transform = `translate3d(${pct}%, 0, 0)`;
      }

      function show(index: number): void {
        currentIndex = Math.max(0, Math.min(slides.length - 1, index));
        setTrackTranslate(-currentIndex * 100, true);
        indicators.forEach((ind, i) => {
          ind.dataset.active = i === currentIndex ? "true" : "false";
        });
      }

      function next(): void { show((currentIndex + 1) % slides.length); }
      function prev(): void { show((currentIndex - 1 + slides.length) % slides.length); }

      function startAuto(): void {
        if (autoTimer !== null) return;
        autoTimer = window.setInterval(next, AUTO_INTERVAL);
      }
      function pauseAuto(): void {
        if (autoTimer !== null) {
          clearInterval(autoTimer);
          autoTimer = null;
        }
      }

      // ─── Drag con pointer events (touch + mouse unificado) ───────────
      carousel.addEventListener("pointerdown", (e) => {
        // Solo botón principal del mouse, o cualquier toque
        if (e.pointerType === "mouse" && e.button !== 0) return;
        if (activePointerId !== null) return;
        // No iniciar drag si tocan un botón/link clickeable: dejarlos funcionar
        const target = e.target as HTMLElement;
        if (target.closest("a, button")) return;

        activePointerId = e.pointerId;
        dragStartX = e.clientX;
        dragStartTime = performance.now();
        dragStartTranslatePct = -currentIndex * 100;
        didDrag = false;
        carousel.setPointerCapture(e.pointerId);
        pauseAuto();
      });

      carousel.addEventListener("pointermove", (e) => {
        if (activePointerId !== e.pointerId) return;
        const deltaX = e.clientX - dragStartX;
        if (Math.abs(deltaX) > 4) didDrag = true;

        const width = carousel.offsetWidth;
        let deltaPct = (deltaX / width) * 100;

        // Resistencia elástica en los bordes
        if (currentIndex === 0 && deltaX > 0) deltaPct *= EDGE_RESISTANCE;
        if (currentIndex === slides.length - 1 && deltaX < 0) deltaPct *= EDGE_RESISTANCE;

        setTrackTranslate(dragStartTranslatePct + deltaPct, false);
      });

      function endDrag(e: PointerEvent, cancelled: boolean): void {
        if (activePointerId !== e.pointerId) return;
        activePointerId = null;

        if (cancelled || !didDrag) {
          // Click sin drag, o cancelado: volver al slide actual
          show(currentIndex);
          startAuto();
          return;
        }

        const deltaX = e.clientX - dragStartX;
        const deltaTime = Math.max(1, performance.now() - dragStartTime);
        const velocity = Math.abs(deltaX) / deltaTime;
        const distancePct = Math.abs(deltaX) / carousel!.offsetWidth;

        let target = currentIndex;
        if (distancePct > SWIPE_DISTANCE_PCT || velocity > SWIPE_VELOCITY) {
          target = deltaX < 0 ? currentIndex + 1 : currentIndex - 1;
          target = Math.max(0, Math.min(slides.length - 1, target));
        }
        show(target);
        startAuto();
      }

      carousel.addEventListener("pointerup", (e) => endDrag(e, false));
      carousel.addEventListener("pointercancel", (e) => endDrag(e, true));

      // ─── Controles tradicionales ────────────────────────────────────
      prevBtn?.addEventListener("click", (e) => {
        e.preventDefault();
        pauseAuto();
        prev();
        startAuto();
      });
      nextBtn?.addEventListener("click", (e) => {
        e.preventDefault();
        pauseAuto();
        next();
        startAuto();
      });
      indicators.forEach((ind) => {
        ind.addEventListener("click", () => {
          const idx = parseInt(ind.dataset.indicator ?? "0", 10);
          pauseAuto();
          show(idx);
          startAuto();
        });
      });

      // Pausar auto-rotate cuando la pestaña no está visible
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) pauseAuto();
        else startAuto();
      });

      startAuto();
    });
  </script>
)}

<style>
  .hero-carousel {
    position: relative;
    background: var(--color-bg-deep);
    overflow: hidden;
    min-height: clamp(440px, 60vh, 620px);
    /* Crítico para el swipe: el browser maneja scroll vertical (pan-y),
       nosotros manejamos el gesto horizontal. Sin esto, el navegador
       compite por capturar el touch y se rompe el drag. */
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Track horizontal de slides; se mueve con transform */
  .hero-track {
    display: flex;
    width: 100%;
    min-height: clamp(440px, 60vh, 620px);
    transform: translate3d(0, 0, 0);
    transition: transform 1s cubic-bezier(0.2, 0.9, 0.3, 1);
    will-change: transform;
  }
  /* Durante drag activo, cero transición: el track sigue al dedo en vivo */
  .hero-track[data-dragging="true"] {
    transition: none;
  }

  .hero-slide {
    position: relative;
    flex: 0 0 100%;
    min-width: 100%;
    min-height: clamp(440px, 60vh, 620px);
  }

  /* Imagen de fondo: cubre todo el slide. draggable=false en el HTML
     más esto, evita la imagen-arrastrable nativa que rompe el gesto. */
  .hero-slide-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
    pointer-events: none;
    -webkit-user-drag: none;
  }

  /* Overlay: degradado horizontal denso a la izquierda → transparente a la derecha */
  .hero-slide-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        to right,
        rgba(7, 6, 5, 0.92) 0%,
        rgba(7, 6, 5, 0.78) 28%,
        rgba(7, 6, 5, 0.4) 55%,
        rgba(7, 6, 5, 0.05) 85%,
        transparent 100%
      ),
      linear-gradient(
        to bottom,
        transparent 60%,
        rgba(7, 6, 5, 0.4) 100%
      );
  }

  .hero-slide-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    min-height: clamp(440px, 60vh, 620px);
    max-width: 1240px;
    margin: 0 auto;
    padding: 60px clamp(24px, 5vw, 72px);
  }

  .hero-slide-text {
    max-width: 560px;
  }

  .hero-slide-overline {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--color-gold);
    margin: 0 0 var(--space-4);
    font-weight: 500;
    position: relative;
    padding-left: 56px;
  }
  .hero-slide-overline::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 40px;
    height: 0.5px;
    background: var(--color-gold);
    opacity: 0.7;
  }

  .hero-slide-title {
    font-family: var(--font-serif);
    font-size: clamp(36px, 5.2vw, 68px);
    font-weight: 400;
    line-height: 1.05;
    color: var(--color-cream);
    margin: 0 0 var(--space-5);
    letter-spacing: var(--tracking-tight);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
  }
  .hero-slide-title em {
    color: var(--color-gold-light);
    font-style: italic;
    font-weight: 400;
  }

  .hero-slide-subtitle {
    font-family: var(--font-sans);
    font-size: clamp(14px, 1.15vw, 16px);
    line-height: 1.7;
    color: var(--color-cream);
    margin: 0 0 var(--space-6);
    max-width: 460px;
    font-weight: 400;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.6);
  }

  /* CTA: misma signature animation que el botón AGREGAR del card —
     coherencia visual en toda la app. Pointer-events: auto para que el
     click no se confunda con drag del carousel. */
  .hero-slide-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 32px;
    border: 0.5px solid var(--color-gold);
    color: var(--color-gold-light);
    background: rgba(7, 6, 5, 0.55);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-weight: 600;
    backdrop-filter: blur(4px);
    overflow: hidden;
    isolation: isolate;
    transition: color 0.35s var(--ease-premium),
                transform 0.35s var(--ease-premium),
                border-color 0.35s var(--ease-premium);
  }
  .hero-slide-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-gold);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.4s var(--ease-premium);
    z-index: -1;
  }
  .hero-slide-cta:hover {
    color: var(--color-bg);
    border-color: var(--color-gold);
    transform: translateX(3px);
  }
  .hero-slide-cta:hover::before {
    clip-path: inset(0 0 0 0);
  }

  .hero-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.55);
    border: 0.5px solid rgba(212, 179, 92, 0.3);
    color: var(--color-gold);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-default);
    backdrop-filter: blur(4px);
  }
  .hero-arrow:hover {
    background: rgba(0, 0, 0, 0.8);
    border-color: var(--color-gold);
  }
  .hero-arrow-prev { left: 18px; }
  .hero-arrow-next { right: 18px; }

  .hero-indicators {
    position: absolute;
    bottom: 26px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 3;
  }
  .hero-indicator {
    width: 14px;
    height: 3px;
    border-radius: 2px;
    background: rgba(245, 237, 216, 0.4);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all var(--transition-default);
  }
  .hero-indicator:hover {
    background: rgba(245, 237, 216, 0.7);
  }
  .hero-indicator[data-active="true"] {
    width: 32px;
    background: var(--color-gold-light);
  }

  /* Mobile: degradado vertical para que texto al pie quede legible */
  @media (max-width: 720px) {
    .hero-carousel,
    .hero-track,
    .hero-slide,
    .hero-slide-content {
      min-height: clamp(480px, 78vh, 620px);
    }
    .hero-slide-overlay {
      background:
        linear-gradient(
          to bottom,
          transparent 0%,
          rgba(7, 6, 5, 0.35) 40%,
          rgba(7, 6, 5, 0.85) 70%,
          rgba(7, 6, 5, 0.96) 100%
        );
    }
    .hero-slide-content {
      align-items: flex-end;
      padding: 32px 24px 64px;
    }
    .hero-slide-text {
      max-width: 100%;
    }
    .hero-slide-title {
      font-size: clamp(30px, 8vw, 42px);
    }
    /* En mobile escondemos las flechas: ya tenés swipe */
    .hero-arrow {
      display: none;
    }
    .hero-indicators {
      bottom: 18px;
    }
  }
</style>
