---
/**
 * Carrusel del hero. Reemplaza el Hero estático cuando hay slides cargados.
 *
 * Layout v4: full-bleed con drag-to-swipe.
 * - Slides en un track horizontal (display: flex) movido con transform: translateX
 * - Pointer events unificados: funciona con dedo en mobile y mouse en desktop
 * - Durante el drag, el track sigue al dedo en tiempo real (sin transition)
 * - Al soltar, snap a slide vecino si el drag > 18% del ancho o velocidad > 0.4 px/ms
 * - Resistencia elástica en bordes (primer/último slide cuesta más arrastrarlo)
 * - touch-action: pan-y para no pisar el scroll vertical del resto de la página
 */

import type { HeroSlide } from "@/types/catalog";

interface Props {
  slides: readonly HeroSlide[];
}

const { slides } = Astro.props;
const hasMany = slides.length > 1;

/**
 * Parsea {texto} dentro del título como itálica dorada (énfasis).
 */
function parseTitleEmphasis(title: string): Array<{ text: string; emphasis: boolean }> {
  const parts: Array<{ text: string; emphasis: boolean }> = [];
  const regex = /\{([^}]+)\}/g;
  let lastIndex = 0;
  let match: RegExpExecArray | null;
  while ((match = regex.exec(title)) !== null) {
    if (match.index > lastIndex) {
      parts.push({ text: title.slice(lastIndex, match.index), emphasis: false });
    }
    parts.push({ text: match[1], emphasis: true });
    lastIndex = match.index + match[0].length;
  }
  if (lastIndex < title.length) {
    parts.push({ text: title.slice(lastIndex), emphasis: false });
  }
  return parts;
}
---

{/* Entrada animada solo en la primera visita al inicio de la sesión: si
    vuelve desde otra página no se repite. Corre antes de pintar el hero. */}
<script is:inline>
  try {
    if (sessionStorage.getItem("oudora.heroIntro") === null) {
      document.documentElement.dataset.heroIntro = "";
      sessionStorage.setItem("oudora.heroIntro", "1");
    }
  } catch (e) {}
</script>

<section class="hero-carousel" data-hero-carousel data-count={slides.length}>
  <div class="hero-track" data-hero-track>
    {slides.map((slide, idx) => (
      <div class="hero-slide" data-slide={idx}>
        <img
          src={slide.imageUrl}
          alt=""
          class="hero-slide-bg"
          draggable="false"
          loading={idx === 0 ? "eager" : "lazy"}
          fetchpriority={idx === 0 ? "high" : "low"}
        />
        <div class="hero-slide-overlay" aria-hidden="true"></div>
        <div class="hero-slide-content">
          <div
            class="hero-slide-text"
            {...(idx === 0 ? { "data-fade-in-on-load": "" } : {})}
          >
            <h1 class="hero-slide-title">
              {parseTitleEmphasis(slide.title).map((p) =>
                p.emphasis ? <em>{p.text}</em> : <>{p.text}</>
              )}
            </h1>
            {slide.subtitle && <p class="hero-slide-subtitle">{slide.subtitle}</p>}
            {slide.ctaLabel && slide.ctaHref && (
              <a href={slide.ctaHref} class="hero-slide-cta">
                <span>{slide.ctaLabel}</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>

  {hasMany && (
    <button type="button" class="hero-arrow hero-arrow-prev" data-hero-prev aria-label="Slide anterior">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
  )}
  {hasMany && (
    <button type="button" class="hero-arrow hero-arrow-next" data-hero-next aria-label="Slide siguiente">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  )}
  {hasMany && (
    <div class="hero-controls">
      <span class="hero-counter" data-hero-counter aria-hidden="true">01 / {String(slides.length).padStart(2, "0")}</span>
      <div class="hero-indicators">
        {slides.map((_, idx) => (
          <button
            type="button"
            class="hero-indicator"
            data-indicator={idx}
            data-active={idx === 0 ? "true" : "false"}
            aria-label={`Slide ${idx + 1}`}
          ></button>
        ))}
      </div>
      <button
        type="button"
        class="hero-pause"
        data-hero-pause
        aria-label="Pausar el carrusel"
        aria-pressed="false"
      >
        <svg class="hero-pause-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <rect x="6" y="5" width="4" height="14"></rect>
          <rect x="14" y="5" width="4" height="14"></rect>
        </svg>
        <svg class="hero-play-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M7 5v14l12-7z"></path>
        </svg>
      </button>
    </div>
  )}
</section>

{/* Alto de pantalla completa: mide dónde empieza el hero (debajo del aviso
    y la nav) y el alto de la nav, para que el hero llene el resto exacto. */}
<script is:inline>
  (function () {
    var root = document.documentElement;
    var hero = document.querySelector("[data-hero-carousel]");
    var nav = document.querySelector("nav.nav");
    if (hero === null) return;
    function measure() {
      if (nav !== null) root.style.setProperty("--nav-h", nav.offsetHeight + "px");
      // Con el hero pegado (sticky) su posición cambia al scrollear: solo se
      // mide arriba de todo.
      if (window.scrollY === 0) {
        root.style.setProperty("--hero-top", Math.round(hero.getBoundingClientRect().top) + "px");
      }
    }
    measure();
    window.addEventListener("resize", measure);
    window.addEventListener("load", measure);
  })();
</script>

{hasMany && (
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const carousel = document.querySelector<HTMLElement>("[data-hero-carousel]");
      const track = document.querySelector<HTMLElement>("[data-hero-track]");
      if (carousel === null || track === null) return;

      const slides = track.querySelectorAll<HTMLElement>("[data-slide]");
      const indicators = carousel.querySelectorAll<HTMLButtonElement>("[data-indicator]");
      const prevBtn = carousel.querySelector<HTMLButtonElement>("[data-hero-prev]");
      const nextBtn = carousel.querySelector<HTMLButtonElement>("[data-hero-next]");
      const pauseBtn = carousel.querySelector<HTMLButtonElement>("[data-hero-pause]");
      const counter = carousel.querySelector<HTMLElement>("[data-hero-counter]");

      if (slides.length <= 1) return;

      const AUTO_INTERVAL = 3000;
      // Umbral para considerar que el usuario quiso pasar de slide
      const SWIPE_DISTANCE_PCT = 0.18; // 18% del ancho
      const SWIPE_VELOCITY = 0.4;      // px/ms (gesto rápido aunque corto)
      // Cuanto se "resiste" arrastrar más allá del primer o último slide
      const EDGE_RESISTANCE = 0.4;

      let currentIndex = 0;
      let autoTimer: number | null = null;
      // Pausa elegida por el usuario (botón) o por preferir menos movimiento:
      // mientras esté activa, el carrusel no avanza solo.
      let userPaused = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Estado del drag
      let activePointerId: number | null = null;
      let dragStartX = 0;
      let dragStartTime = 0;
      let dragStartTranslatePct = 0;
      let didDrag = false;

      function setTrackTranslate(pct: number, animated: boolean): void {
        track!.dataset.dragging = animated ? "false" : "true";
        track!.style.transform = `translate3d(${pct}%, 0, 0)`;
      }

      function show(index: number): void {
        currentIndex = Math.max(0, Math.min(slides.length - 1, index));
        setTrackTranslate(-currentIndex * 100, true);
        indicators.forEach((ind, i) => {
          ind.dataset.active = i === currentIndex ? "true" : "false";
        });
        if (counter !== null) {
          const pad = (n: number): string => String(n).padStart(2, "0");
          counter.textContent = `${pad(currentIndex + 1)} / ${pad(slides.length)}`;
        }
      }

      function next(): void { show((currentIndex + 1) % slides.length); }
      function prev(): void { show((currentIndex - 1 + slides.length) % slides.length); }

      function startAuto(): void {
        if (autoTimer !== null || userPaused) return;
        autoTimer = window.setInterval(next, AUTO_INTERVAL);
      }
      function pauseAuto(): void {
        if (autoTimer !== null) {
          clearInterval(autoTimer);
          autoTimer = null;
        }
      }

      // ─── Drag con pointer events (touch + mouse unificado) ───────────
      carousel.addEventListener("pointerdown", (e) => {
        // Solo botón principal del mouse, o cualquier toque
        if (e.pointerType === "mouse" && e.button !== 0) return;
        if (activePointerId !== null) return;
        // No iniciar drag si tocan un botón/link clickeable: dejarlos funcionar
        const target = e.target as HTMLElement;
        if (target.closest("a, button")) return;

        activePointerId = e.pointerId;
        dragStartX = e.clientX;
        dragStartTime = performance.now();
        dragStartTranslatePct = -currentIndex * 100;
        didDrag = false;
        carousel.setPointerCapture(e.pointerId);
        pauseAuto();
      });

      carousel.addEventListener("pointermove", (e) => {
        if (activePointerId !== e.pointerId) return;
        const deltaX = e.clientX - dragStartX;
        if (Math.abs(deltaX) > 4) didDrag = true;

        const width = carousel.offsetWidth;
        let deltaPct = (deltaX / width) * 100;

        // Resistencia elástica en los bordes
        if (currentIndex === 0 && deltaX > 0) deltaPct *= EDGE_RESISTANCE;
        if (currentIndex === slides.length - 1 && deltaX < 0) deltaPct *= EDGE_RESISTANCE;

        setTrackTranslate(dragStartTranslatePct + deltaPct, false);
      });

      function endDrag(e: PointerEvent, cancelled: boolean): void {
        if (activePointerId !== e.pointerId) return;
        activePointerId = null;

        if (cancelled || !didDrag) {
          // Click sin drag, o cancelado: volver al slide actual
          show(currentIndex);
          startAuto();
          return;
        }

        const deltaX = e.clientX - dragStartX;
        const deltaTime = Math.max(1, performance.now() - dragStartTime);
        const velocity = Math.abs(deltaX) / deltaTime;
        const distancePct = Math.abs(deltaX) / carousel!.offsetWidth;

        let target = currentIndex;
        if (distancePct > SWIPE_DISTANCE_PCT || velocity > SWIPE_VELOCITY) {
          target = deltaX < 0 ? currentIndex + 1 : currentIndex - 1;
          target = Math.max(0, Math.min(slides.length - 1, target));
        }
        show(target);
        startAuto();
      }

      carousel.addEventListener("pointerup", (e) => endDrag(e, false));
      carousel.addEventListener("pointercancel", (e) => endDrag(e, true));

      // ─── Controles tradicionales ────────────────────────────────────
      prevBtn?.addEventListener("click", (e) => {
        e.preventDefault();
        pauseAuto();
        prev();
        startAuto();
      });
      nextBtn?.addEventListener("click", (e) => {
        e.preventDefault();
        pauseAuto();
        next();
        startAuto();
      });
      indicators.forEach((ind) => {
        ind.addEventListener("click", () => {
          const idx = parseInt(ind.dataset.indicator ?? "0", 10);
          pauseAuto();
          show(idx);
          startAuto();
        });
      });

      function syncPauseButton(): void {
        if (pauseBtn === null) return;
        pauseBtn.setAttribute("aria-pressed", userPaused ? "true" : "false");
        pauseBtn.setAttribute(
          "aria-label",
          userPaused ? "Reanudar el carrusel" : "Pausar el carrusel",
        );
      }
      pauseBtn?.addEventListener("click", () => {
        userPaused = !userPaused;
        if (userPaused) pauseAuto();
        else startAuto();
        syncPauseButton();
      });
      syncPauseButton();

      // Pausar auto-rotate cuando la pestaña no está visible
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) pauseAuto();
        else startAuto();
      });

      // Con la entrada animada, el primer slide se queda un poco más.
      const introDelay = document.documentElement.hasAttribute("data-hero-intro") ? 3500 : 0;
      window.setTimeout(startAuto, introDelay);
    });
  </script>
)}

<style>
  .hero-carousel {
    /* Pantalla completa menos el aviso y la nav (los mide el script). */
    --hero-h: max(480px, calc(100svh - var(--hero-top, 120px)));
    position: relative;
    background: var(--color-bg-deep);
    overflow: hidden;
    min-height: var(--hero-h);
    /* Crítico para el swipe: el browser maneja scroll vertical (pan-y),
       nosotros manejamos el gesto horizontal. Sin esto, el navegador
       compite por capturar el touch y se rompe el drag. */
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Track horizontal de slides; se mueve con transform */
  .hero-track {
    display: flex;
    width: 100%;
    min-height: var(--hero-h);
    transform: translate3d(0, 0, 0);
    transition: transform 1s cubic-bezier(0.2, 0.9, 0.3, 1);
    will-change: transform;
  }
  /* Durante drag activo, cero transición: el track sigue al dedo en vivo */
  .hero-track[data-dragging="true"] {
    transition: none;
  }

  .hero-slide {
    position: relative;
    flex: 0 0 100%;
    min-width: 100%;
    min-height: var(--hero-h);
  }

  /* Imagen de fondo: cubre todo el slide. draggable=false en el HTML
     más esto, evita la imagen-arrastrable nativa que rompe el gesto. */
  .hero-slide-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
    pointer-events: none;
    -webkit-user-drag: none;
  }

  /* Overlay: degradado horizontal denso a la izquierda → transparente a la derecha */
  .hero-slide-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        to right,
        rgba(7, 6, 5, 0.92) 0%,
        rgba(7, 6, 5, 0.78) 28%,
        rgba(7, 6, 5, 0.4) 55%,
        rgba(7, 6, 5, 0.05) 85%,
        transparent 100%
      ),
      linear-gradient(
        to bottom,
        transparent 60%,
        rgba(7, 6, 5, 0.4) 100%
      );
  }

  .hero-slide-content {
    position: relative;
    z-index: 2;
    display: flex;
    /* Texto abajo a la izquierda, estilo editorial. */
    align-items: flex-end;
    min-height: var(--hero-h);
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: var(--space-8) clamp(24px, 5vw, 72px) var(--space-9);
  }

  .hero-slide-text {
    max-width: 640px;
  }

  .hero-slide-title {
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 1.6rem + 4vw, 5rem);
    font-weight: 400;
    line-height: 1;
    color: var(--color-cream);
    margin: 0 0 var(--space-5);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
  }
  .hero-slide-title em {
    color: var(--color-gold-light);
    font-style: italic;
    font-weight: 400;
  }

  .hero-slide-subtitle {
    font-family: var(--font-sans);
    font-size: clamp(14px, 1.15vw, 16px);
    line-height: 1.7;
    color: var(--color-cream);
    margin: 0 0 var(--space-6);
    max-width: 460px;
    font-weight: 400;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.6);
  }

  /* CTA: botón rectangular claro; el hover solo cambia el color. */
  .hero-slide-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 48px;
    padding: 0 var(--space-6);
    background: var(--color-cream);
    color: var(--color-bg);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 700;
    transition: background-color var(--transition-fast);
  }
  .hero-slide-cta:hover {
    background: #ffffff;
  }
  .hero-slide-cta:focus-visible {
    outline: 2px solid var(--color-gold-light);
    outline-offset: 3px;
  }

  .hero-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: 1px solid rgba(245, 237, 216, 0.4);
    color: var(--color-cream);
    width: 44px;
    height: 44px;
    border-radius: var(--radius-circle);
    cursor: pointer;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }
  .hero-arrow:hover {
    border-color: var(--color-cream);
    color: #ffffff;
  }
  .hero-arrow-prev { left: 18px; }
  .hero-arrow-next { right: 18px; }

  /* Indicadores y pausa abajo a la derecha. */
  .hero-controls {
    position: absolute;
    bottom: var(--space-6);
    right: clamp(24px, 5vw, 72px);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    z-index: 3;
  }
  /* Contador "01 / 03" (visual; los indicadores ya tienen su etiqueta). */
  .hero-counter {
    font-size: var(--text-sm);
    color: var(--color-cream);
    font-variant-numeric: tabular-nums lining-nums;
    /* En mobile los controles van centrados en poco ancho: sin esto el
       contador se partía en "01 /" y "03". */
    white-space: nowrap;
  }
  .hero-indicators {
    display: flex;
    gap: var(--space-2);
  }
  /* Línea visible fina, con área de toque de 24px de alto. */
  .hero-indicator {
    width: 28px;
    height: 24px;
    border: none;
    padding: 0;
    cursor: pointer;
    background: linear-gradient(rgba(245, 237, 216, 0.4), rgba(245, 237, 216, 0.4))
      center / 100% 2px no-repeat;
    transition: background-size var(--transition-fast);
  }
  .hero-indicator:hover,
  .hero-indicator[data-active="true"] {
    background-image: linear-gradient(var(--color-cream), var(--color-cream));
  }
  .hero-pause {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-cream);
  }
  .hero-pause:hover {
    color: #ffffff;
  }
  .hero-play-icon,
  .hero-pause[aria-pressed="true"] .hero-pause-icon {
    display: none;
  }
  .hero-pause[aria-pressed="true"] .hero-play-icon {
    display: block;
  }

  /* Mobile: degradado vertical para que texto al pie quede legible */
  @media (max-width: 720px) {
    .hero-slide-overlay {
      background:
        linear-gradient(
          to bottom,
          transparent 0%,
          rgba(7, 6, 5, 0.35) 40%,
          rgba(7, 6, 5, 0.85) 70%,
          rgba(7, 6, 5, 0.96) 100%
        );
    }
    .hero-slide-content {
      align-items: flex-end;
      padding: var(--space-6) var(--space-5) 88px;
    }
    .hero-slide-text {
      max-width: 100%;
    }
    .hero-slide-cta {
      display: flex;
      justify-content: center;
    }
    /* En mobile escondemos las flechas: ya tenés swipe */
    .hero-arrow {
      display: none;
    }
    .hero-controls {
      bottom: var(--space-4);
      left: 50%;
      right: auto;
      translate: -50% 0;
    }
  }

  /* ── Entrada y repliegue (estilo "la página se despliega") ─────────
     Entrada: la foto aparece con un zoom que se asienta y el texto sube
     por partes. Al scrollear, el hero queda pegado detrás y se achica y
     oscurece mientras el resto de la página sube por encima (la línea de
     tiempo --home-unfold la define index.astro). Todo el movimiento va
     dentro de prefers-reduced-motion: no-preference. */
  @media (prefers-reduced-motion: no-preference) {
    :global(:root[data-hero-intro]) .hero-slide[data-slide="0"] .hero-slide-bg {
      animation: hero-intro-image 2.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    :global(:root[data-hero-intro]) .hero-slide[data-slide="0"] .hero-slide-overlay {
      animation: hero-intro-fade 1.4s ease 0.2s both;
    }
    :global(:root[data-hero-intro]) .hero-slide-text[data-fade-in-on-load] {
      animation: none;
    }
    :global(:root[data-hero-intro]) .hero-slide-text[data-fade-in-on-load] > * {
      animation: hero-intro-rise 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.7s both;
    }
    :global(:root[data-hero-intro]) .hero-slide-text[data-fade-in-on-load] > :nth-child(2) {
      animation-delay: 0.9s;
    }
    :global(:root[data-hero-intro]) .hero-slide-text[data-fade-in-on-load] > :nth-child(3) {
      animation-delay: 1.1s;
    }
    :global(:root[data-hero-intro]) .hero-controls,
    :global(:root[data-hero-intro]) .hero-arrow {
      animation: hero-intro-fade 0.8s ease 1.5s both;
    }

    .hero-carousel {
      position: sticky;
      top: var(--nav-h, 0px);
    }
    @supports (animation-timeline: view()) and (timeline-scope: none) {
      .hero-carousel {
        animation: hero-recede linear both;
        animation-timeline: --home-unfold;
        animation-range: entry 0% entry 100%;
      }
      .hero-slide-content {
        animation: hero-content-out linear both;
        animation-timeline: --home-unfold;
        animation-range: entry 0% entry 50%;
      }
    }
  }

  @keyframes hero-intro-image {
    from {
      opacity: 0;
      transform: scale(1.15);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes hero-intro-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes hero-intro-rise {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }
  @keyframes hero-recede {
    to {
      transform: scale(0.9);
      filter: brightness(0.4);
    }
  }
  @keyframes hero-content-out {
    to {
      opacity: 0;
      transform: translateY(-64px);
    }
  }
</style>
