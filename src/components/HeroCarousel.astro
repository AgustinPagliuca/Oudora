---
/**
 * Carrusel del hero. Reemplaza el Hero estático cuando hay slides cargados.
 *
 * Layout v3: full-bleed — la imagen ocupa todo el espacio, el texto va arriba
 * sobre un degradado oscuro (izquierda densa, derecha transparente) que garantiza
 * legibilidad sin tapar la imagen. Patrón estándar de hero en luxury ecommerce.
 *
 * - 1 slide: estático, sin controles ni auto-rotate
 * - 2+ slides: auto-rotate cada 7s, flechas, indicadores
 * - Mobile: el degradado es vertical (arriba transparente, abajo denso), texto al pie
 */

import type { HeroSlide } from "@/types/catalog";

interface Props {
  slides: readonly HeroSlide[];
}

const { slides } = Astro.props;
const hasMany = slides.length > 1;

/**
 * Parsea {texto} dentro del título como itálica dorada (énfasis).
 * Ej: "Perfumes {árabes} de colección" → "Perfumes <em>árabes</em> de colección"
 */
function parseTitleEmphasis(title: string): Array<{ text: string; emphasis: boolean }> {
  const parts: Array<{ text: string; emphasis: boolean }> = [];
  const regex = /\{([^}]+)\}/g;
  let lastIndex = 0;
  let match: RegExpExecArray | null;
  while ((match = regex.exec(title)) !== null) {
    if (match.index > lastIndex) {
      parts.push({ text: title.slice(lastIndex, match.index), emphasis: false });
    }
    parts.push({ text: match[1], emphasis: true });
    lastIndex = match.index + match[0].length;
  }
  if (lastIndex < title.length) {
    parts.push({ text: title.slice(lastIndex), emphasis: false });
  }
  return parts;
}
---

<section class="hero-carousel" data-hero-carousel data-count={slides.length}>
  {slides.map((slide, idx) => (
    <div class="hero-slide" data-slide={idx} data-active={idx === 0 ? "true" : "false"}>
      <img
        src={slide.imageUrl}
        alt=""
        class="hero-slide-bg"
        loading={idx === 0 ? "eager" : "lazy"}
      />
      <div class="hero-slide-overlay" aria-hidden="true"></div>
      <div class="hero-slide-content">
        <div class="hero-slide-text">
          {slide.overline && <p class="hero-slide-overline">{slide.overline}</p>}
          <h1 class="hero-slide-title">
            {parseTitleEmphasis(slide.title).map((p) =>
              p.emphasis ? <em>{p.text}</em> : <>{p.text}</>
            )}
          </h1>
          {slide.subtitle && <p class="hero-slide-subtitle">{slide.subtitle}</p>}
          {slide.ctaLabel && slide.ctaHref && (
            <a href={slide.ctaHref} class="hero-slide-cta">
              <span>{slide.ctaLabel}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>
  ))}

  {hasMany && (
    <button type="button" class="hero-arrow hero-arrow-prev" data-hero-prev aria-label="Slide anterior">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
  )}
  {hasMany && (
    <button type="button" class="hero-arrow hero-arrow-next" data-hero-next aria-label="Slide siguiente">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  )}
  {hasMany && (
    <div class="hero-indicators">
      {slides.map((_, idx) => (
        <button
          type="button"
          class="hero-indicator"
          data-indicator={idx}
          data-active={idx === 0 ? "true" : "false"}
          aria-label={`Slide ${idx + 1}`}
        ></button>
      ))}
    </div>
  )}
</section>

{hasMany && (
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const carousel = document.querySelector<HTMLElement>("[data-hero-carousel]");
      if (carousel === null) return;

      const slides = carousel.querySelectorAll<HTMLElement>("[data-slide]");
      const indicators = carousel.querySelectorAll<HTMLButtonElement>("[data-indicator]");
      const prevBtn = carousel.querySelector<HTMLButtonElement>("[data-hero-prev]");
      const nextBtn = carousel.querySelector<HTMLButtonElement>("[data-hero-next]");

      if (slides.length <= 1) return;

      let currentIndex = 0;
      let autoTimer: number | null = null;
      const AUTO_INTERVAL = 7000;

      function show(index: number): void {
        slides.forEach((s, i) => {
          s.dataset.active = i === index ? "true" : "false";
        });
        indicators.forEach((ind, i) => {
          ind.dataset.active = i === index ? "true" : "false";
        });
        currentIndex = index;
      }

      function next(): void { show((currentIndex + 1) % slides.length); }
      function prev(): void { show((currentIndex - 1 + slides.length) % slides.length); }

      function startAuto(): void {
        if (autoTimer !== null) return;
        autoTimer = window.setInterval(next, AUTO_INTERVAL);
      }
      function pauseAuto(): void {
        if (autoTimer !== null) {
          clearInterval(autoTimer);
          autoTimer = null;
        }
      }

      prevBtn?.addEventListener("click", () => { pauseAuto(); prev(); startAuto(); });
      nextBtn?.addEventListener("click", () => { pauseAuto(); next(); startAuto(); });

      indicators.forEach((ind) => {
        ind.addEventListener("click", () => {
          const idx = parseInt(ind.dataset.indicator ?? "0", 10);
          pauseAuto();
          show(idx);
          startAuto();
        });
      });

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) pauseAuto();
        else startAuto();
      });

      startAuto();
    });
  </script>
)}

<style>
  .hero-carousel {
    position: relative;
    background: var(--color-bg-deep);
    overflow: hidden;
    min-height: clamp(440px, 60vh, 620px);
  }

  /* Slide ocupa todo el contenedor. Solo el activo se muestra. */
  .hero-slide {
    position: relative;
    width: 100%;
    min-height: clamp(440px, 60vh, 620px);
    display: none;
  }
  .hero-slide[data-active="true"] {
    display: block;
  }

  /* Imagen de fondo: cubre todo el slide */
  .hero-slide-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  /* Overlay: degradado horizontal denso a la izquierda → transparente a la derecha.
     Esto crea una "zona segura" para el texto sin matar la imagen. */
  .hero-slide-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        to right,
        rgba(7, 6, 5, 0.92) 0%,
        rgba(7, 6, 5, 0.78) 28%,
        rgba(7, 6, 5, 0.4) 55%,
        rgba(7, 6, 5, 0.05) 85%,
        transparent 100%
      ),
      linear-gradient(
        to bottom,
        transparent 60%,
        rgba(7, 6, 5, 0.4) 100%
      );
  }

  /* Container del texto, centrado verticalmente, ancho contenido */
  .hero-slide-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    min-height: clamp(440px, 60vh, 620px);
    max-width: 1240px;
    margin: 0 auto;
    padding: 60px clamp(24px, 5vw, 72px);
  }

  .hero-slide-text {
    max-width: 560px;
  }

  .hero-slide-overline {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--color-gold);
    margin: 0 0 20px;
    font-weight: 500;
    position: relative;
    padding-left: 56px;
  }
  .hero-slide-overline::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 40px;
    height: 1px;
    background: var(--color-gold);
    opacity: 0.7;
  }

  .hero-slide-title {
    font-family: var(--font-serif);
    font-size: clamp(36px, 5.2vw, 68px);
    font-weight: 400;
    line-height: 1.05;
    color: var(--color-cream);
    margin: 0 0 22px;
    letter-spacing: 0;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
  }
  .hero-slide-title em {
    color: var(--color-gold-light);
    font-style: italic;
    font-weight: 400;
  }

  .hero-slide-subtitle {
    font-family: var(--font-sans);
    font-size: clamp(14px, 1.15vw, 16px);
    line-height: 1.7;
    color: var(--color-cream);
    margin: 0 0 36px;
    max-width: 460px;
    font-weight: 400;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.6);
  }

  .hero-slide-cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 32px;
    border: 0.5px solid var(--color-gold);
    color: var(--color-gold-light);
    background: rgba(7, 6, 5, 0.55);
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-weight: 600;
    backdrop-filter: blur(4px);
    transition: all var(--transition-default);
  }
  .hero-slide-cta:hover {
    background: rgba(201, 168, 76, 0.22);
    transform: translateX(3px);
    border-color: var(--color-gold-light);
  }

  /* Flechas y indicadores: posicionados sobre toda la sección */
  .hero-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.55);
    border: 0.5px solid rgba(212, 179, 92, 0.3);
    color: var(--color-gold);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-default);
    backdrop-filter: blur(4px);
  }
  .hero-arrow:hover {
    background: rgba(0, 0, 0, 0.8);
    border-color: var(--color-gold);
  }
  .hero-arrow-prev { left: 18px; }
  .hero-arrow-next { right: 18px; }

  .hero-indicators {
    position: absolute;
    bottom: 26px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 3;
  }
  .hero-indicator {
    width: 14px;
    height: 3px;
    border-radius: 2px;
    background: rgba(245, 237, 216, 0.4);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all var(--transition-default);
  }
  .hero-indicator:hover {
    background: rgba(245, 237, 216, 0.7);
  }
  .hero-indicator[data-active="true"] {
    width: 32px;
    background: var(--color-gold-light);
  }

  /* Mobile: el degradado pasa a ser vertical (arriba transparente, abajo denso)
     para que la imagen se vea de lleno arriba y el texto se lea limpio abajo. */
  @media (max-width: 720px) {
    .hero-carousel,
    .hero-slide,
    .hero-slide-content {
      min-height: clamp(480px, 78vh, 620px);
    }
    .hero-slide-overlay {
      background:
        linear-gradient(
          to bottom,
          transparent 0%,
          rgba(7, 6, 5, 0.35) 40%,
          rgba(7, 6, 5, 0.85) 70%,
          rgba(7, 6, 5, 0.96) 100%
        );
    }
    .hero-slide-content {
      align-items: flex-end;
      padding: 32px 24px 64px;
    }
    .hero-slide-text {
      max-width: 100%;
    }
    .hero-slide-title {
      font-size: clamp(30px, 8vw, 42px);
    }
    .hero-arrow {
      width: 38px;
      height: 38px;
      top: 38%;
    }
    .hero-arrow-prev { left: 10px; }
    .hero-arrow-next { right: 10px; }
    .hero-indicators {
      bottom: 18px;
    }
  }
</style>
