---
import Breadcrumbs from "@/components/Breadcrumbs.astro";

interface Crumb {
  readonly label: string;
  readonly href?: string;
}

interface Props {
  title: string;
  highlight?: string;
  subtitle?: string;
  breadcrumbsTrail?: readonly Crumb[];
}

const { title, highlight, subtitle, breadcrumbsTrail } = Astro.props;
---

<header class="page-header">
  {breadcrumbsTrail !== undefined && (
    <div class="page-header-breadcrumbs">
      <Breadcrumbs trail={breadcrumbsTrail} />
    </div>
  )}
  <h1 class="page-header-title">
    {title}
    {highlight && <em>{highlight}</em>}
  </h1>
  {subtitle && <p class="page-header-subtitle">{subtitle}</p>}
</header>

<style>
  .page-header {
    padding: 32px 24px 28px;
    text-align: center;
    background: radial-gradient(
      ellipse 60% 80% at 50% 0%,
      #1c1910 0%,
      var(--color-bg) 70%
    );
  }

  /* Breadcrumbs dentro del header: centradas, sin el padding propio que
     traen por default. */
  .page-header-breadcrumbs :global(.breadcrumbs) {
    padding: 0;
    margin: 0 0 16px;
  }
  .page-header-breadcrumbs :global(.breadcrumbs ol) {
    justify-content: center;
  }

  .page-header-title {
    font-family: var(--font-serif);
    font-size: clamp(26px, 4vw, 38px);
    color: var(--color-cream);
    letter-spacing: var(--tracking-tight);
    font-weight: 400;
    line-height: 1.1;
  }
  .page-header-title em {
    color: var(--color-gold);
    font-style: italic;
  }

  .page-header-subtitle {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-uppercase);
    color: var(--color-text-muted);
    margin-top: 8px;
    text-transform: uppercase;
  }
</style>
