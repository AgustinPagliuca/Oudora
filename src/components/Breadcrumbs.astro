---
interface Crumb {
  readonly label: string;
  readonly href?: string;
}

interface Props {
  trail: readonly Crumb[];
}

const { trail } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Migas de navegación">
  <ol>
    {
      trail.map((crumb, index) => (
        <li>
          {crumb.href !== undefined && index < trail.length - 1 ? (
            <a href={crumb.href}>{crumb.label}</a>
          ) : (
            <span aria-current={index === trail.length - 1 ? "page" : undefined}>
              {crumb.label}
            </span>
          )}
          {index < trail.length - 1 && (
            <span class="breadcrumbs-sep" aria-hidden="true">
              ·
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    padding: 14px 24px 0;
    max-width: var(--max-content-width);
    margin: 0 auto;
  }
  .breadcrumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .breadcrumbs a {
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }
  .breadcrumbs a:hover {
    color: var(--color-gold-light);
  }
  .breadcrumbs [aria-current="page"] {
    color: var(--color-gold-light);
  }
  .breadcrumbs-sep {
    color: var(--color-gold);
    opacity: 0.5;
  }
</style>
