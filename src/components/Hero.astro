---
import { SITE_METADATA } from "@/constants/ui";
import PerfumeBottle from "./PerfumeBottle.astro";
---

<section class="hero" id="inicio">
  <div class="hero-content">
    <p class="hero-accent" aria-hidden="true">{SITE_METADATA.arabicAccent}</p>
    <h1 class="hero-title">
      Perfumes árabes
      <em>de colección</em>
    </h1>
    <p class="hero-description">
      Fragancias originales importadas de Emiratos. Notas de oud, ámbar,
      azafrán y rosa damascena, en formato 100 ml.
    </p>
    <a href="/catalogo" class="hero-cta">Ver catálogo</a>
  </div>

  <div class="hero-visual">
    <PerfumeBottle
      label="Oudora"
      caption="100 ML · EDP"
      variant="warm"
      size="lg"
      ariaLabel="Frasco de perfume OUDORA"
    />
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(40px, 6vw, 64px) clamp(20px, 5vw, 56px);
    background: radial-gradient(
      ellipse 70% 80% at 75% 50%,
      #1c1910 0%,
      var(--color-bg) 70%
    );
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-lg);
    align-items: center;
    min-height: 360px;
  }

  .hero-accent {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-uppercase);
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 10px;
    font-weight: 500;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(28px, 4.5vw, 44px);
    line-height: 1.1;
    color: var(--color-cream);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-4);
  }
  .hero-title em {
    color: var(--color-gold);
    font-style: italic;
    font-weight: 500;
    display: block;
  }

  .hero-description {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
    max-width: 380px;
  }

  /* Misma signature animation que el resto de CTAs del sitio. */
  .hero-cta {
    position: relative;
    display: inline-block;
    padding: 12px 28px;
    border: 0.5px solid var(--color-gold);
    background: transparent;
    color: var(--color-gold);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    border-radius: var(--radius-pill);
    overflow: hidden;
    isolation: isolate;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.35s var(--ease-premium),
                transform 0.35s var(--ease-premium);
  }
  .hero-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-gold);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.35s var(--ease-premium);
    z-index: -1;
  }
  .hero-cta:hover {
    color: var(--color-bg);
    transform: translateY(-1px);
  }
  .hero-cta:hover::before {
    clip-path: inset(0 0 0 0);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 24px 20px 32px;
      min-height: auto;
      gap: 16px;
    }
    .hero-description {
      margin-left: auto;
      margin-right: auto;
      margin-bottom: 16px;
    }
    .hero-visual {
      order: -1;
      max-height: 200px;
      overflow: hidden;
    }
    .hero-visual :global(svg),
    .hero-visual :global(img) {
      max-height: 180px;
      width: auto;
    }
  }
</style>
